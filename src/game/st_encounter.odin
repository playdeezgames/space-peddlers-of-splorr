EncounterDisplayNextAction :: proc(FirstDisplay: bool) {
	if (g.EncounterType == POLICEINSPECTION) {
		DrawChars("The police summon you to submit", 6, 106)
		DrawChars("to an inspection.", 6, 119)
	} else if (g.EncounterType == POSTMARIEPOLICEENCOUNTER) {
		DrawChars("\"We know you removed illegal", 6, 93)
		DrawChars("goods from the Marie Celeste.", 6, 106)
		DrawChars("You must give them up at once!\"", 6, 119)
	} else if ((FirstDisplay && (g.EncounterType == POLICEATTACK)) && (g.PoliceRecordScore > CRIMINALSCORE)) {
		DrawChars("The police hail they want", 6, 106)
		DrawChars("you to surrender.", 6, 119)
	} else if (((g.EncounterType == POLICEFLEE) || (g.EncounterType == TRADERFLEE)) || (g.EncounterType == PIRATEFLEE)) {
		DrawChars("Your opponent is fleeing.", 6, 106)
	} else if (((((((g.EncounterType == PIRATEATTACK) || (g.EncounterType == POLICEATTACK)) || (g.EncounterType == TRADERATTACK)) || (g.EncounterType == SPACEMONSTERATTACK)) || (g.EncounterType == DRAGONFLYATTACK)) || (g.EncounterType == SCARABATTACK)) || (g.EncounterType == FAMOUSCAPATTACK)) {
		DrawChars("Your opponent attacks.", 6, 106)
	} else if ((((((g.EncounterType == TRADERIGNORE) || (g.EncounterType == POLICEIGNORE)) || (g.EncounterType == SPACEMONSTERIGNORE)) || (g.EncounterType == DRAGONFLYIGNORE)) || (g.EncounterType == PIRATEIGNORE)) || (g.EncounterType == SCARABIGNORE)) {
		if Cloaked(&g.Ship, &g.Opponent) {
			DrawChars("It doesn't notice you.", 6, 106)
		} else {
			DrawChars("It ignores you.", 6, 106)
		}
	} else if ((g.EncounterType == TRADERSELL) || (g.EncounterType == TRADERBUY)) {
		DrawChars("You are hailed with an offer", 6, 106)
		DrawChars("to trade goods.", 6, 119)
	} else if ((g.EncounterType == TRADERSURRENDER) || (g.EncounterType == PIRATESURRENDER)) {
		DrawChars("Your opponent hails that he", 6, 106)
		DrawChars("surrenders to you.", 6, 119)
	} else if (g.EncounterType == MARIECELESTEENCOUNTER) {
		DrawChars("The Marie Celeste appears to", 6, 106)
		DrawChars("be completely abandoned.", 6, 119)
	} else if ((((g.EncounterType) >= FAMOUSCAPTAIN) && ((g.EncounterType) <= MAXFAMOUSCAPTAIN)) && (g.EncounterType != FAMOUSCAPATTACK)) {
		DrawChars("The Captain requests a brief", 6, 106)
		DrawChars("meeting with you.", 6, 119)
	} else if ((g.EncounterType == BOTTLEOLDENCOUNTER) || (g.EncounterType == BOTTLEGOODENCOUNTER)) {
		DrawChars("It appears to be a rare bottle", 6, 106)
		DrawChars("of Captain Marmoset's Skill Tonic!", 6, 119)
	}
}

Scoop :: proc() {
	d: i32
	ret: i32
	frm: ^FormType
	if (i32(g.Difficulty) >= NORMAL) {
		if ((i32(SysRandom(0)) % i32((g.Difficulty))) != 1) {
			return
		}
	}
	d = (i32(SysRandom(0)) % (MAXTRADEITEM))
	if (d >= 5) {
		d = (i32(SysRandom(0)) % (MAXTRADEITEM))
	}
	frm = FrmInitForm(u16(PickCannisterForm))
	StrCopy(cstring(&g.SBuf[0]), "ship, labeled ")
	StrCat(cstring(&g.SBuf[0]), Tradeitem[d].Name)
	StrCat(cstring(&g.SBuf[0]), ", drifts")
	setLabelText(frm, PickCannisterCannisterLabel, cstring(&g.SBuf[0]))
	ret = i32(FrmDoDialog(frm))
	FrmDeleteForm(frm)
	if (ret == PickCannisterPickItUpButton) {
		if (FilledCargoBays() >= TotalCargoBays()) {
			if (i32(FrmAlert(u16(NoRoomToScoopAlert))) == NoRoomToScoopLetitgo) {
				return
			}
			frm = FrmInitForm(u16(DumpCargoForm))
			FrmSetEventHandler(frm, DiscardCargoFormHandleEvent)
			FrmDoDialog(frm)
			FrmDeleteForm(frm)
		}
		if (FilledCargoBays() < TotalCargoBays()) {
			g.Ship.Cargo[d] += 1
		} else {
			FrmAlert(u16(NoDumpNoScoopAlert))
		}
	}
}

TotalShields :: proc(Sh: ^SHIP) -> i32 {
	i: i32
	j: i32
	j = 0
	for i = 0; (i < MAXSHIELD); i += 1 {
		if (Sh.Shield[i] < 0) {
			break
		}
		j += Shieldtype[Sh.Shield[i]].Power
	}
	return j
}

TotalShieldStrength :: proc(Sh: ^SHIP) -> i32 {
	i: i32
	k: i32
	k = 0
	for i = 0; (i < MAXSHIELD); i += 1 {
		if (Sh.Shield[i] < 0) {
			break
		}
		k += Sh.ShieldStrength[i]
	}
	return k
}

ShowShip :: proc(Sh: ^SHIP, offset: i32, commandersShip: bool) {
	x: i32
	y: i32
	x2: i32
	y2: i32
	startdamage: i32
	startshield: i32
	icon: i32
	bounds: RectangleType
	FntSetFont(stdFont)
	if g.TextualEncounters {
		EraseRectangle(offset, 32, 70, 38)
		DrawChars(Shiptype[Sh.Type].Name, offset, 32)
		if ((((g.EncounterType) >= SPACEMONSTERATTACK) && ((g.EncounterType) <= MAXSPACEMONSTER)) && (offset > 10)) {
			StrCopy(cstring(&g.SBuf[0]), "Hide at ")
		} else {
			StrCopy(cstring(&g.SBuf[0]), "Hull at ")
		}
		if commandersShip {
			StrIToA(cstring(&g.SBuf2[0]), ((Sh.Hull * 100) / GetHullStrength()))
		} else {
			StrIToA(cstring(&g.SBuf2[0]), ((Sh.Hull * 100) / Shiptype[Sh.Type].HullStrength))
		}
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), "%")
		DrawChars(cstring(&g.SBuf[0]), offset, 45)
		if (Sh.Shield[0] < 0) {
			StrCopy(cstring(&g.SBuf[0]), "No shields")
		} else {
			StrCopy(cstring(&g.SBuf[0]), "Shields at ")
			if (TotalShields(Sh) > 0) {
				StrIToA(cstring(&g.SBuf2[0]), ((TotalShieldStrength(Sh) * 100) / TotalShields(Sh)))
			} else {
				StrCopy(cstring(&g.SBuf2[0]), "0")
			}
			StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
			StrCat(cstring(&g.SBuf[0]), "%")
		}
		DrawChars(cstring(&g.SBuf[0]), offset, 58)
	} else {
		EraseRectangle(offset, 18, 70, 52)
		x = (offset + ((64 - (GetBitmapWidth(g.ShipBmpPtr[Sh.Type]))) >> 1))
		y = (18 + ((52 - (GetBitmapHeight(g.ShipBmpPtr[Sh.Type]))) >> 1))
		x2 = (offset + ((64 - (GetBitmapWidth(g.ShieldedShipBmpPtr[Sh.Type]))) >> 1))
		y2 = (18 + ((52 - (GetBitmapHeight(g.ShieldedShipBmpPtr[Sh.Type]))) >> 1))
		if commandersShip {
			startdamage = ((x + GetBitmapWidth(g.ShipBmpPtr[Sh.Type])) - ((Sh.Hull * GetBitmapWidth(g.ShipBmpPtr[Sh.Type])) / GetHullStrength()))
		} else {
			startdamage = ((x + GetBitmapWidth(g.ShipBmpPtr[Sh.Type])) - ((Sh.Hull * GetBitmapWidth(g.ShipBmpPtr[Sh.Type])) / Shiptype[Sh.Type].HullStrength))
		}
		startshield = ((x2 + GetBitmapWidth(g.ShieldedShipBmpPtr[Sh.Type])) - ((Sh.Shield[0] < 0) ? 0 : ((TotalShieldStrength(Sh) * GetBitmapWidth(g.ShieldedShipBmpPtr[Sh.Type])) / TotalShields(Sh))))
		bounds.topLeft.x = i16(x2)
		bounds.topLeft.y = i16(18)
		bounds.extent.x = i16(((((startdamage) <= (startshield)) ? (startdamage) : (startshield)) - x2))
		bounds.extent.y = i16(52)
		WinSetClip(&bounds)
		WinDrawBitmap(g.DamagedShipBmpPtr[Sh.Type], i16(x), i16(y))
		WinResetClip()
		bounds.topLeft.x = i16((((startdamage) <= (startshield)) ? (startdamage) : (startshield)))
		bounds.extent.x = i16(((((startdamage) >= (startshield)) ? (startdamage) : (startshield)) - x2))
		WinSetClip(&bounds)
		if (startdamage < startshield) {
			WinDrawBitmap(g.ShipBmpPtr[Sh.Type], i16(x), i16(y))
		} else {
			WinDrawBitmap(g.DamagedShieldedShipBmpPtr[Sh.Type], i16(x2), i16(y2))
		}
		WinResetClip()
		bounds.topLeft.x = i16((((startdamage) >= (startshield)) ? (startdamage) : (startshield)))
		bounds.extent.x = i16(GetBitmapWidth(g.ShieldedShipBmpPtr[Sh.Type]))
		WinSetClip(&bounds)
		WinDrawBitmap(g.ShieldedShipBmpPtr[Sh.Type], i16(x2), i16(y2))
		WinResetClip()
		if (offset > 10) {
			icon = -1
			if (((g.EncounterType) >= PIRATE) && ((g.EncounterType) <= MAXPIRATE)) {
				if (i32(Sh.Type) == (MAXSHIPTYPE + 2)) {
					icon = 3
				} else {
					icon = 0
				}
			} else if (((g.EncounterType) >= POLICE) && ((g.EncounterType) <= MAXPOLICE)) {
				icon = 1
			} else if (((g.EncounterType) >= TRADER) && ((g.EncounterType) <= MAXTRADER)) {
				icon = 2
			} else if ((((g.EncounterType == CAPTAINHUIEENCOUNTER) || (g.EncounterType == MARIECELESTEENCOUNTER)) || (g.EncounterType == CAPTAINAHABENCOUNTER)) || (g.EncounterType == CAPTAINCONRADENCOUNTER)) {
				icon = 4
			}
			if (icon >= 0) {
				WinDrawBitmap(g.IconBmpPtr[icon], i16(143), i16(13))
			}
		}
	}
}

EncounterDisplayShips :: proc() {
	if g.opponentShipNeedsUpdate {
		g.opponentShipNeedsUpdate = false
		ShowShip(&g.Opponent, (g.TextualEncounters ? 84 : 80), false)
	}
	if g.playerShipNeedsUpdate {
		g.playerShipNeedsUpdate = false
		ShowShip(&g.Ship, 6, true)
	}
	EraseRectangle(5, 75, 151, 64)
}

EscapeWithPod :: proc() {
	FrmAlert(u16(EscapePodActivatedAlert))
	if (i32(g.ScarabStatus) == 3) {
		g.ScarabStatus = u8(0)
	}
	Arrival()
	if ((i32(g.ReactorStatus) > 0) && (i32(g.ReactorStatus) < 21)) {
		FrmAlert(u16(ReactorDestroyedAlert))
		g.ReactorStatus = u8(0)
	}
	if (i32(g.JaporiDiseaseStatus) == 1) {
		FrmAlert(u16(AntidoteDestroyedAlert))
		g.JaporiDiseaseStatus = u8(0)
	}
	if g.ArtifactOnBoard {
		FrmAlert(u16(ArtifactNotSavedAlert))
		g.ArtifactOnBoard = false
	}
	if (i32(g.JarekStatus) == 1) {
		FrmAlert(u16(JarekTakenHomeAlert))
		g.JarekStatus = u8(0)
	}
	if (i32(g.WildStatus) == 1) {
		FrmAlert(u16(WildArrestedAlert))
		g.PoliceRecordScore += CAUGHTWITHWILDSCORE
		addNewsEvent(WILDARRESTED)
		g.WildStatus = u8(0)
	}
	if (g.Ship.Tribbles > 0) {
		FrmAlert(u16(TribbleSurvivedAlert))
		g.Ship.Tribbles = 0
	}
	if g.Insurance {
		FrmAlert(u16(InsurancePaysAlert))
		g.Credits += CurrentShipPriceWithoutCargo(true)
	}
	FrmAlert(u16(FleaBuiltAlert))
	if (g.Credits > 500) {
		g.Credits -= 500
	} else {
		g.Debt += (500 - g.Credits)
		g.Credits = 0
	}
	IncDays(3)
	CreateFlea()
	g.CurForm = SystemInformationForm
	FrmGotoForm(u16(g.CurForm))
}

Arrested :: proc() {
	frm: ^FormType
	Fine: i32
	Imprisonment: i32
	i: i32
	Fine = ((1 + (((CurrentWorth() * (((80) <= (-g.PoliceRecordScore)) ? (80) : (-g.PoliceRecordScore))) / 100) / 500)) * 500)
	if (i32(g.WildStatus) == 1) {
		Fine = i32(f64(Fine) * 1.05)
	}
	Imprisonment = (((30) >= (-g.PoliceRecordScore)) ? (30) : (-g.PoliceRecordScore))
	FrmAlert(u16(ArrestedAlert))
	frm = FrmInitForm(u16(ConvictionForm))
	StrCopy(cstring(&g.SBuf[0]), "You are convicted to ")
	StrIToA(cstring(&g.SBuf2[0]), Imprisonment)
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	StrCat(cstring(&g.SBuf[0]), " days in")
	setLabelText(frm, ConvictionImprisonmentLabel, cstring(&g.SBuf[0]))
	StrCopy(cstring(&g.SBuf[0]), "prison and a fine of ")
	StrIToA(cstring(&g.SBuf2[0]), Fine)
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	StrCat(cstring(&g.SBuf[0]), " credits.")
	setLabelText(frm, ConvictionFineLabel, cstring(&g.SBuf[0]))
	FrmDoDialog(frm)
	FrmDeleteForm(frm)
	if ((g.Ship.Cargo[NARCOTICS] > 0) || (g.Ship.Cargo[FIREARMS] > 0)) {
		FrmAlert(u16(ImpoundAlert))
		g.Ship.Cargo[NARCOTICS] = 0
		g.Ship.Cargo[FIREARMS] = 0
	}
	if g.Insurance {
		FrmAlert(u16(InsuranceLostAlert))
		g.Insurance = false
		g.NoClaim = 0
	}
	if (g.Ship.Crew[1] >= 0) {
		FrmAlert(u16(MercenariesLeaveAlert))
		for i = 1; (i < MAXCREW); i += 1 {
			g.Ship.Crew[i] = -1
		}
	}
	if (i32(g.JaporiDiseaseStatus) == 1) {
		FrmAlert(u16(AntidoteRemovedAlert))
		g.JaporiDiseaseStatus = u8(2)
	}
	if (i32(g.JarekStatus) == 1) {
		FrmAlert(u16(JarekTakenHomeAlert))
		g.JarekStatus = u8(0)
	}
	if (i32(g.WildStatus) == 1) {
		FrmAlert(u16(WildArrestedAlert))
		addNewsEvent(WILDARRESTED)
		g.WildStatus = u8(0)
	}
	if ((i32(g.ReactorStatus) > 0) && (i32(g.ReactorStatus) < 21)) {
		FrmAlert(u16(PoliceConfiscateReactorAlert))
		g.ReactorStatus = u8(0)
	}
	Arrival()
	IncDays(Imprisonment)
	if (g.Credits >= Fine) {
		g.Credits -= Fine
	} else {
		g.Credits += CurrentShipPrice(true)
		if (g.Credits >= Fine) {
			g.Credits -= Fine
		} else {
			g.Credits = 0
		}
		FrmAlert(u16(ShipSoldAlert))
		if (g.Ship.Tribbles > 0) {
			FrmAlert(u16(TribblesSoldAlert))
			g.Ship.Tribbles = 0
		}
		FrmAlert(u16(FleaReceivedAlert))
		CreateFlea()
	}
	g.PoliceRecordScore = DUBIOUSSCORE
	if (g.Debt > 0) {
		if (g.Credits >= g.Debt) {
			g.Credits -= g.Debt
			g.Debt = 0
		} else {
			g.Debt -= g.Credits
			g.Credits = 0
		}
	}
	for i = 0; (i < Imprisonment); i += 1 {
		PayInterest()
	}
	g.CurForm = SystemInformationForm
	FrmGotoForm(u16(g.CurForm))
}

ExecuteAttack :: proc(Attacker: ^SHIP, Defender: ^SHIP, Flees: bool, CommanderUnderAttack: bool) -> bool {
	Damage: i32
	prevDamage: i32
	i: i32
	if (((i32(g.Difficulty) == BEGINNER) && CommanderUnderAttack) && Flees) {
		return false
	}
	if ((i32(SysRandom(0)) % (i32(FighterSkill(Attacker)) + i32(Shiptype[Defender.Type].Size))) < ((Flees ? 2 : 1) * (i32(SysRandom(0)) % (5 + (i32(PilotSkill(Defender)) >> 1))))) {
		return false
	}
	if (TotalWeapons(Attacker, -1, -1) <= 0) {
		Damage = 0
	} else if (i32(Defender.Type) == (MAXSHIPTYPE + 3)) {
		if ((TotalWeapons(Attacker, PULSELASERWEAPON, PULSELASERWEAPON) <= 0) && (TotalWeapons(Attacker, MORGANLASERWEAPON, MORGANLASERWEAPON) <= 0)) {
			Damage = 0
		} else {
			Damage = (i32(SysRandom(0)) % (((TotalWeapons(Attacker, PULSELASERWEAPON, PULSELASERWEAPON) + TotalWeapons(Attacker, MORGANLASERWEAPON, MORGANLASERWEAPON)) * (100 + (2 * i32(EngineerSkill(Attacker))))) / 100))
		}
	} else {
		Damage = (i32(SysRandom(0)) % ((TotalWeapons(Attacker, -1, -1) * (100 + (2 * i32(EngineerSkill(Attacker))))) / 100))
	}
	if (Damage <= 0) {
		return false
	}
	if ((CommanderUnderAttack && (i32(g.ReactorStatus) > 0)) && (i32(g.ReactorStatus) < 21)) {
		if (i32(g.Difficulty) < NORMAL) {
			Damage = i32(f64(Damage) * (f64(1) + (f64((i32(g.Difficulty) + 1)) * 0.25)))
		} else {
			Damage = i32(f64(Damage) * (f64(1) + (f64((i32(g.Difficulty) + 1)) * 0.33000000000000002)))
		}
	}
	for i = 0; (i < MAXSHIELD); i += 1 {
		if (Defender.Shield[i] < 0) {
			break
		}
		if (Damage <= Defender.ShieldStrength[i]) {
			Defender.ShieldStrength[i] -= Damage
			Damage = 0
			break
		}
		Damage -= Defender.ShieldStrength[i]
		Defender.ShieldStrength[i] = 0
	}
	prevDamage = Damage
	if (Damage > 0) {
		Damage -= (i32(SysRandom(0)) % i32((EngineerSkill(Defender))))
		if (Damage <= 0) {
			Damage = 1
		}
		if (CommanderUnderAttack && (i32(g.ScarabStatus) == 3)) {
			Damage = (((Damage) <= (GetHullStrength() / (CommanderUnderAttack ? (((1) >= (IMPOSSIBLE - i32(g.Difficulty))) ? (1) : (IMPOSSIBLE - i32(g.Difficulty))) : 2))) ? (Damage) : (GetHullStrength() / (CommanderUnderAttack ? (((1) >= (IMPOSSIBLE - i32(g.Difficulty))) ? (1) : (IMPOSSIBLE - i32(g.Difficulty))) : 2)))
		} else {
			Damage = (((Damage) <= (Shiptype[Defender.Type].HullStrength / (CommanderUnderAttack ? (((1) >= (IMPOSSIBLE - i32(g.Difficulty))) ? (1) : (IMPOSSIBLE - i32(g.Difficulty))) : 2))) ? (Damage) : (Shiptype[Defender.Type].HullStrength / (CommanderUnderAttack ? (((1) >= (IMPOSSIBLE - i32(g.Difficulty))) ? (1) : (IMPOSSIBLE - i32(g.Difficulty))) : 2)))
		}
		Defender.Hull -= Damage
		if (Defender.Hull < 0) {
			Defender.Hull = 0
		}
	}
	if (Damage != prevDamage) {
		if CommanderUnderAttack {
			g.playerShipNeedsUpdate = true
		} else {
			g.opponentShipNeedsUpdate = true
		}
	}
	return true
}

ExecuteAction :: proc(CommanderFlees: bool) -> i32 {
	frmP: ^FormType
	CommanderGotHit: bool
	OpponentGotHit: bool
	OpponentHull: i32
	ShipHull: i32
	y: i32
	i: i32
	objindex: i32
	PrevEncounterType: i32
	cp: ^ControlType
	CommanderGotHit = false
	OpponentHull = g.Opponent.Hull
	ShipHull = g.Ship.Hull
	if ((((((((g.EncounterType == PIRATEATTACK) || (g.EncounterType == POLICEATTACK)) || (g.EncounterType == TRADERATTACK)) || (g.EncounterType == SPACEMONSTERATTACK)) || (g.EncounterType == DRAGONFLYATTACK)) || (g.EncounterType == POSTMARIEPOLICEENCOUNTER)) || (g.EncounterType == SCARABATTACK)) || (g.EncounterType == FAMOUSCAPATTACK)) {
		CommanderGotHit = ExecuteAttack(&g.Opponent, &g.Ship, CommanderFlees, true)
	}
	OpponentGotHit = false
	if !CommanderFlees {
		if (((g.EncounterType == POLICEFLEE) || (g.EncounterType == TRADERFLEE)) || (g.EncounterType == PIRATEFLEE)) {
			OpponentGotHit = ExecuteAttack(&g.Ship, &g.Opponent, true, false)
		} else {
			OpponentGotHit = ExecuteAttack(&g.Ship, &g.Opponent, false, false)
		}
	}
	if CommanderGotHit {
		g.playerShipNeedsUpdate = true
	}
	if OpponentGotHit {
		g.opponentShipNeedsUpdate = true
	}
	if ((g.Ship.Hull <= 0) && (g.Opponent.Hull <= 0)) {
		g.AutoAttack = false
		g.AutoFlee = false
		if g.EscapePod {
			EscapeWithPod()
			return (1)
		} else {
			FrmAlert(u16(BothDestroyedAlert))
			g.CurForm = DestroyedForm
			FrmGotoForm(u16(g.CurForm))
		}
		return 0
	} else if (g.Opponent.Hull <= 0) {
		g.AutoAttack = false
		g.AutoFlee = false
		if (((((g.EncounterType) >= PIRATE) && ((g.EncounterType) <= MAXPIRATE)) && (i32(g.Opponent.Type) != (MAXSHIPTYPE + 2))) && (g.PoliceRecordScore >= DUBIOUSSCORE)) {
			frmP = FrmInitForm(u16(BountyForm))
			StrCopy(cstring(&g.SBuf[0]), "You earned a bounty of ")
			StrIToA(cstring(&g.SBuf2[0]), GetBounty(&g.Opponent))
			StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
			StrCat(cstring(&g.SBuf[0]), " cr.")
			setLabelText(frmP, BountyBountyLabel, cstring(&g.SBuf[0]))
			FrmDoDialog(frmP)
			FrmDeleteForm(frmP)
		} else {
			FrmAlert(u16(OpponentDestroyedAlert))
		}
		if (((g.EncounterType) >= POLICE) && ((g.EncounterType) <= MAXPOLICE)) {
			g.PoliceKills += 1
			g.PoliceRecordScore += KILLPOLICESCORE
		} else if (((g.EncounterType) >= FAMOUSCAPTAIN) && ((g.EncounterType) <= MAXFAMOUSCAPTAIN)) {
			if (g.ReputationScore < DANGEROUSREP) {
				g.ReputationScore = DANGEROUSREP
			} else {
				g.ReputationScore += 100
			}
			replaceNewsEvent(latestNewsEvent(), (latestNewsEvent() + 10))
		} else if (((g.EncounterType) >= PIRATE) && ((g.EncounterType) <= MAXPIRATE)) {
			if (i32(g.Opponent.Type) != (MAXSHIPTYPE + 2)) {
				g.Credits += GetBounty(&g.Opponent)
				g.PoliceRecordScore += KILLPIRATESCORE
				Scoop()
			}
			g.PirateKills += 1
		} else if (((g.EncounterType) >= TRADER) && ((g.EncounterType) <= MAXTRADER)) {
			g.TraderKills += 1
			g.PoliceRecordScore += KILLTRADERSCORE
			Scoop()
		} else if (((g.EncounterType) >= SPACEMONSTERATTACK) && ((g.EncounterType) <= MAXSPACEMONSTER)) {
			g.PirateKills += 1
			g.PoliceRecordScore += KILLPIRATESCORE
			g.MonsterStatus = u8(2)
		} else if (((g.EncounterType) >= DRAGONFLYATTACK) && ((g.EncounterType) <= MAXDRAGONFLY)) {
			g.PirateKills += 1
			g.PoliceRecordScore += KILLPIRATESCORE
			g.DragonflyStatus = u8(5)
		} else if (((g.EncounterType) >= SCARABATTACK) && ((g.EncounterType) <= MAXSCARAB)) {
			g.PirateKills += 1
			g.PoliceRecordScore += KILLPIRATESCORE
			g.ScarabStatus = u8(2)
		}
		g.ReputationScore += (1 + (i32(g.Opponent.Type) >> 1))
		return 0
	} else if (g.Ship.Hull <= 0) {
		g.AutoAttack = false
		g.AutoFlee = false
		if g.EscapePod {
			EscapeWithPod()
			return (1)
		} else {
			FrmAlert(u16(ShipDestroyedAlert))
			g.CurForm = DestroyedForm
			FrmGotoForm(u16(g.CurForm))
		}
		return 0
	}
	if CommanderFlees {
		if (i32(g.Difficulty) == BEGINNER) {
			g.AutoAttack = false
			g.AutoFlee = false
			FrmAlert(u16(YouEscapedAlert))
			if (((g.EncounterType) >= SPACEMONSTERATTACK) && ((g.EncounterType) <= MAXSPACEMONSTER)) {
				g.MonsterHull = g.Opponent.Hull
			}
			return 0
		} else if ((((i32(SysRandom(0)) % (7)) + (i32(PilotSkill(&g.Ship)) / 3)) * 2) >= ((i32(SysRandom(0)) % i32((PilotSkill(&g.Opponent)))) * (2 + i32(g.Difficulty)))) {
			g.AutoAttack = false
			g.AutoFlee = false
			if CommanderGotHit {
				ShowShip(&g.Ship, 6, true)
				frmP = FrmGetActiveForm()
				for i = 0; (i < TRIBBLESONSCREEN); i += 1 {
					objindex = i32(FrmGetObjectIndex(frmP, u16((EncounterTribble0Button + i))))
					cp = cast(^ControlType)(FrmGetObjectPtr(frmP, u16(objindex)))
					CtlDrawControl(cp)
				}
				FrmAlert(u16(YouEscapedWithDamageAlert))
			} else {
				FrmAlert(u16(YouEscapedAlert))
			}
			if (((g.EncounterType) >= SPACEMONSTERATTACK) && ((g.EncounterType) <= MAXSPACEMONSTER)) {
				g.MonsterHull = g.Opponent.Hull
			}
			return 0
		}
	} else if (((((g.EncounterType == POLICEFLEE) || (g.EncounterType == TRADERFLEE)) || (g.EncounterType == PIRATEFLEE)) || (g.EncounterType == TRADERSURRENDER)) || (g.EncounterType == PIRATESURRENDER)) {
		if (((i32(SysRandom(0)) % i32((PilotSkill(&g.Ship)))) * 4) <= ((i32(SysRandom(0)) % (7 + (i32(PilotSkill(&g.Opponent)) / 3))) * 2)) {
			g.AutoAttack = false
			g.AutoFlee = false
			FrmAlert(u16(OpponentEscapedAlert))
			return 0
		}
	}
	PrevEncounterType = g.EncounterType
	if (g.Opponent.Hull < OpponentHull) {
		if (((g.EncounterType) >= POLICE) && ((g.EncounterType) <= MAXPOLICE)) {
			if (g.Opponent.Hull < (OpponentHull >> 1)) {
				if (g.Ship.Hull < (ShipHull >> 1)) {
					if ((i32(SysRandom(0)) % (10)) > 5) {
						g.EncounterType = POLICEFLEE
					}
				} else {
					g.EncounterType = POLICEFLEE
				}
			}
		} else if (g.EncounterType == POSTMARIEPOLICEENCOUNTER) {
			g.EncounterType = POLICEATTACK
		} else if (((g.EncounterType) >= PIRATE) && ((g.EncounterType) <= MAXPIRATE)) {
			if (g.Opponent.Hull < ((OpponentHull * 2) / 3)) {
				if (g.Ship.Hull < ((ShipHull * 2) / 3)) {
					if ((i32(SysRandom(0)) % (10)) > 3) {
						g.EncounterType = PIRATEFLEE
					}
				} else {
					g.EncounterType = PIRATEFLEE
					if (((i32(SysRandom(0)) % (10)) > 8) && (i32(g.Opponent.Type) < MAXSHIPTYPE)) {
						g.EncounterType = PIRATESURRENDER
					}
				}
			}
		} else if (((g.EncounterType) >= TRADER) && ((g.EncounterType) <= MAXTRADER)) {
			if (g.Opponent.Hull < ((OpponentHull * 2) / 3)) {
				if ((i32(SysRandom(0)) % (10)) > 3) {
					g.EncounterType = TRADERSURRENDER
				} else {
					g.EncounterType = TRADERFLEE
				}
			} else if (g.Opponent.Hull < ((OpponentHull * 9) / 10)) {
				if (g.Ship.Hull < ((ShipHull * 2) / 3)) {
					if ((i32(SysRandom(0)) % (10)) > 7) {
						g.EncounterType = TRADERFLEE
					}
				} else if (g.Ship.Hull < ((ShipHull * 9) / 10)) {
					if ((i32(SysRandom(0)) % (10)) > 3) {
						g.EncounterType = TRADERFLEE
					}
				} else {
					g.EncounterType = TRADERFLEE
				}
			}
		}
	}
	if (PrevEncounterType != g.EncounterType) {
		if !(g.AutoAttack && (((g.EncounterType == TRADERFLEE) || (g.EncounterType == PIRATEFLEE)) || (g.EncounterType == POLICEFLEE))) {
			g.AutoAttack = false
		}
		g.AutoFlee = false
	}
	frmP = FrmGetActiveForm()
	EncounterButtons()
	EncounterDisplayShips()
	if (((PrevEncounterType) >= POLICE) && ((PrevEncounterType) <= MAXPOLICE)) {
		StrCopy(cstring(&g.SBuf2[0]), "police ship")
	} else if (((PrevEncounterType) >= PIRATE) && ((PrevEncounterType) <= MAXPIRATE)) {
		if (i32(g.Opponent.Type) == (MAXSHIPTYPE + 2)) {
			StrCopy(cstring(&g.SBuf2[0]), "alien ship")
		} else {
			StrCopy(cstring(&g.SBuf2[0]), "pirate ship")
		}
	} else if (((PrevEncounterType) >= TRADER) && ((PrevEncounterType) <= MAXTRADER)) {
		StrCopy(cstring(&g.SBuf2[0]), "trader ship")
	} else if (((PrevEncounterType) >= SPACEMONSTERATTACK) && ((PrevEncounterType) <= MAXSPACEMONSTER)) {
		StrCopy(cstring(&g.SBuf2[0]), "monster")
	} else if (((PrevEncounterType) >= DRAGONFLYATTACK) && ((PrevEncounterType) <= MAXDRAGONFLY)) {
		StrCopy(cstring(&g.SBuf2[0]), "Dragonfly")
	} else if (((PrevEncounterType) >= SCARABATTACK) && ((PrevEncounterType) <= MAXSCARAB)) {
		StrCopy(cstring(&g.SBuf2[0]), "Scarab")
	} else if (((PrevEncounterType) >= FAMOUSCAPTAIN) && ((PrevEncounterType) <= MAXFAMOUSCAPTAIN)) {
		StrCopy(cstring(&g.SBuf2[0]), "Captain")
	}
	y = 75
	if CommanderGotHit {
		StrCopy(cstring(&g.SBuf[0]), "The ")
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), " hits you.")
		DrawChars(cstring(&g.SBuf[0]), 6, y)
		y += 13
	}
	if (!(((PrevEncounterType == POLICEFLEE) || (PrevEncounterType == TRADERFLEE)) || (PrevEncounterType == PIRATEFLEE)) && !CommanderGotHit) {
		StrCopy(cstring(&g.SBuf[0]), "The ")
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), " missed you.")
		DrawChars(cstring(&g.SBuf[0]), 6, y)
		y += 13
	}
	if OpponentGotHit {
		StrCopy(cstring(&g.SBuf[0]), "You hit the ")
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), ".")
		DrawChars(cstring(&g.SBuf[0]), 6, y)
		y += 13
	}
	if (!CommanderFlees && !OpponentGotHit) {
		StrCopy(cstring(&g.SBuf[0]), "You missed the ")
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), ".")
		DrawChars(cstring(&g.SBuf[0]), 6, y)
		y += 13
	}
	if (((PrevEncounterType == POLICEFLEE) || (PrevEncounterType == TRADERFLEE)) || (PrevEncounterType == PIRATEFLEE)) {
		StrCopy(cstring(&g.SBuf[0]), "The ")
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), " didn't get away.")
		DrawChars(cstring(&g.SBuf[0]), 6, y)
		y += 13
	}
	if CommanderFlees {
		StrCopy(cstring(&g.SBuf[0]), "The ")
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), " is still following you.")
		DrawChars(cstring(&g.SBuf[0]), 6, y)
		y += 13
	}
	EncounterDisplayNextAction(false)
	for i = 0; (i < TRIBBLESONSCREEN); i += 1 {
		objindex = i32(FrmGetObjectIndex(frmP, u16((EncounterTribble0Button + i))))
		cp = cast(^ControlType)(FrmGetObjectPtr(frmP, u16(objindex)))
		CtlDrawControl(cp)
	}
	return 1
}

TotalWeapons :: proc(Sh: ^SHIP, minWeapon: i32, maxWeapon: i32) -> i32 {
	i: i32
	j: i32
	j = 0
	for i = 0; (i < MAXWEAPON); i += 1 {
		if (Sh.Weapon[i] < 0) {
			break
		}
		if (((minWeapon != -1) && (Sh.Weapon[i] < minWeapon)) || ((maxWeapon != -1) && (Sh.Weapon[i] > maxWeapon))) {
			continue
		}
		j += Weapontype[Sh.Weapon[i]].Power
	}
	return j
}

DrawEncounterForm :: proc() {
	frmP: ^FormType
	d: i32
	i: i32
	objindex: i32
	cp: ^ControlType
	frmP = FrmGetActiveForm()
	EncounterButtons()
	FrmDrawForm(frmP)
	if (g.romVersion < ((((((u32((3))) << 24) | ((u32((5))) << 16)) | ((u32((0))) << 12)) | ((u32((sysROMStageRelease))) << 8)) | (u32((0))))) {
		EncounterButtons()
	}
	g.playerShipNeedsUpdate = true
	g.opponentShipNeedsUpdate = true
	EncounterDisplayShips()
	EncounterDisplayNextAction(true)
	if (g.EncounterType == POSTMARIEPOLICEENCOUNTER) {
		DrawChars("You encounter the Customs Police.", 6, 75)
	} else {
		StrCopy(cstring(&g.SBuf[0]), "At ")
		SBufMultiples(i32(g.Clicks), "click")
		StrCat(cstring(&g.SBuf[0]), " from ")
		StrCat(cstring(&g.SBuf[0]), SolarSystemName[g.SolarSystem[g.WarpSystem].NameIndex])
		StrCat(cstring(&g.SBuf[0]), ", you")
		DrawChars(cstring(&g.SBuf[0]), 6, 75)
		StrCopy(cstring(&g.SBuf[0]), "encounter ")
		if (((g.EncounterType) >= POLICE) && ((g.EncounterType) <= MAXPOLICE)) {
			StrCat(cstring(&g.SBuf[0]), "a police ")
		} else if (((g.EncounterType) >= PIRATE) && ((g.EncounterType) <= MAXPIRATE)) {
			if (i32(g.Opponent.Type) == (MAXSHIPTYPE + 2)) {
				StrCat(cstring(&g.SBuf[0]), "an alien ")
			} else {
				StrCat(cstring(&g.SBuf[0]), "a pirate ")
			}
		} else if (((g.EncounterType) >= TRADER) && ((g.EncounterType) <= MAXTRADER)) {
			StrCat(cstring(&g.SBuf[0]), "a trader ")
		} else if (((g.EncounterType) >= SPACEMONSTERATTACK) && ((g.EncounterType) <= MAXSPACEMONSTER)) {
			StrCat(cstring(&g.SBuf[0]), " ")
		} else if (g.EncounterType == MARIECELESTEENCOUNTER) {
			StrCat(cstring(&g.SBuf[0]), "a drifting ship")
		} else if (g.EncounterType == CAPTAINAHABENCOUNTER) {
			StrCat(cstring(&g.SBuf[0]), "the famous Captain Ahab")
		} else if (g.EncounterType == CAPTAINCONRADENCOUNTER) {
			StrCat(cstring(&g.SBuf[0]), "Captain Conrad")
		} else if (g.EncounterType == CAPTAINHUIEENCOUNTER) {
			StrCat(cstring(&g.SBuf[0]), "Captain Huie")
		} else if ((g.EncounterType == BOTTLEOLDENCOUNTER) || (g.EncounterType == BOTTLEGOODENCOUNTER)) {
			StrCat(cstring(&g.SBuf[0]), "a floating bottle.")
		} else {
			StrCat(cstring(&g.SBuf[0]), "a stolen ")
		}
		if ((((((g.EncounterType != MARIECELESTEENCOUNTER) && (g.EncounterType != CAPTAINAHABENCOUNTER)) && (g.EncounterType != CAPTAINCONRADENCOUNTER)) && (g.EncounterType != CAPTAINHUIEENCOUNTER)) && (g.EncounterType != BOTTLEOLDENCOUNTER)) && (g.EncounterType != BOTTLEGOODENCOUNTER)) {
			StrCopy(cstring(&g.SBuf2[0]), Shiptype[g.Opponent.Type].Name)
			g.SBuf2[0] = u8((((i32((g.SBuf2[0])) >= 65) && (i32((g.SBuf2[0])) <= 90)) ? ((i32((g.SBuf2[0])) - 65) + 97) : i32((g.SBuf2[0]))))
			StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		}
		StrCat(cstring(&g.SBuf[0]), ".")
		DrawChars(cstring(&g.SBuf[0]), 6, 88)
	}
	d = sqrt((g.Ship.Tribbles / 250))
	for i = 0; (i < d); i += 1 {
		objindex = i32(FrmGetObjectIndex(frmP, u16((EncounterTribble0Button + (i32(SysRandom(0)) % (TRIBBLESONSCREEN))))))
		cp = cast(^ControlType)(FrmGetObjectPtr(frmP, u16(objindex)))
		CtlShowControl(cp)
	}
}

EncounterFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	frmP: ^FormType
	frm: ^FormType
	Fine: i32
	Bribe: i32
	d: i32
	i: i32
	j: i32
	m: i32
	Bays: i32
	TotalCargo: i32
	QuantityH: MemHandle
	Blackmail: i32
	RedrawButtons: bool = false
	switch u32(eventP.eType) {
	case u32(frmOpenEvent), u32(frmUpdateEvent):
		DrawEncounterForm()
		handled = true
	case u32(nilEvent):
		if !g.Continuous {
			return true
		}
		if !(g.AutoAttack || g.AutoFlee) {
			return true
		}
		fallthrough
	case u32(ctlSelectEvent):
		if ((i32(eventP.data.ctlSelect.controlID) >= EncounterTribble0Button) && (i32(eventP.data.ctlSelect.controlID) < (EncounterTribble0Button + TRIBBLESONSCREEN))) {
			if (g.AutoAttack || g.AutoFlee) {
				RedrawButtons = true
			}
			g.AutoAttack = false
			g.AutoFlee = false
			if RedrawButtons {
				EncounterButtons()
			}
			FrmAlert(u16(SqueekAlert))
			handled = true
			break
		}
		if (((u32(eventP.eType) == u32(nilEvent)) && g.AutoAttack) || (i32(eventP.data.ctlSelect.controlID) == EncounterAttackButton)) {
			if (g.AutoAttack || g.AutoFlee) {
				RedrawButtons = true
			}
			g.AutoAttack = false
			g.AutoFlee = false
			if RedrawButtons {
				EncounterButtons()
			}
			if (TotalWeapons(&g.Ship, -1, -1) <= 0) {
				FrmAlert(u16(NoWeaponsAlert))
				return true
			}
			if (((g.EncounterType == POLICEINSPECTION) && (g.Ship.Cargo[FIREARMS] <= 0)) && (g.Ship.Cargo[NARCOTICS] <= 0)) {
				if (i32(FrmAlert(u16(SureToFleeOrBribeAlert))) == SureToFleeOrBribeOKIwont) {
					return true
				}
			}
			if ((((g.EncounterType) >= POLICE) && ((g.EncounterType) <= MAXPOLICE)) || (g.EncounterType == POSTMARIEPOLICEENCOUNTER)) {
