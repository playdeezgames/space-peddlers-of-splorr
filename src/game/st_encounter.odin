					StrCopy(cstring(&g.SBuf2[0]), "You will be arrested!")
				} else if ((i32(g.ReactorStatus) > 0) && (i32(g.ReactorStatus) < 21)) {
					if ((g.Ship.Cargo[FIREARMS] > 0) || (g.Ship.Cargo[NARCOTICS] > 0)) {
						StrCopy(cstring(&g.SBuf[0]), "an illegal Ion Reactor and other illegal goods")
					} else {
						StrCopy(cstring(&g.SBuf[0]), "an illegal Ion Reactor")
					}
					StrCopy(cstring(&g.SBuf2[0]), "You will be arrested!")
				} else {
					StrCopy(cstring(&g.SBuf[0]), "illegal goods")
					StrCopy(cstring(&g.SBuf2[0]), " ")
				}
				if (i32(FrmCustomAlert(u16(SureToSubmitAlert), cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]), nil)) == SureToSubmitNo) {
					return true
				}
			}
			if ((g.Ship.Cargo[FIREARMS] > 0) || (g.Ship.Cargo[NARCOTICS] > 0)) {
				g.Ship.Cargo[FIREARMS] = 0
				g.BuyingPrice[FIREARMS] = 0
				g.Ship.Cargo[NARCOTICS] = 0
				g.BuyingPrice[NARCOTICS] = 0
				Fine = (CurrentWorth() / (((IMPOSSIBLE + 2) - i32(g.Difficulty)) * 10))
				if ((Fine % 50) != 0) {
					Fine += (50 - (Fine % 50))
				}
				Fine = (((100) >= (((Fine) <= (10000)) ? (Fine) : (10000))) ? (100) : (((Fine) <= (10000)) ? (Fine) : (10000)))
				if (g.Credits >= Fine) {
					g.Credits -= Fine
				} else {
					g.Debt += (Fine - g.Credits)
					g.Credits = 0
				}
				frmP = FrmInitForm(u16(IllegalGoodsForm))
				StrIToA(cstring(&g.SBuf[0]), Fine)
				StrCat(cstring(&g.SBuf[0]), " credits.")
				setLabelText(frmP, IllegalGoodsFineLabel, cstring(&g.SBuf[0]))
				FrmDoDialog(frmP)
				FrmDeleteForm(frmP)
				g.PoliceRecordScore += TRAFFICKING
			} else if (i32(g.WildStatus) != 1) {
				FrmAlert(u16(NoIllegalGoodsAlert))
				g.PoliceRecordScore -= TRAFFICKING
			}
			if (i32(g.WildStatus) == 1) {
				Arrested()
				return true
			}
			if ((i32(g.ReactorStatus) > 0) && (i32(g.ReactorStatus) < 21)) {
				FrmAlert(u16(PoliceConfiscateReactorAlert))
				g.ReactorStatus = u8(0)
			}
		} else if (i32(eventP.data.ctlSelect.controlID) == EncounterPlunderButton) {
			if (g.AutoAttack || g.AutoFlee) {
				RedrawButtons = true
			}
			g.AutoAttack = false
			g.AutoFlee = false
			if RedrawButtons {
				EncounterButtons()
			}
			if (((g.EncounterType) >= TRADER) && ((g.EncounterType) <= MAXTRADER)) {
				g.PoliceRecordScore += PLUNDERTRADERSCORE
			} else {
				g.PoliceRecordScore += PLUNDERPIRATESCORE
			}
			g.CurForm = PlunderForm
			FrmGotoForm(u16(g.CurForm))
			return true
		} else if (i32(eventP.data.ctlSelect.controlID) == EncounterInterruptButton) {
			if (g.AutoAttack || g.AutoFlee) {
				RedrawButtons = true
			}
			g.AutoAttack = false
			g.AutoFlee = false
			if RedrawButtons {
				EncounterButtons()
			}
			return true
		} else if (i32(eventP.data.ctlSelect.controlID) == EncounterMeetButton) {
			if (g.EncounterType == CAPTAINAHABENCOUNTER) {
				if (i32(FrmAlert(u16(EngageCaptainAhabAlert))) == EngageCaptainAhabYesTradeShield) {
					i = (MAXSHIELD - 1)
					for (i >= 0) {
						if (g.Ship.Shield[i] == REFLECTIVESHIELD) {
							for m = (i + 1); (m < MAXSHIELD); m += 1 {
								g.Ship.Shield[(m - 1)] = g.Ship.Shield[m]
								g.Ship.ShieldStrength[(m - 1)] = g.Ship.ShieldStrength[m]
							}
							g.Ship.Shield[(MAXSHIELD - 1)] = -1
							g.Ship.ShieldStrength[(MAXSHIELD - 1)] = 0
							i = -1
						}
						i -= 1
					}
					if (i32(g.Difficulty) < HARD) {
						g.Mercenary[0].Pilot = u8(i32(g.Mercenary[0].Pilot) + 2)
					} else {
						g.Mercenary[0].Pilot = u8(i32(g.Mercenary[0].Pilot) + 1)
					}
					if (i32(g.Mercenary[0].Pilot) > MAXSKILL) {
						g.Mercenary[0].Pilot = u8(MAXSKILL)
					}
					FrmAlert(u16(TrainingCompletedAlert))
				}
			} else if (g.EncounterType == CAPTAINCONRADENCOUNTER) {
				if (i32(FrmAlert(u16(EngageCaptainConradAlert))) == EngageCaptainConradYesTradeLaser) {
					i = (MAXWEAPON - 1)
					for (i >= 0) {
						if (g.Ship.Weapon[i] == MILITARYLASERWEAPON) {
							for m = (i + 1); (m < MAXWEAPON); m += 1 {
								g.Ship.Weapon[(m - 1)] = g.Ship.Weapon[m]
							}
							g.Ship.Weapon[(MAXWEAPON - 1)] = -1
							i = -1
						}
						i -= 1
					}
					if (i32(g.Difficulty) < HARD) {
						g.Mercenary[0].Engineer = u8(i32(g.Mercenary[0].Engineer) + 2)
					} else {
						g.Mercenary[0].Engineer = u8(i32(g.Mercenary[0].Engineer) + 1)
					}
					if (i32(g.Mercenary[0].Engineer) > MAXSKILL) {
						g.Mercenary[0].Engineer = u8(MAXSKILL)
					}
					FrmAlert(u16(TrainingCompletedAlert))
				}
			} else if (g.EncounterType == CAPTAINHUIEENCOUNTER) {
				if (i32(FrmAlert(u16(EngageCaptainHuieAlert))) == EngageCaptainHuieYesTradeLaser) {
					i = (MAXWEAPON - 1)
					for (i >= 0) {
						if (g.Ship.Weapon[i] == MILITARYLASERWEAPON) {
							for m = (i + 1); (m < MAXWEAPON); m += 1 {
								g.Ship.Weapon[(m - 1)] = g.Ship.Weapon[m]
							}
							g.Ship.Weapon[(MAXWEAPON - 1)] = -1
							i = -1
						}
						i -= 1
					}
					if (i32(g.Difficulty) < HARD) {
						g.Mercenary[0].Trader = u8(i32(g.Mercenary[0].Trader) + 2)
					} else {
						g.Mercenary[0].Trader = u8(i32(g.Mercenary[0].Trader) + 1)
					}
					if (i32(g.Mercenary[0].Trader) > MAXSKILL) {
						g.Mercenary[0].Trader = u8(MAXSKILL)
					}
					RecalculateBuyPrices(g.Mercenary[0].CurSystem)
					FrmAlert(u16(TrainingCompletedAlert))
				}
			}
		} else if (i32(eventP.data.ctlSelect.controlID) == EncounterBoardButton) {
			if (g.EncounterType == MARIECELESTEENCOUNTER) {
				if (i32(FrmAlert(u16(EngageMarieAlert))) == EngageMarieYesTakeCargo) {
					g.CurForm = PlunderForm
					FrmGotoForm(u16(g.CurForm))
					return true
				}
			}
		} else if (i32(eventP.data.ctlSelect.controlID) == EncounterDrinkButton) {
			if (g.EncounterType == BOTTLEGOODENCOUNTER) {
				if (i32(FrmAlert(u16(EngageBottleAlert))) == EngageBottleYesDrinkIt) {
					IncreaseRandomSkill()
					if (i32(g.Difficulty) < HARD) {
						IncreaseRandomSkill()
					}
					FrmAlert(u16(GoodDrinkAlert))
				}
			} else if (g.EncounterType == BOTTLEOLDENCOUNTER) {
				if (i32(FrmAlert(u16(EngageBottleAlert))) == EngageBottleYesDrinkIt) {
					TonicTweakRandomSkill()
					FrmAlert(u16(StrangeDrinkAlert))
				}
			}
		}
		Travel()
		handled = true
	case:
	}
	return handled
}

