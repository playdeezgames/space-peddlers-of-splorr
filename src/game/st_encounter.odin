GetBounty :: proc(Sh: ^SHIP) -> i32 {
	Bounty: i32 = EnemyShipPrice(Sh)
	Bounty /= 200
	Bounty /= 25
	Bounty *= 25
	if (Bounty <= 0) {
		Bounty = 25
	}
	if (Bounty > 2500) {
		Bounty = 2500
	}
	return Bounty
}

