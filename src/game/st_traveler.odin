InsuranceMoney :: proc() -> i32 {
	if !g.Insurance {
		return 0
	} else {
		return (((1) >= ((((CurrentShipPriceWithoutCargo(true) * 5) / 2000) * (100 - (((g.NoClaim) <= (90)) ? (g.NoClaim) : (90)))) / 100)) ? (1) : ((((CurrentShipPriceWithoutCargo(true) * 5) / 2000) * (100 - (((g.NoClaim) <= (90)) ? (g.NoClaim) : (90)))) / 100))
	}
	return {}
}

StandardPrice :: proc(Good: u8, Size: u8, Tech: u8, Government: u8, Resources: i32) -> i32 {
	Price: i32
	if (((i32(Good) == NARCOTICS) && (!Politics[Government].DrugsOK)) || ((i32(Good) == FIREARMS) && (!Politics[Government].FirearmsOK))) {
		return 0
	}
	Price = (Tradeitem[Good].PriceLowTech + (i32(Tech) * Tradeitem[Good].PriceInc))
	if (Politics[Government].Wanted == i32(Good)) {
		Price = ((Price * 4) / 3)
	}
	Price = ((Price * (100 - (2 * i32(Politics[Government].StrengthTraders)))) / 100)
	Price = ((Price * (100 - i32(Size))) / 100)
	if (Resources > 0) {
		if (Tradeitem[Good].CheapResource >= 0) {
			if (Resources == Tradeitem[Good].CheapResource) {
				Price = ((Price * 3) / 4)
			}
		}
		if (Tradeitem[Good].ExpensiveResource >= 0) {
			if (Resources == Tradeitem[Good].ExpensiveResource) {
				Price = ((Price * 4) / 3)
			}
		}
	}
	if (i32(Tech) < i32(Tradeitem[Good].TechUsage)) {
		return 0
	}
	if (Price < 0) {
		return 0
	}
	return Price
}

MercenaryMoney :: proc() -> i32 {
	i: i32
	ToPay: i32
	ToPay = 0
	for i = 1; (i < MAXCREW); i += 1 {
		if (g.Ship.Crew[i] >= 0) {
			ToPay += (((g.Ship.Crew[i] < 0) || ((g.Ship.Crew[i] >= MAXCREWMEMBER) && (i32(g.WildStatus) == 2))) ? 0 : ((((i32(g.Mercenary[g.Ship.Crew[i]].Pilot) + i32(g.Mercenary[g.Ship.Crew[i]].Fighter)) + i32(g.Mercenary[g.Ship.Crew[i]].Trader)) + i32(g.Mercenary[g.Ship.Crew[i]].Engineer)) * 3))
		}
	}
	return ToPay
}

WormholeTax :: proc(a: i32, b: i32) -> i32 {
	if WormholeExists(a, b) {
		return (i32(Shiptype[g.Ship.Type].CostOfFuel) * 25)
	}
	return 0
}

GetScore :: proc(EndStatus: u8, Days: i32, Worth_in: i32, Level: u8) -> i32 {
	Worth := Worth_in
	d: i32
	Worth = ((Worth < 1000000) ? Worth : (1000000 + ((Worth - 1000000) / 10)))
	if (i32(EndStatus) == KILLED) {
		return ((i32(Level) + 1) * ((Worth * 90) / 50000))
	} else if (i32(EndStatus) == RETIRED) {
		return ((i32(Level) + 1) * ((Worth * 95) / 50000))
	} else {
		d = (((i32(Level) + 1) * 100) - Days)
		if (d < 0) {
			d = 0
		}
		return ((i32(Level) + 1) * ((Worth + (d * 1000)) / 500))
	}
	return {}
}

