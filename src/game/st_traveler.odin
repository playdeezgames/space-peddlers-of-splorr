EndOfGame :: proc(EndStatus: u8) {
	i: i32
	j: i32
	Scored: bool
	a: i32
	b: i32
	frmP: ^FormType
	pmDB: DmOpenRef
	pmDB = OpenDatabase()
	Scored = false
	i = 0
	for (i < MAXHIGHSCORE) {
		a = GetScore(EndStatus, g.Days, CurrentWorth(), g.Difficulty)
		b = GetScore(g.Hscores[i].Status, g.Hscores[i].Days, g.Hscores[i].Worth, g.Hscores[i].Difficulty)
		if ((((a > b) || ((a == b) && (CurrentWorth() > g.Hscores[i].Worth))) || (((a == b) && (CurrentWorth() == g.Hscores[i].Worth)) && (g.Days > g.Hscores[i].Days))) || (i32(g.Hscores[i].Name[0]) == 0)) {
			for j = (MAXHIGHSCORE - 1); (j > i); j -= 1 {
				StrCopy(cstring(&g.Hscores[j].Name[0]), cstring(&g.Hscores[(j - 1)].Name[0]))
				g.Hscores[j].Status = g.Hscores[(j - 1)].Status
				g.Hscores[j].Days = g.Hscores[(j - 1)].Days
				g.Hscores[j].Worth = g.Hscores[(j - 1)].Worth
				g.Hscores[j].Difficulty = g.Hscores[(j - 1)].Difficulty
			}
			StrCopy(cstring(&g.Hscores[i].Name[0]), cstring(&g.NameCommander[0]))
			g.Hscores[i].Status = EndStatus
			g.Hscores[i].Days = g.Days
			g.Hscores[i].Worth = CurrentWorth()
			g.Hscores[i].Difficulty = g.Difficulty
			Scored = true
			if !g.GameLoaded {
				SaveStatus(pmDB)
			}
			break
		}
		i += 1
	}
	DmCloseDatabase(pmDB)
	frmP = FrmInitForm(u16(FinalScoreForm))
	StrCopy(cstring(&g.SBuf[0]), "You achieved a score of ")
	StrIToA(cstring(&g.SBuf2[0]), (a / 50))
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	StrCat(cstring(&g.SBuf[0]), ".")
	StrIToA(cstring(&g.SBuf2[0]), ((a % 50) / 5))
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	StrCat(cstring(&g.SBuf[0]), "%.")
	setLabelText(frmP, FinalScoreScoreLabel, cstring(&g.SBuf[0]))
	if (Scored && g.GameLoaded) {
		setLabelText(frmP, FinalScoreCongratulationsLabel, "Without loading a savegame, you")
		setLabelText(frmP, FinalScoreHighScoreLabel, "would have made the high-score list.")
	} else if Scored {
		setLabelText(frmP, FinalScoreCongratulationsLabel, "Congratulations!")
		setLabelText(frmP, FinalScoreHighScoreLabel, "You have made the high-score list!")
	} else {
		setLabelText(frmP, FinalScoreCongratulationsLabel, "Alas! This is not enough to enter")
		setLabelText(frmP, FinalScoreHighScoreLabel, "the high-score list.")
	}
	FrmDoDialog(frmP)
	FrmDeleteForm(frmP)
	g.CurForm = MainForm
	if (Scored && !g.GameLoaded) {
		ViewHighScores()
	}
	FrmGotoForm(u16(g.CurForm))
}

InitializeTradeitems :: proc(Index: i32) {
	i: i32
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		if ((((i == NARCOTICS) && (!Politics[g.SolarSystem[Index].Politics].DrugsOK)) || ((i == FIREARMS) && (!Politics[g.SolarSystem[Index].Politics].FirearmsOK))) || (i32(g.SolarSystem[Index].TechLevel) < i32(Tradeitem[i].TechProduction))) {
			g.SolarSystem[Index].Qty[i] = 0
			continue
		}
		g.SolarSystem[Index].Qty[i] = (((9 + (i32(SysRandom(0)) % (5))) - (((i32(Tradeitem[i].TechTopProduction) - i32(g.SolarSystem[Index].TechLevel)) < 0) ? (-(i32(Tradeitem[i].TechTopProduction) - i32(g.SolarSystem[Index].TechLevel))) : (i32(Tradeitem[i].TechTopProduction) - i32(g.SolarSystem[Index].TechLevel)))) * (1 + i32(g.SolarSystem[i].Size)))
		if ((i == ROBOTS) || (i == NARCOTICS)) {
			g.SolarSystem[Index].Qty[i] = (((g.SolarSystem[Index].Qty[i] * (5 - i32(g.Difficulty))) / (6 - i32(g.Difficulty))) + 1)
		}
		if (Tradeitem[i].CheapResource >= 0) {
			if (i32(g.SolarSystem[Index].SpecialResources) == Tradeitem[i].CheapResource) {
				g.SolarSystem[Index].Qty[i] = ((g.SolarSystem[Index].Qty[i] * 4) / 3)
			}
		}
		if (Tradeitem[i].ExpensiveResource >= 0) {
			if (i32(g.SolarSystem[Index].SpecialResources) == Tradeitem[i].ExpensiveResource) {
				g.SolarSystem[Index].Qty[i] = ((g.SolarSystem[Index].Qty[i] * 3) >> 2)
			}
		}
		if (Tradeitem[i].DoublePriceStatus >= 0) {
			if (i32(g.SolarSystem[Index].Status) == Tradeitem[i].DoublePriceStatus) {
				g.SolarSystem[Index].Qty[i] = (g.SolarSystem[Index].Qty[i] / 5)
			}
		}
		g.SolarSystem[Index].Qty[i] = ((g.SolarSystem[Index].Qty[i] - (i32(SysRandom(0)) % (10))) + (i32(SysRandom(0)) % (10)))
		if (g.SolarSystem[Index].Qty[i] < 0) {
			g.SolarSystem[Index].Qty[i] = 0
		}
	}
}

DeterminePrices :: proc(SystemID: u8) {
	i: i32
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		g.BuyPrice[i] = StandardPrice(u8(i), g.SolarSystem[SystemID].Size, g.SolarSystem[SystemID].TechLevel, g.SolarSystem[SystemID].Politics, i32(g.SolarSystem[SystemID].SpecialResources))
		if (g.BuyPrice[i] <= 0) {
			g.BuyPrice[i] = 0
			g.SellPrice[i] = 0
			continue
		}
		if (Tradeitem[i].DoublePriceStatus >= 0) {
			if (i32(g.SolarSystem[SystemID].Status) == Tradeitem[i].DoublePriceStatus) {
				g.BuyPrice[i] = ((g.BuyPrice[i] * 3) >> 1)
			}
		}
		g.BuyPrice[i] = ((g.BuyPrice[i] + (i32(SysRandom(0)) % (Tradeitem[i].Variance))) - (i32(SysRandom(0)) % (Tradeitem[i].Variance)))
		if (g.BuyPrice[i] <= 0) {
			g.BuyPrice[i] = 0
			g.SellPrice[i] = 0
			continue
		}
		g.SellPrice[i] = g.BuyPrice[i]
		if (g.PoliceRecordScore < DUBIOUSSCORE) {
			g.SellPrice[i] = ((g.SellPrice[i] * 90) / 100)
		}
	}
	RecalculateBuyPrices(SystemID)
}

DoWarp :: proc(viaSingularity: bool) {
	i: i32
	Distance: i32
	if (i32(g.WildStatus) == 1) {
		if !(HasWeapon(&g.Ship, u8(BEAMLASERWEAPON), false)) {
			if (i32(FrmCustomAlert(u16(WildWontGoAlert), SolarSystemName[g.SolarSystem[g.Mercenary[0].CurSystem].NameIndex], nil, nil)) != WildWontGoSayGoodbyetoWild) {
				return
			} else {
				FrmCustomAlert(u16(WildLeavesShipAlert), SolarSystemName[g.SolarSystem[g.Mercenary[0].CurSystem].NameIndex], nil, nil)
				g.WildStatus = u8(0)
			}
		}
	}
	if (g.Debt > DEBTTOOLARGE) {
		FrmAlert(u16(DebtTooLargeForTravelAlert))
		return
	}
	if (MercenaryMoney() > g.Credits) {
		FrmAlert(u16(MustPayMercenariesAlert))
		return
	}
	if g.Insurance {
		if ((InsuranceMoney() + MercenaryMoney()) > g.Credits) {
			FrmAlert(u16(CantPayInsuranceAlert))
			return
		}
	}
	if (((InsuranceMoney() + MercenaryMoney()) + WormholeTax(i32(g.Mercenary[0].CurSystem), g.WarpSystem)) > g.Credits) {
		FrmAlert(u16(CantPayWormholeAlert))
		return
	}
	if !viaSingularity {
		g.Credits -= WormholeTax(i32(g.Mercenary[0].CurSystem), g.WarpSystem)
		g.Credits -= MercenaryMoney()
		g.Credits -= InsuranceMoney()
	}
	for i = 0; (i < MAXSHIELD); i += 1 {
		if (g.Ship.Shield[i] < 0) {
			break
		}
		g.Ship.ShieldStrength[i] = Shieldtype[g.Ship.Shield[i]].Power
	}
	g.SolarSystem[g.Mercenary[0].CurSystem].CountDown = u8((3 + i32(g.Difficulty)))
	if (WormholeExists(i32(g.Mercenary[0].CurSystem), g.WarpSystem) || viaSingularity) {
		Distance = 0
		g.ArrivedViaWormhole = true
	} else {
		Distance = RealDistance(g.SolarSystem[g.Mercenary[0].CurSystem], g.SolarSystem[g.WarpSystem])
		g.Ship.Fuel = u8(i32(g.Ship.Fuel) - (((Distance) <= i32((GetFuel()))) ? (Distance) : i32((GetFuel()))))
		g.ArrivedViaWormhole = false
	}
	resetNewsEvents()
	if !viaSingularity {
		PayInterest()
		IncDays(1)
		if g.Insurance {
			g.NoClaim += 1
		}
	} else {
		addNewsEvent(ARRIVALVIASINGULARITY)
	}
	g.Clicks = u8(21)
	g.Raided = false
	g.Inspected = false
	g.LitterWarning = false
	g.MonsterHull = ((g.MonsterHull * 105) / 100)
	if (g.MonsterHull > Shiptype[g.SpaceMonster.Type].HullStrength) {
		g.MonsterHull = Shiptype[g.SpaceMonster.Type].HullStrength
	}
	if ((g.Days % 3) == 0) {
		if (g.PoliceRecordScore > CLEANSCORE) {
			g.PoliceRecordScore -= 1
		}
	}
	if (g.PoliceRecordScore < DUBIOUSSCORE) {
		if (i32(g.Difficulty) <= NORMAL) {
			g.PoliceRecordScore += 1
		} else if ((g.Days % i32(g.Difficulty)) == 0) {
			g.PoliceRecordScore += 1
		}
	}
	g.PossibleToGoThroughRip = true
	DeterminePrices(u8(g.WarpSystem))
	Travel()
}

ShowExecuteWarp :: proc() {
	frmP: ^FormType
	Distance: i32
	frmP = FrmGetActiveForm()
	RectangularShortcuts(frmP, ExecuteWarpBButton)
	FrmDrawForm(frmP)
	EraseRectangle(76, 18, 52, 12)
	EraseRectangle(76, 31, 80, 76)
	EraseRectangle(76, 109, 39, 12)
	setLabelText(frmP, ExecuteWarpSystemNameLabel, SolarSystemName[g.SolarSystem[g.WarpSystem].NameIndex])
	setLabelText(frmP, ExecuteWarpTechLevelLabel, TechLevel[g.SolarSystem[g.WarpSystem].TechLevel])
	setLabelText(frmP, ExecuteWarpGovernmentLabel, Politics[g.SolarSystem[g.WarpSystem].Politics].Name)
	setLabelText(frmP, ExecuteWarpSizeLabel, SystemSize[g.SolarSystem[g.WarpSystem].Size])
	if WormholeExists(i32(g.Mercenary[0].CurSystem), g.WarpSystem) {
		StrCopy(cstring(&g.SBuf[0]), "Wormhole")
	} else {
		Distance = RealDistance(g.SolarSystem[g.Mercenary[0].CurSystem], g.SolarSystem[g.WarpSystem])
		StrIToA(cstring(&g.SBuf[0]), Distance)
		StrCat(cstring(&g.SBuf[0]), " parsecs")
	}
	setLabelText(frmP, ExecuteWarpRangeLabel, cstring(&g.SBuf[0]))
	setLabelText(frmP, ExecuteWarpPoliceLabel, Activity[Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPolice])
	setLabelText(frmP, ExecuteWarpPiratesLabel, Activity[Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPirates])
	StrIToA(cstring(&g.SBuf[0]), (((InsuranceMoney() + MercenaryMoney()) + ((g.Debt > 0) ? (((g.Debt / 10) >= (1)) ? (g.Debt / 10) : (1)) : 0)) + WormholeTax(i32(g.Mercenary[0].CurSystem), g.WarpSystem)))
	StrCat(cstring(&g.SBuf[0]), " cr.")
	setLabelText(frmP, ExecuteWarpCurrentCostsLabel, cstring(&g.SBuf[0]))
	if WormholeExists(i32(g.Mercenary[0].CurSystem), g.WarpSystem) {
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpWarpButton)))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpPricesButton)))
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpOutOfRangeLabel)))
	} else if (Distance > i32(GetFuel())) {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpWarpButton)))
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpPricesButton)))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpOutOfRangeLabel)))
	} else if (Distance <= 0) {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpWarpButton)))
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpPricesButton)))
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpOutOfRangeLabel)))
	} else {
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpWarpButton)))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpPricesButton)))
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpOutOfRangeLabel)))
	}
	if (((WormholeExists(i32(g.Mercenary[0].CurSystem), g.WarpSystem) || g.Insurance) || (g.Debt > 0)) || (g.Ship.Crew[1] >= 0)) {
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpSpecificationButton)))
	} else {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ExecuteWarpSpecificationButton)))
	}
	FrmDrawForm(frmP)
}

