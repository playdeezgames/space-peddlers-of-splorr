ShuffleStatus :: proc() {
	i: i32
	for i = 0; (i < MAXSOLARSYSTEM); i += 1 {
		if (i32(g.SolarSystem[i].Status) > 0) {
			if ((i32(SysRandom(0)) % (100)) < 15) {
				g.SolarSystem[i].Status = u8(UNEVENTFUL)
			}
		} else if ((i32(SysRandom(0)) % (100)) < 15) {
			g.SolarSystem[i].Status = u8((1 + (i32(SysRandom(0)) % (MAXSTATUS - 1))))
		}
	}
}

NextSystemWithinRange :: proc(Current: i32, Back: bool) -> i32 {
	i: i32 = Current
	_ = (Back ? pre_dec(&i) : pre_inc(&i))
	for true {
		if (i < 0) {
			i = (MAXSOLARSYSTEM - 1)
		} else if (i >= MAXSOLARSYSTEM) {
			i = 0
		}
		if (i == Current) {
			break
		}
		if WormholeExists(i32(g.Mercenary[0].CurSystem), i) {
			return i
		} else if ((RealDistance(g.SolarSystem[g.Mercenary[0].CurSystem], g.SolarSystem[i]) <= i32(GetFuel())) && (RealDistance(g.SolarSystem[g.Mercenary[0].CurSystem], g.SolarSystem[i]) > 0)) {
			return i
		}
		_ = (Back ? pre_dec(&i) : pre_inc(&i))
	}
	return -1
}

