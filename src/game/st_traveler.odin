	if g.SolarSystem[g.WarpSystem].Visited {
		StrCopy(cstring(&g.SBuf[0]), SpecialResources[g.SolarSystem[g.WarpSystem].SpecialResources])
	} else {
		StrCopy(cstring(&g.SBuf[0]), "Special resources unknown")
	}
	setLabelText(frmP, AveragePricesResourcesLabel, cstring(&g.SBuf[0]))
	setLabelText(frmP, AveragePricesSystemNameLabel, SolarSystemName[g.SolarSystem[g.WarpSystem].NameIndex])
	if g.PriceDifferences {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(AveragePricesPriceDifferencesButton)))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(AveragePricesAbsolutePricesButton)))
	} else {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(AveragePricesAbsolutePricesButton)))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(AveragePricesPriceDifferencesButton)))
	}
	FrmDrawForm(frmP)
	SBufBays()
	FntSetFont(stdFont)
	i = (5 * i32(StrLen(cstring(&g.SBuf[0]))))
	StrCopy(cstring(&g.SBuf2[0]), "Bays: ")
	StrCat(cstring(&g.SBuf2[0]), cstring(&g.SBuf[0]))
	DrawChars(cstring(&g.SBuf2[0]), ((160 - 23) - i), 113)
	EraseRectangle(0, 46, 160, 65)
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		Price = StandardPrice(u8(i), g.SolarSystem[g.WarpSystem].Size, g.SolarSystem[g.WarpSystem].TechLevel, g.SolarSystem[g.WarpSystem].Politics, (g.SolarSystem[g.WarpSystem].Visited ? i32(g.SolarSystem[g.WarpSystem].SpecialResources) : -1))
		if (((Price > g.BuyPrice[i]) && (g.BuyPrice[i] > 0)) && (g.SolarSystem[g.Mercenary[0].CurSystem].Qty[i] > 0)) {
			FntSetFont(boldFont)
		} else {
			FntSetFont(stdFont)
		}
		DrawChars(Tradeitem[i].Name, ((i / 5) * 72), (46 + ((i % 5) * 13)))
		FntSetFont(stdFont)
		g.SBuf[0] = u8(0)
		if (g.PriceDifferences && (Price > g.BuyPrice[i])) {
			StrCat(cstring(&g.SBuf[0]), "+")
		}
		StrIToA(cstring(&g.SBuf2[0]), (g.PriceDifferences ? (Price - g.BuyPrice[i]) : Price))
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), " cr.")
		if ((Price <= 0) || (g.PriceDifferences && (g.BuyPrice[i] <= 0))) {
			DrawChars("---", (((i / 5) * 95) + 50), (46 + ((i % 5) * 13)))
		} else {
			j = (MAXPRICEDIGITS - i32(StrLen(cstring(&g.SBuf[0]))))
			pos = ((((i / 5) * 95) + 49) + (j * 5))
			if g.PriceDifferences {
				if (Price > g.BuyPrice[i]) {
					pos -= 1
				} else if (Price < g.BuyPrice[i]) {
					pos += 1
				}
			}
			DrawChars(cstring(&g.SBuf[0]), pos, (46 + ((i % 5) * 13)))
		}
	}
}

GenerateOpponent :: proc(Opp: u8) {
	Redo: bool
	i: i32
	j: i32
	sum: i32
	Tries: i32
	d: i32
	e: i32
	f: i32
	k: i32
	m: i32
	Bays: i32
	Tries = 1
	if (i32(Opp) == FAMOUSCAPTAIN) {
		g.Opponent.Type = u8((MAXSHIPTYPE - 1))
		for i = 0; (i < MAXSHIELD); i += 1 {
			g.Opponent.Shield[i] = REFLECTIVESHIELD
			g.Opponent.ShieldStrength[i] = RSHIELDPOWER
		}
		for i = 0; (i < MAXWEAPON); i += 1 {
			g.Opponent.Weapon[i] = MILITARYLASERWEAPON
		}
		g.Opponent.Gadget[0] = TARGETINGSYSTEM
		g.Opponent.Gadget[1] = NAVIGATINGSYSTEM
		g.Opponent.Hull = Shiptype[(MAXSHIPTYPE - 1)].HullStrength
		g.Opponent.Crew[0] = MAXCREWMEMBER
		g.Mercenary[g.Opponent.Crew[0]].Pilot = u8(MAXSKILL)
		g.Mercenary[g.Opponent.Crew[0]].Fighter = u8(MAXSKILL)
		g.Mercenary[g.Opponent.Crew[0]].Trader = u8(MAXSKILL)
		g.Mercenary[g.Opponent.Crew[0]].Engineer = u8(MAXSKILL)
		return
	}
	if (i32(Opp) == MANTIS) {
		Tries = (1 + i32(g.Difficulty))
	}
	if (i32(Opp) == POLICE) {
		if ((g.PoliceRecordScore < VILLAINSCORE) && (i32(g.WildStatus) != 1)) {
			Tries = 3
		} else if ((g.PoliceRecordScore < PSYCHOPATHSCORE) || (i32(g.WildStatus) == 1)) {
			Tries = 5
		}
		Tries = (((1) >= ((Tries + i32(g.Difficulty)) - NORMAL)) ? (1) : ((Tries + i32(g.Difficulty)) - NORMAL))
	}
	if (i32(Opp) == PIRATE) {
		Tries = (1 + (CurrentWorth() / 100000))
		Tries = (((1) >= ((Tries + i32(g.Difficulty)) - NORMAL)) ? (1) : ((Tries + i32(g.Difficulty)) - NORMAL))
	}
	j = 0
	if (i32(Opp) == TRADER) {
		g.Opponent.Type = u8(0)
	} else {
		g.Opponent.Type = u8(1)
	}
	k = ((i32(g.Difficulty) >= NORMAL) ? (i32(g.Difficulty) - NORMAL) : 0)
	for (j < Tries) {
		Redo = true
		for Redo {
			d = (i32(SysRandom(0)) % (100))
			i = 0
			sum = Shiptype[0].Occurrence
			for (sum < d) {
				if (i >= (MAXSHIPTYPE - 1)) {
					break
				}
				i += 1
				sum += Shiptype[i].Occurrence
			}
			if ((i32(Opp) == POLICE) && ((Shiptype[i].Police < 0) || ((i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPolice) + k) < Shiptype[i].Police))) {
				continue
			}
			if ((i32(Opp) == PIRATE) && ((Shiptype[i].Pirates < 0) || ((i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPirates) + k) < Shiptype[i].Pirates))) {
				continue
			}
			if ((i32(Opp) == TRADER) && ((Shiptype[i].Traders < 0) || ((i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthTraders) + k) < Shiptype[i].Traders))) {
				continue
			}
			Redo = false
		}
		if (i > i32(g.Opponent.Type)) {
			g.Opponent.Type = u8(i)
		}
		j += 1
	}
	if (i32(Opp) == MANTIS) {
		g.Opponent.Type = u8((MAXSHIPTYPE + 2))
	} else {
		Tries = (((1) >= (((CurrentWorth() / 150000) + i32(g.Difficulty)) - NORMAL)) ? (1) : (((CurrentWorth() / 150000) + i32(g.Difficulty)) - NORMAL))
	}
	if (i32(Shiptype[g.Opponent.Type].GadgetSlots) <= 0) {
		d = 0
	} else if (i32(g.Difficulty) <= HARD) {
		d = (i32(SysRandom(0)) % (i32(Shiptype[g.Opponent.Type].GadgetSlots) + 1))
		if (d < i32(Shiptype[g.Opponent.Type].GadgetSlots)) {
			if (Tries > 4) {
				d += 1
			} else if (Tries > 2) {
				d += (i32(SysRandom(0)) % (2))
			}
		}
	} else {
		d = i32(Shiptype[g.Opponent.Type].GadgetSlots)
	}
	for i = 0; (i < d); i += 1 {
		e = 0
		f = 0
		for (e < Tries) {
			k = (i32(SysRandom(0)) % (100))
			j = 0
			sum = i32(Gadgettype[0].Chance)
			for (k < sum) {
				if (j >= (MAXGADGETTYPE - 1)) {
					break
				}
				j += 1
				sum += i32(Gadgettype[j].Chance)
			}
			if !(HasGadget(&g.Opponent, u8(j))) {
				if (j > f) {
					f = j
				}
			}
			e += 1
		}
		g.Opponent.Gadget[i] = f
	}
	for i = d; (i < MAXGADGET); i += 1 {
		g.Opponent.Gadget[i] = -1
	}
	Bays = i32(Shiptype[g.Opponent.Type].CargoBays)
	for i = 0; (i < MAXGADGET); i += 1 {
		if (g.Opponent.Gadget[i] == EXTRABAYS) {
			Bays += 5
		}
	}
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		g.Opponent.Cargo[i] = 0
	}
	if (Bays > 5) {
		if (i32(g.Difficulty) >= NORMAL) {
			m = (3 + (i32(SysRandom(0)) % (Bays - 5)))
			sum = (((m) <= (15)) ? (m) : (15))
		} else {
			sum = Bays
		}
		if (i32(Opp) == POLICE) {
			sum = 0
		}
		if (i32(Opp) == PIRATE) {
			if (i32(g.Difficulty) < NORMAL) {
				sum = ((sum * 4) / 5)
			} else {
				sum = (sum / i32(g.Difficulty))
			}
		}
		if (sum < 1) {
			sum = 1
		}
		i = 0
		for (i < sum) {
			j = (i32(SysRandom(0)) % (MAXTRADEITEM))
			k = (1 + (i32(SysRandom(0)) % (10 - j)))
			if ((i + k) > sum) {
				k = (sum - i)
			}
			g.Opponent.Cargo[j] += k
			i += k
		}
	}
	g.Opponent.Fuel = Shiptype[g.Opponent.Type].FuelTanks
	g.Opponent.Tribbles = 0
	if (i32(Shiptype[g.Opponent.Type].WeaponSlots) <= 0) {
		d = 0
	} else if (i32(Shiptype[g.Opponent.Type].WeaponSlots) <= 1) {
		d = 1
	} else if (i32(g.Difficulty) <= HARD) {
		d = (1 + (i32(SysRandom(0)) % i32((Shiptype[g.Opponent.Type].WeaponSlots))))
		if (d < i32(Shiptype[g.Opponent.Type].WeaponSlots)) {
			if ((Tries > 4) && (i32(g.Difficulty) >= HARD)) {
				d += 1
			} else if ((Tries > 3) || (i32(g.Difficulty) >= HARD)) {
				d += (i32(SysRandom(0)) % (2))
			}
		}
	} else {
		d = i32(Shiptype[g.Opponent.Type].WeaponSlots)
	}
	for i = 0; (i < d); i += 1 {
		e = 0
		f = 0
		for (e < Tries) {
			k = (i32(SysRandom(0)) % (100))
			j = 0
			sum = i32(Weapontype[0].Chance)
			for (k < sum) {
				if (j >= (MAXWEAPONTYPE - 1)) {
					break
				}
				j += 1
				sum += i32(Weapontype[j].Chance)
			}
			if (j > f) {
				f = j
			}
			e += 1
		}
		g.Opponent.Weapon[i] = f
	}
	for i = d; (i < MAXWEAPON); i += 1 {
		g.Opponent.Weapon[i] = -1
	}
	if (i32(Shiptype[g.Opponent.Type].ShieldSlots) <= 0) {
		d = 0
	} else if (i32(g.Difficulty) <= HARD) {
		d = (i32(SysRandom(0)) % (i32(Shiptype[g.Opponent.Type].ShieldSlots) + 1))
		if (d < i32(Shiptype[g.Opponent.Type].ShieldSlots)) {
			if (Tries > 3) {
				d += 1
			} else if (Tries > 1) {
				d += (i32(SysRandom(0)) % (2))
			}
		}
	} else {
		d = i32(Shiptype[g.Opponent.Type].ShieldSlots)
	}
	for i = 0; (i < d); i += 1 {
		e = 0
		f = 0
		for (e < Tries) {
			k = (i32(SysRandom(0)) % (100))
			j = 0
			sum = i32(Shieldtype[0].Chance)
			for (k < sum) {
				if (j >= (MAXSHIELDTYPE - 1)) {
					break
				}
				j += 1
				sum += i32(Shieldtype[j].Chance)
			}
			if (j > f) {
				f = j
			}
			e += 1
		}
		g.Opponent.Shield[i] = f
		j = 0
		k = 0
		for (j < 5) {
			e = (1 + (i32(SysRandom(0)) % (Shieldtype[g.Opponent.Shield[i]].Power)))
			if (e > k) {
				k = e
			}
			j += 1
		}
		g.Opponent.ShieldStrength[i] = k
	}
	for i = d; (i < MAXSHIELD); i += 1 {
		g.Opponent.Shield[i] = -1
		g.Opponent.ShieldStrength[i] = 0
	}
	i = 0
	k = 0
	if ((g.Opponent.Shield[0] >= 0) && ((i32(SysRandom(0)) % (10)) <= 7)) {
		g.Opponent.Hull = Shiptype[g.Opponent.Type].HullStrength
	} else {
		for (i < 5) {
			d = (1 + (i32(SysRandom(0)) % (Shiptype[g.Opponent.Type].HullStrength)))
			if (d > k) {
				k = d
			}
			i += 1
		}
		g.Opponent.Hull = k
	}
	if ((i32(Opp) == MANTIS) || (i32(Opp) == FAMOUSCAPTAIN)) {
		g.Opponent.Hull = Shiptype[g.Opponent.Type].HullStrength
	}
	g.Opponent.Crew[0] = MAXCREWMEMBER
	g.Mercenary[g.Opponent.Crew[0]].Pilot = u8((1 + (i32(SysRandom(0)) % (MAXSKILL))))
	g.Mercenary[g.Opponent.Crew[0]].Fighter = u8((1 + (i32(SysRandom(0)) % (MAXSKILL))))
	g.Mercenary[g.Opponent.Crew[0]].Trader = u8((1 + (i32(SysRandom(0)) % (MAXSKILL))))
	g.Mercenary[g.Opponent.Crew[0]].Engineer = u8((1 + (i32(SysRandom(0)) % (MAXSKILL))))
	if (((g.WarpSystem == KRAVATSYSTEM) && (i32(g.WildStatus) == 1)) && ((i32(SysRandom(0)) % (10)) < (i32(g.Difficulty) + 1))) {
		g.Mercenary[g.Opponent.Crew[0]].Engineer = u8(MAXSKILL)
	}
	if (i32(g.Difficulty) <= HARD) {
		d = (1 + (i32(SysRandom(0)) % i32((Shiptype[g.Opponent.Type].CrewQuarters))))
		if ((i32(g.Difficulty) >= HARD) && (d < i32(Shiptype[g.Opponent.Type].CrewQuarters))) {
			d += 1
		}
	} else {
		d = i32(Shiptype[g.Opponent.Type].CrewQuarters)
	}
	for i = 1; (i < d); i += 1 {
		g.Opponent.Crew[i] = (i32(SysRandom(0)) % (MAXCREWMEMBER))
	}
	for i = d; (i < MAXCREW); i += 1 {
		g.Opponent.Crew[i] = -1
	}
}

ChangeQuantities :: proc() {
	i: i32
	j: i32
	for i = 0; (i < MAXSOLARSYSTEM); i += 1 {
		if (i32(g.SolarSystem[i].CountDown) > 0) {
			g.SolarSystem[i].CountDown -= 1
			if (i32(g.SolarSystem[i].CountDown) > (3 + i32(g.Difficulty))) {
				g.SolarSystem[i].CountDown = u8((3 + i32(g.Difficulty)))
			} else if (i32(g.SolarSystem[i].CountDown) <= 0) {
				InitializeTradeitems(i)
			} else {
				for j = 0; (j < MAXTRADEITEM); j += 1 {
					if ((((j == NARCOTICS) && (!Politics[g.SolarSystem[i].Politics].DrugsOK)) || ((j == FIREARMS) && (!Politics[g.SolarSystem[i].Politics].FirearmsOK))) || (i32(g.SolarSystem[i].TechLevel) < i32(Tradeitem[j].TechProduction))) {
						g.SolarSystem[i].Qty[j] = 0
						continue
					} else {
						g.SolarSystem[i].Qty[j] = ((g.SolarSystem[i].Qty[j] + (i32(SysRandom(0)) % (5))) - (i32(SysRandom(0)) % (5)))
						if (g.SolarSystem[i].Qty[j] < 0) {
							g.SolarSystem[i].Qty[j] = 0
						}
					}
				}
			}
		}
	}
}

ToSpend :: proc() -> i32 {
	if !g.ReserveMoney {
		return g.Credits
	}
	return (((0) >= ((g.Credits - MercenaryMoney()) - InsuranceMoney())) ? (0) : ((g.Credits - MercenaryMoney()) - InsuranceMoney()))
}

ViewHighScores :: proc() {
	frm: ^FormType
	i: i32
	Percentage: i32
	pmDB: DmOpenRef
	pmDB = OpenDatabase()
	DmCloseDatabase(pmDB)
	frm = FrmInitForm(u16(HighScoresForm))
	for i = 0; (i < MAXHIGHSCORE); i += 1 {
		if (i32(g.Hscores[i].Name[0]) == 0) {
			setLabelText(frm, (HighScoresName0Label + i), "Empty")
			setLabelText(frm, (HighScoresScore0Label + i), "")
			setLabelText(frm, (HighScoresDays0Label + i), "")
			setLabelText(frm, (HighScoresModeWorth0Label + i), "")
			continue
		}
		setLabelText(frm, (HighScoresName0Label + i), cstring(&g.Hscores[i].Name[0]))
		Percentage = GetScore(g.Hscores[i].Status, g.Hscores[i].Days, g.Hscores[i].Worth, g.Hscores[i].Difficulty)
		StrIToA(cstring(&g.SBuf[0]), (Percentage / 50))
		StrCat(cstring(&g.SBuf[0]), ".")
		StrIToA(cstring(&g.SBuf2[0]), ((Percentage % 50) / 5))
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), "%")
		setLabelText(frm, (HighScoresScore0Label + i), cstring(&g.SBuf[0]))
		if (i32(g.Hscores[i].Status) == MOON) {
			StrCopy(cstring(&g.SBuf[0]), "Claimed moon")
		} else if (i32(g.Hscores[i].Status) == RETIRED) {
			StrCopy(cstring(&g.SBuf[0]), "Retired")
		} else {
			StrCopy(cstring(&g.SBuf[0]), "Was killed")
		}
		StrCat(cstring(&g.SBuf[0]), " in ")
		SBufMultiples(g.Hscores[i].Days, "day")
		StrCat(cstring(&g.SBuf[0]), ", worth")
		setLabelText(frm, (HighScoresDays0Label + i), cstring(&g.SBuf[0]))
		StrIToA(cstring(&g.SBuf[0]), g.Hscores[i].Worth)
		StrCat(cstring(&g.SBuf[0]), " credits on ")
		if ((i32(g.Hscores[i].Difficulty) >= BEGINNER) && (i32(g.Hscores[i].Difficulty) <= IMPOSSIBLE)) {
			StrCat(cstring(&g.SBuf[0]), DifficultyLevel[g.Hscores[i].Difficulty])
			StrCat(cstring(&g.SBuf[0]), " level")
		}
		StrToLower(cstring(&g.SBuf2[0]), cstring(&g.SBuf[0]))
		setLabelText(frm, (HighScoresModeWorth0Label + i), cstring(&g.SBuf2[0]))
	}
	FrmDoDialog(frm)
	FrmDeleteForm(frm)
}

ClearHighScores :: proc() {
	d: i32
	pmDB: DmOpenRef
	d = i32(FrmAlert(u16(ClearTableAlert)))
	if (d == ClearTableYes) {
		pmDB = OpenDatabase()
		InitHighScores()
		SaveStatus(pmDB)
		DmCloseDatabase(pmDB)
	}
}

StartNewGame :: proc() -> bool {
	i: i32
	j: i32
	k: i32
	d: i32
	x: i32
	y: i32
	Redo: bool
	CloseFound: bool
	FreeWormhole: bool
	if (i32(g.NameCommander[0]) == 0) {
		StrCopy(cstring(&g.NameCommander[0]), "Shelby")
	}
	EraseRectangle(0, 0, 160, 160)
	FntSetFont(stdFont)
	DrawChars("Creating Galaxy...", 44, 76)
	i = 0
	for (i < MAXSOLARSYSTEM) {
		if (i < MAXWORMHOLE) {
			g.SolarSystem[i].X = u8((((CLOSEDISTANCE >> 1) - (i32(SysRandom(0)) % (CLOSEDISTANCE))) + ((GALAXYWIDTH * (1 + (2 * (i % 3)))) / 6)))
			g.SolarSystem[i].Y = u8((((CLOSEDISTANCE >> 1) - (i32(SysRandom(0)) % (CLOSEDISTANCE))) + ((GALAXYHEIGHT * ((i < 3) ? 1 : 3)) / 4)))
			g.Wormhole[i] = u8(i)
		} else {
			g.SolarSystem[i].X = u8((1 + (i32(SysRandom(0)) % (GALAXYWIDTH - 2))))
			g.SolarSystem[i].Y = u8((1 + (i32(SysRandom(0)) % (GALAXYHEIGHT - 2))))
		}
		CloseFound = false
		Redo = false
		if (i >= MAXWORMHOLE) {
			for j = 0; (j < i); j += 1 {
				if (SqrDistance(g.SolarSystem[j], g.SolarSystem[i]) <= ((MINDISTANCE + 1) * (MINDISTANCE + 1))) {
					Redo = true
					break
				}
				if (SqrDistance(g.SolarSystem[j], g.SolarSystem[i]) < ((CLOSEDISTANCE) * (CLOSEDISTANCE))) {
					CloseFound = true
				}
			}
		}
		if Redo {
			continue
		}
		if ((i >= MAXWORMHOLE) && !CloseFound) {
			continue
		}
		g.SolarSystem[i].TechLevel = u8((i32(SysRandom(0)) % (MAXTECHLEVEL)))
		g.SolarSystem[i].Politics = u8((i32(SysRandom(0)) % (MAXPOLITICS)))
		if (i32(Politics[g.SolarSystem[i].Politics].MinTechLevel) > i32(g.SolarSystem[i].TechLevel)) {
			continue
		}
		if (i32(Politics[g.SolarSystem[i].Politics].MaxTechLevel) < i32(g.SolarSystem[i].TechLevel)) {
			continue
		}
		if ((i32(SysRandom(0)) % (5)) >= 3) {
			g.SolarSystem[i].SpecialResources = u8((1 + (i32(SysRandom(0)) % (MAXRESOURCES - 1))))
		} else {
			g.SolarSystem[i].SpecialResources = u8(0)
		}
		g.SolarSystem[i].Size = u8((i32(SysRandom(0)) % (MAXSIZE)))
		if ((i32(SysRandom(0)) % (100)) < 15) {
			g.SolarSystem[i].Status = u8((1 + (i32(SysRandom(0)) % (MAXSTATUS - 1))))
		} else {
			g.SolarSystem[i].Status = u8(UNEVENTFUL)
		}
		g.SolarSystem[i].NameIndex = u8(i)
		g.SolarSystem[i].Special = -1
		g.SolarSystem[i].CountDown = u8(0)
		g.SolarSystem[i].Visited = false
		InitializeTradeitems(i)
		i += 1
	}
	for i = 0; (i < MAXSOLARSYSTEM); i += 1 {
		d = 0
		for (d < MAXWORMHOLE) {
			if (i32(g.Wormhole[d]) == i) {
				break
			}
			d += 1
		}
		j = (i32(SysRandom(0)) % (MAXSOLARSYSTEM))
		if WormholeExists(j, -1) {
			continue
		}
		x = i32(g.SolarSystem[i].X)
		y = i32(g.SolarSystem[i].Y)
		g.SolarSystem[i].X = g.SolarSystem[j].X
		g.SolarSystem[i].Y = g.SolarSystem[j].Y
		g.SolarSystem[j].X = u8(x)
		g.SolarSystem[j].Y = u8(y)
		if (d < MAXWORMHOLE) {
			g.Wormhole[d] = u8(j)
		}
	}
	for i = 0; (i < MAXWORMHOLE); i += 1 {
		j = (i32(SysRandom(0)) % (MAXWORMHOLE))
		x = i32(g.Wormhole[i])
		g.Wormhole[i] = g.Wormhole[j]
		g.Wormhole[j] = u8(x)
	}
	g.Mercenary[0].NameIndex = u8(0)
	g.Mercenary[0].Pilot = u8(1)
	g.Mercenary[0].Fighter = u8(1)
	g.Mercenary[0].Trader = u8(1)
	g.Mercenary[0].Engineer = u8(1)
	i = 1
	for (i <= MAXCREWMEMBER) {
		g.Mercenary[i].CurSystem = u8((i32(SysRandom(0)) % (MAXSOLARSYSTEM)))
		Redo = false
		for j = 1; (j < i); j += 1 {
			if (i32(g.Mercenary[j].CurSystem) == i32(g.Mercenary[i].CurSystem)) {
				Redo = true
				break
			}
		}
		if (i32(g.Mercenary[i].CurSystem) == KRAVATSYSTEM) {
			Redo = true
		}
		if Redo {
			continue
		}
		g.Mercenary[i].NameIndex = u8(i)
		g.Mercenary[i].Pilot = RandomSkill()
		g.Mercenary[i].Fighter = RandomSkill()
		g.Mercenary[i].Trader = RandomSkill()
		g.Mercenary[i].Engineer = RandomSkill()
		i += 1
	}
	g.Mercenary[(MAXCREWMEMBER - 1)].CurSystem = u8(255)
	g.SolarSystem[ACAMARSYSTEM].Special = MONSTERKILLED
	g.SolarSystem[BARATASSYSTEM].Special = FLYBARATAS
	g.SolarSystem[MELINASYSTEM].Special = FLYMELINA
	g.SolarSystem[REGULASSYSTEM].Special = FLYREGULAS
	g.SolarSystem[ZALKONSYSTEM].Special = DRAGONFLYDESTROYED
	g.SolarSystem[JAPORISYSTEM].Special = MEDICINEDELIVERY
	g.SolarSystem[UTOPIASYSTEM].Special = MOONBOUGHT
	g.SolarSystem[DEVIDIASYSTEM].Special = JAREKGETSOUT
	g.SolarSystem[KRAVATSYSTEM].Special = WILDGETSOUT
	FreeWormhole = false
	k = 0
	j = (i32(SysRandom(0)) % (MAXWORMHOLE))
	for (((((g.SolarSystem[g.Wormhole[j]].Special != -1) && (i32(g.Wormhole[j]) != GEMULONSYSTEM)) && (i32(g.Wormhole[j]) != DALEDSYSTEM)) && (i32(g.Wormhole[j]) != NIXSYSTEM)) && (k < 20)) {
		j = (i32(SysRandom(0)) % (MAXWORMHOLE))
		k += 1
	}
	if (k < 20) {
		FreeWormhole = true
		g.SolarSystem[g.Wormhole[j]].Special = SCARABDESTROYED
	}
	d = 999
	k = -1
	for i = 0; (i < MAXSOLARSYSTEM); i += 1 {
		j = RealDistance(g.SolarSystem[NIXSYSTEM], g.SolarSystem[i])
		if (((((j >= 70) && (j < d)) && (g.SolarSystem[i].Special < 0)) && (d != GEMULONSYSTEM)) && (d != DALEDSYSTEM)) {
			k = i
			d = j
		}
	}
	if (k >= 0) {
		g.SolarSystem[k].Special = GETREACTOR
		g.SolarSystem[NIXSYSTEM].Special = REACTORDELIVERED
	}
	i = 0
	for (i < MAXSOLARSYSTEM) {
		d = (1 + (i32(SysRandom(0)) % (MAXSOLARSYSTEM - 1)))
		if ((((g.SolarSystem[d].Special < 0) && (i32(g.SolarSystem[d].TechLevel) >= (MAXTECHLEVEL - 1))) && (d != GEMULONSYSTEM)) && (d != DALEDSYSTEM)) {
			g.SolarSystem[d].Special = ARTIFACTDELIVERY
			break
		}
		i += 1
	}
	if (i >= MAXSOLARSYSTEM) {
		SpecialEvent[ALIENARTIFACT].Occurrence = u8(0)
	}
	d = 999
	k = -1
	for i = 0; (i < MAXSOLARSYSTEM); i += 1 {
		j = RealDistance(g.SolarSystem[GEMULONSYSTEM], g.SolarSystem[i])
		if (((((j >= 70) && (j < d)) && (g.SolarSystem[i].Special < 0)) && (k != DALEDSYSTEM)) && (k != GEMULONSYSTEM)) {
			k = i
			d = j
		}
	}
	if (k >= 0) {
		g.SolarSystem[k].Special = ALIENINVASION
		g.SolarSystem[GEMULONSYSTEM].Special = GEMULONRESCUED
	}
	d = 999
	k = -1
	for i = 0; (i < MAXSOLARSYSTEM); i += 1 {
		j = RealDistance(g.SolarSystem[DALEDSYSTEM], g.SolarSystem[i])
		if (((j >= 70) && (j < d)) && (g.SolarSystem[i].Special < 0)) {
			k = i
			d = j
		}
	}
	if (k >= 0) {
		g.SolarSystem[k].Special = EXPERIMENT
		g.SolarSystem[DALEDSYSTEM].Special = EXPERIMENTSTOPPED
	}
	for i = MOONFORSALE; (i < (MAXSPECIALEVENT - ENDFIXED)); i += 1 {
		for j = 0; (j < i32(SpecialEvent[i].Occurrence)); j += 1 {
			Redo = true
			for Redo {
				d = (1 + (i32(SysRandom(0)) % (MAXSOLARSYSTEM - 1)))
				if (g.SolarSystem[d].Special < 0) {
					if (FreeWormhole || (i != SCARAB)) {
						g.SolarSystem[d].Special = i
					}
					Redo = false
				}
			}
		}
	}
	for i = 0; (i < 200); i += 1 {
		g.Mercenary[0].CurSystem = u8((i32(SysRandom(0)) % (MAXSOLARSYSTEM)))
		if (g.SolarSystem[g.Mercenary[0].CurSystem].Special >= 0) {
			continue
		}
		if ((i < 100) && ((i32(g.SolarSystem[g.Mercenary[0].CurSystem].TechLevel) <= 0) || (i32(g.SolarSystem[g.Mercenary[0].CurSystem].TechLevel) >= 6))) {
			continue
		}
		d = 0
		for j = 0; (j < MAXSOLARSYSTEM); j += 1 {
			if (j == i32(g.Mercenary[0].CurSystem)) {
				continue
			}
			if (SqrDistance(g.SolarSystem[j], g.SolarSystem[g.Mercenary[0].CurSystem]) <= (i32((Shiptype[1].FuelTanks)) * i32((Shiptype[1].FuelTanks)))) {
				d += 1
				if (d >= 3) {
					break
				}
			}
		}
		if (d < 3) {
			continue
		}
		break
	}
	g.Credits = 1000
	g.Debt = 0
	g.Days = 0
	g.WarpSystem = i32(g.Mercenary[0].CurSystem)
	g.PoliceKills = 0
	g.TraderKills = 0
	g.PirateKills = 0
	g.PoliceRecordScore = 0
	g.ReputationScore = 0
	g.MonsterStatus = u8(0)
	g.DragonflyStatus = u8(0)
	g.ScarabStatus = u8(0)
	g.JaporiDiseaseStatus = u8(0)
	g.MoonBought = false
	g.MonsterHull = Shiptype[g.SpaceMonster.Type].HullStrength
	g.EscapePod = false
	g.Insurance = false
	g.RemindLoans = true
	g.NoClaim = 0
	g.ArtifactOnBoard = false
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		g.BuyingPrice[i] = 0
	}
	g.TribbleMessage = false
	g.JarekStatus = u8(0)
	g.InvasionStatus = u8(0)
	g.ExperimentStatus = u8(0)
	g.FabricRipProbability = u8(0)
	g.PossibleToGoThroughRip = false
	g.ArrivedViaWormhole = false
	g.VeryRareEncounter = u8(0)
	resetNewsEvents()
	g.WildStatus = u8(0)
	g.ReactorStatus = u8(0)
	g.TrackedSystem = -1
	g.ShowTrackedRange = true
	g.JustLootedMarie = false
	g.ChanceOfVeryRareEncounter = CHANCEOFVERYRAREENCOUNTER
	g.AlreadyPaidForNewspaper = false
	g.CanSuperWarp = false
	g.GameLoaded = false
	g.Ship.Type = u8(1)
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		g.Ship.Cargo[i] = 0
	}
	g.Ship.Weapon[0] = 0
	for i = 1; (i < MAXWEAPON); i += 1 {
		g.Ship.Weapon[i] = -1
	}
	for i = 0; (i < MAXSHIELD); i += 1 {
		g.Ship.Shield[i] = -1
		g.Ship.ShieldStrength[i] = 0
	}
	for i = 0; (i < MAXGADGET); i += 1 {
		g.Ship.Gadget[i] = -1
	}
	g.Ship.Crew[0] = 0
	for i = 1; (i < MAXCREW); i += 1 {
		g.Ship.Crew[i] = -1
	}
	g.Ship.Fuel = GetFuelTanks()
	g.Ship.Hull = Shiptype[g.Ship.Type].HullStrength
	g.Ship.Tribbles = 0
	EraseRectangle(0, 0, 160, 160)
	g.CurForm = NewCommanderForm
	FrmGotoForm(u16(g.CurForm))
	return true
}

IncDays :: proc(Amount: i32) {
	g.Days += Amount
	if ((i32(g.InvasionStatus) > 0) && (i32(g.InvasionStatus) < 8)) {
		g.InvasionStatus = u8(i32(g.InvasionStatus) + Amount)
		if (i32(g.InvasionStatus) >= 8) {
			g.SolarSystem[GEMULONSYSTEM].Special = GEMULONINVADED
			g.SolarSystem[GEMULONSYSTEM].TechLevel = u8(0)
			g.SolarSystem[GEMULONSYSTEM].Politics = u8(ANARCHY)
		}
	}
	if ((i32(g.ReactorStatus) > 0) && (i32(g.ReactorStatus) < 21)) {
		g.ReactorStatus = u8(i32(g.ReactorStatus) + Amount)
		if (i32(g.ReactorStatus) > 20) {
			g.ReactorStatus = u8(20)
		}
	}
	if ((i32(g.ExperimentStatus) > 0) && (i32(g.ExperimentStatus) < 12)) {
		g.ExperimentStatus = u8(i32(g.ExperimentStatus) + Amount)
		if (i32(g.ExperimentStatus) > 11) {
			g.FabricRipProbability = u8(FABRICRIPINITIALPROBABILITY)
			g.SolarSystem[DALEDSYSTEM].Special = EXPERIMENTNOTSTOPPED
			g.ExperimentStatus = u8(12)
			FrmAlert(u16(ExperimentPerformedAlert))
			addNewsEvent(EXPERIMENTPERFORMED)
		}
	} else if ((i32(g.ExperimentStatus) == 12) && (i32(g.FabricRipProbability) > 0)) {
		g.FabricRipProbability = u8(i32(g.FabricRipProbability) - Amount)
	}
}

Travel :: proc() {
	EncounterTest: i32
	StartClicks: i32
	i: i32
	j: i32
	Repairs: i32
	FirstEmptySlot: i32
	rareEncounter: i32
	Pirate: bool
	Trader: bool
	Police: bool
	Mantis: bool
	TryAutoRepair: bool
	FoodOnBoard: bool
	EasterEgg: bool
	HaveMilitaryLaser: bool
	HaveReflectiveShield: bool
	previousTribbles: i32
	Pirate = false
	Trader = false
	Police = false
	Mantis = false
	HaveMilitaryLaser = HasWeapon(&g.Ship, u8(MILITARYLASERWEAPON), true)
	HaveReflectiveShield = HasShield(&g.Ship, u8(REFLECTIVESHIELD))
	if (((g.PossibleToGoThroughRip && (i32(g.ExperimentStatus) == 12)) && (i32(g.FabricRipProbability) > 0)) && (((i32(SysRandom(0)) % (100)) < i32(g.FabricRipProbability)) || (i32(g.FabricRipProbability) == 25))) {
		FrmAlert(u16(FlyInFabricRipAlert))
		g.WarpSystem = (i32(SysRandom(0)) % (MAXSOLARSYSTEM))
	}
	g.PossibleToGoThroughRip = false
	StartClicks = i32(g.Clicks)
	g.Clicks -= 1
	for (i32(g.Clicks) > 0) {
		Repairs = ((i32(SysRandom(0)) % i32((EngineerSkill(&g.Ship)))) >> 1)
		g.Ship.Hull += Repairs
		if (g.Ship.Hull > GetHullStrength()) {
			Repairs = (g.Ship.Hull - GetHullStrength())
			g.Ship.Hull = GetHullStrength()
		} else {
			Repairs = 0
		}
		Repairs = (2 * Repairs)
		for i = 0; (i < MAXSHIELD); i += 1 {
			if (g.Ship.Shield[i] < 0) {
				break
			}
			g.Ship.ShieldStrength[i] += Repairs
			if (g.Ship.ShieldStrength[i] > Shieldtype[g.Ship.Shield[i]].Power) {
				Repairs = (g.Ship.ShieldStrength[i] - Shieldtype[g.Ship.Shield[i]].Power)
				g.Ship.ShieldStrength[i] = Shieldtype[g.Ship.Shield[i]].Power
			} else {
				Repairs = 0
			}
		}
		if (((i32(g.Clicks) == 1) && (g.WarpSystem == ACAMARSYSTEM)) && (i32(g.MonsterStatus) == 1)) {
			MemMove(cast(rawptr)(&g.Opponent), cast(rawptr)(&g.SpaceMonster), i32(u32(size_of((g.Opponent)))))
			g.Opponent.Hull = g.MonsterHull
			g.Mercenary[g.Opponent.Crew[0]].Pilot = u8((8 + i32(g.Difficulty)))
			g.Mercenary[g.Opponent.Crew[0]].Fighter = u8((8 + i32(g.Difficulty)))
			g.Mercenary[g.Opponent.Crew[0]].Trader = u8(1)
			g.Mercenary[g.Opponent.Crew[0]].Engineer = u8((1 + i32(g.Difficulty)))
			if Cloaked(&g.Ship, &g.Opponent) {
				g.EncounterType = SPACEMONSTERIGNORE
			} else {
				g.EncounterType = SPACEMONSTERATTACK
			}
			g.CurForm = EncounterForm
			FrmGotoForm(u16(g.CurForm))
			return
		}
		if ((((i32(g.Clicks) == 20) && (g.SolarSystem[g.WarpSystem].Special == SCARABDESTROYED)) && (i32(g.ScarabStatus) == 1)) && g.ArrivedViaWormhole) {
			MemMove(cast(rawptr)(&g.Opponent), cast(rawptr)(&g.Scarab), i32(u32(size_of((g.Opponent)))))
			g.Mercenary[g.Opponent.Crew[0]].Pilot = u8((5 + i32(g.Difficulty)))
			g.Mercenary[g.Opponent.Crew[0]].Fighter = u8((6 + i32(g.Difficulty)))
			g.Mercenary[g.Opponent.Crew[0]].Trader = u8(1)
			g.Mercenary[g.Opponent.Crew[0]].Engineer = u8((6 + i32(g.Difficulty)))
			if Cloaked(&g.Ship, &g.Opponent) {
				g.EncounterType = SCARABIGNORE
			} else {
				g.EncounterType = SCARABATTACK
			}
			g.CurForm = EncounterForm
			FrmGotoForm(u16(g.CurForm))
			return
		}
		if (((i32(g.Clicks) == 1) && (g.WarpSystem == ZALKONSYSTEM)) && (i32(g.DragonflyStatus) == 4)) {
			MemMove(cast(rawptr)(&g.Opponent), cast(rawptr)(&g.Dragonfly), i32(u32(size_of((g.Opponent)))))
			g.Mercenary[g.Opponent.Crew[0]].Pilot = u8((4 + i32(g.Difficulty)))
			g.Mercenary[g.Opponent.Crew[0]].Fighter = u8((6 + i32(g.Difficulty)))
			g.Mercenary[g.Opponent.Crew[0]].Trader = u8(1)
			g.Mercenary[g.Opponent.Crew[0]].Engineer = u8((6 + i32(g.Difficulty)))
			if Cloaked(&g.Ship, &g.Opponent) {
				g.EncounterType = DRAGONFLYIGNORE
			} else {
				g.EncounterType = DRAGONFLYATTACK
			}
			g.CurForm = EncounterForm
			FrmGotoForm(u16(g.CurForm))
			return
		}
		if ((g.WarpSystem == GEMULONSYSTEM) && (i32(g.InvasionStatus) > 7)) {
			if ((i32(SysRandom(0)) % (10)) > 4) {
				Mantis = true
			}
		} else {
			EncounterTest = (i32(SysRandom(0)) % (44 - (2 * i32(g.Difficulty))))
			if (i32(g.Ship.Type) == 0) {
				EncounterTest *= 2
			}
			if ((EncounterTest < i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPirates)) && !g.Raided) {
				Pirate = true
			} else if (EncounterTest < (i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPirates) + ((g.PoliceRecordScore < PSYCHOPATHSCORE) ? (3 * i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPolice)) : ((g.PoliceRecordScore < VILLAINSCORE) ? (2 * i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPolice)) : i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPolice))))) {
				Police = true
			} else if (EncounterTest < ((i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPirates) + ((g.PoliceRecordScore < PSYCHOPATHSCORE) ? (3 * i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPolice)) : ((g.PoliceRecordScore < VILLAINSCORE) ? (2 * i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPolice)) : i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthPolice)))) + i32(Politics[g.SolarSystem[g.WarpSystem].Politics].StrengthTraders))) {
				Trader = true
			} else if ((i32(g.WildStatus) == 1) && (g.WarpSystem == KRAVATSYSTEM)) {
				rareEncounter = (i32(SysRandom(0)) % (100))
				if ((i32(g.Difficulty) <= EASY) && (rareEncounter < 25)) {
					Police = true
				} else if ((i32(g.Difficulty) == NORMAL) && (rareEncounter < 33)) {
					Police = true
				} else if ((i32(g.Difficulty) > NORMAL) && (rareEncounter < 50)) {
					Police = true
				}
			}
			if !((Trader || Police) || Pirate) {
				if (g.ArtifactOnBoard && ((i32(SysRandom(0)) % (20)) <= 3)) {
					Mantis = true
				}
			}
		}
		if Police {
			GenerateOpponent(u8(POLICE))
			g.EncounterType = POLICEIGNORE
			if Cloaked(&g.Ship, &g.Opponent) {
				g.EncounterType = POLICEIGNORE
			} else if (g.PoliceRecordScore < DUBIOUSSCORE) {
				if (TotalWeapons(&g.Opponent, -1, -1) <= 0) {
					if Cloaked(&g.Opponent, &g.Ship) {
						g.EncounterType = POLICEIGNORE
					} else {
						g.EncounterType = POLICEFLEE
					}
				}
				if (g.ReputationScore < AVERAGESCORE) {
					g.EncounterType = POLICEATTACK
				} else if ((i32(SysRandom(0)) % (ELITESCORE)) > (g.ReputationScore / (1 + i32(g.Opponent.Type)))) {
					g.EncounterType = POLICEATTACK
				} else if Cloaked(&g.Opponent, &g.Ship) {
					g.EncounterType = POLICEIGNORE
				} else {
					g.EncounterType = POLICEFLEE
				}
			} else if (((g.PoliceRecordScore >= DUBIOUSSCORE) && (g.PoliceRecordScore < CLEANSCORE)) && !g.Inspected) {
				g.EncounterType = POLICEINSPECTION
				g.Inspected = true
			} else if (g.PoliceRecordScore < LAWFULSCORE) {
				if (((i32(SysRandom(0)) % (12 - i32(g.Difficulty))) < 1) && !g.Inspected) {
					g.EncounterType = POLICEINSPECTION
					g.Inspected = true
				}
			} else {
				if (((i32(SysRandom(0)) % (40)) == 1) && !g.Inspected) {
					g.EncounterType = POLICEINSPECTION
					g.Inspected = true
				}
			}
			if ((g.EncounterType == POLICEFLEE) && (i32(g.Opponent.Type) > i32(g.Ship.Type))) {
				if (g.PoliceRecordScore < DUBIOUSSCORE) {
					g.EncounterType = POLICEATTACK
				} else {
					g.EncounterType = POLICEINSPECTION
				}
			}
			if ((g.EncounterType == POLICEIGNORE) && Cloaked(&g.Opponent, &g.Ship)) {
				g.Clicks -= 1
				continue
			}
			if (g.AlwaysIgnorePolice && ((g.EncounterType == POLICEIGNORE) || (g.EncounterType == POLICEFLEE))) {
				g.Clicks -= 1
				continue
			}
			g.CurForm = EncounterForm
			FrmGotoForm(u16(g.CurForm))
			return
		} else if (Pirate || Mantis) {
			if Mantis {
				GenerateOpponent(u8(MANTIS))
			} else {
				GenerateOpponent(u8(PIRATE))
			}
			if Cloaked(&g.Ship, &g.Opponent) {
				g.EncounterType = PIRATEIGNORE
			} else if ((i32(g.Opponent.Type) >= 7) || ((i32(SysRandom(0)) % (ELITESCORE)) > ((g.ReputationScore * 4) / (1 + i32(g.Opponent.Type))))) {
				g.EncounterType = PIRATEATTACK
			} else {
				g.EncounterType = PIRATEFLEE
			}
			if Mantis {
				g.EncounterType = PIRATEATTACK
			}
			if ((g.EncounterType == PIRATEFLEE) && (i32(g.Opponent.Type) > i32(g.Ship.Type))) {
				g.EncounterType = PIRATEATTACK
			}
			if (((g.EncounterType == PIRATEIGNORE) || (g.EncounterType == PIRATEFLEE)) && Cloaked(&g.Opponent, &g.Ship)) {
				g.Clicks -= 1
				continue
			}
			if (g.AlwaysIgnorePirates && ((g.EncounterType == PIRATEIGNORE) || (g.EncounterType == PIRATEFLEE))) {
				g.Clicks -= 1
				continue
			}
			g.CurForm = EncounterForm
			FrmGotoForm(u16(g.CurForm))
			return
		} else if Trader {
			GenerateOpponent(u8(TRADER))
			g.EncounterType = TRADERIGNORE
			if Cloaked(&g.Ship, &g.Opponent) {
				g.EncounterType = TRADERIGNORE
			} else if (g.PoliceRecordScore <= CRIMINALSCORE) {
				if ((i32(SysRandom(0)) % (ELITESCORE)) <= ((g.ReputationScore * 10) / (1 + i32(g.Opponent.Type)))) {
					if Cloaked(&g.Opponent, &g.Ship) {
						g.EncounterType = TRADERIGNORE
					} else {
						g.EncounterType = TRADERFLEE
					}
				}
			}
			if ((g.EncounterType == TRADERIGNORE) && ((i32(SysRandom(0)) % (1000)) < g.ChanceOfTradeInOrbit)) {
				if ((FilledCargoBays() < TotalCargoBays()) && HasTradeableItems(&g.Opponent, u8(g.WarpSystem), u8(TRADERSELL))) {
					g.EncounterType = TRADERSELL
				}
				if (HasTradeableItems(&g.Ship, u8(g.WarpSystem), u8(TRADERBUY)) && (g.EncounterType != TRADERSELL)) {
					g.EncounterType = TRADERBUY
				}
			}
			if (((((g.EncounterType == TRADERIGNORE) || (g.EncounterType == TRADERFLEE)) || (g.EncounterType == TRADERSELL)) || (g.EncounterType == TRADERBUY)) && Cloaked(&g.Opponent, &g.Ship)) {
				g.Clicks -= 1
				continue
			}
			if (g.AlwaysIgnoreTraders && ((g.EncounterType == TRADERIGNORE) || (g.EncounterType == TRADERFLEE))) {
				g.Clicks -= 1
				continue
			}
			if (g.AlwaysIgnoreTradeInOrbit && ((g.EncounterType == TRADERBUY) || (g.EncounterType == TRADERSELL))) {
				g.Clicks -= 1
				continue
			}
			g.CurForm = EncounterForm
			FrmGotoForm(u16(g.CurForm))
			return
		} else if ((g.Days > 10) && ((i32(SysRandom(0)) % (1000)) < g.ChanceOfVeryRareEncounter)) {
			rareEncounter = (i32(SysRandom(0)) % (MAXVERYRAREENCOUNTER))
			switch rareEncounter {
			case MARIECELESTE:
				if !((i32(g.VeryRareEncounter) & i32(u8(ALREADYMARIE))) != 0) {
					g.VeryRareEncounter = u8(i32(g.VeryRareEncounter) + ALREADYMARIE)
					g.EncounterType = MARIECELESTEENCOUNTER
					GenerateOpponent(u8(TRADER))
					for i = 0; (i < MAXTRADEITEM); i += 1 {
						g.Opponent.Cargo[i] = 0
					}
					g.Opponent.Cargo[NARCOTICS] = ((i32((Shiptype[g.Opponent.Type].CargoBays)) <= (5)) ? i32((Shiptype[g.Opponent.Type].CargoBays)) : (5))
					g.CurForm = EncounterForm
					FrmGotoForm(u16(g.CurForm))
					return
				}
			case CAPTAINAHAB:
				if (((HaveReflectiveShield && (i32(g.Mercenary[0].Pilot) < 10)) && (g.PoliceRecordScore > CRIMINALSCORE)) && !((i32(g.VeryRareEncounter) & i32(u8(ALREADYAHAB))) != 0)) {
					g.VeryRareEncounter = u8(i32(g.VeryRareEncounter) + ALREADYAHAB)
					g.EncounterType = CAPTAINAHABENCOUNTER
					GenerateOpponent(u8(FAMOUSCAPTAIN))
					g.CurForm = EncounterForm
					FrmGotoForm(u16(g.CurForm))
					return
				}
			case CAPTAINCONRAD:
				if (((HaveMilitaryLaser && (i32(g.Mercenary[0].Engineer) < 10)) && (g.PoliceRecordScore > CRIMINALSCORE)) && !((i32(g.VeryRareEncounter) & i32(u8(ALREADYCONRAD))) != 0)) {
					g.VeryRareEncounter = u8(i32(g.VeryRareEncounter) + ALREADYCONRAD)
					g.EncounterType = CAPTAINCONRADENCOUNTER
					GenerateOpponent(u8(FAMOUSCAPTAIN))
					g.CurForm = EncounterForm
					FrmGotoForm(u16(g.CurForm))
					return
				}
			case CAPTAINHUIE:
				if (((HaveMilitaryLaser && (i32(g.Mercenary[0].Trader) < 10)) && (g.PoliceRecordScore > CRIMINALSCORE)) && !((i32(g.VeryRareEncounter) & i32(u8(ALREADYHUIE))) != 0)) {
					g.VeryRareEncounter = u8((i32(g.VeryRareEncounter) | ALREADYHUIE))
					g.EncounterType = CAPTAINHUIEENCOUNTER
					GenerateOpponent(u8(FAMOUSCAPTAIN))
					g.CurForm = EncounterForm
					FrmGotoForm(u16(g.CurForm))
					return
				}
			case BOTTLEOLD:
				if !((i32(g.VeryRareEncounter) & i32(u8(ALREADYBOTTLEOLD))) != 0) {
					g.VeryRareEncounter = u8((i32(g.VeryRareEncounter) | ALREADYBOTTLEOLD))
					g.EncounterType = BOTTLEOLDENCOUNTER
					GenerateOpponent(u8(TRADER))
					g.Opponent.Type = u8((MAXSHIPTYPE + 4))
					g.Opponent.Hull = 10
					g.CurForm = EncounterForm
					FrmGotoForm(u16(g.CurForm))
					return
				}
			case BOTTLEGOOD:
				if !((i32(g.VeryRareEncounter) & i32(u8(ALREADYBOTTLEGOOD))) != 0) {
					g.VeryRareEncounter = u8((i32(g.VeryRareEncounter) | ALREADYBOTTLEGOOD))
					g.EncounterType = BOTTLEGOODENCOUNTER
					GenerateOpponent(u8(TRADER))
					g.Opponent.Type = u8((MAXSHIPTYPE + 4))
					g.Opponent.Hull = 10
					g.CurForm = EncounterForm
					FrmGotoForm(u16(g.CurForm))
					return
				}
			}
		}
		g.Clicks -= 1
	}
	if g.JustLootedMarie {
		GenerateOpponent(u8(POLICE))
		g.EncounterType = POSTMARIEPOLICEENCOUNTER
		g.JustLootedMarie = false
		g.Clicks += 1
		g.CurForm = EncounterForm
		FrmGotoForm(u16(g.CurForm))
		return
	}
	FrmAlert(u16(((StartClicks > 20) ? UneventfulTripAlert : ArrivalAlert)))
	if (g.Debt >= 75000) {
		FrmAlert(u16(DebtWarningAlert))
	}
	if (((g.Debt > 0) && g.RemindLoans) && ((g.Days % 5) == 0)) {
		StrIToA(cstring(&g.SBuf2[0]), g.Debt)
		FrmCustomAlert(u16(LoanAmountAlert), cstring(&g.SBuf2[0]), " ", " ")
	}
	Arrival()
	if (i32(g.ReactorStatus) == 2) {
		FrmAlert(u16(ReactorConsumeAlert))
	} else if (i32(g.ReactorStatus) == 16) {
		FrmAlert(u16(ReactorNoiseAlert))
	} else if (i32(g.ReactorStatus) == 18) {
		FrmAlert(u16(ReactorSmokeAlert))
	}
	if (i32(g.ReactorStatus) == 20) {
		FrmAlert(u16(ReactorMeltdownAlert))
		g.ReactorStatus = u8(0)
		if g.EscapePod {
			EscapeWithPod()
			return
		} else {
			FrmAlert(u16(ShipDestroyedAlert))
			g.CurForm = DestroyedForm
			FrmGotoForm(u16(g.CurForm))
			return
		}
	}
	if (g.TrackAutoOff && (g.TrackedSystem == i32(g.Mercenary[0].CurSystem))) {
		g.TrackedSystem = -1
	}
	FoodOnBoard = false
	previousTribbles = g.Ship.Tribbles
	if (((g.Ship.Tribbles > 0) && (i32(g.ReactorStatus) > 0)) && (i32(g.ReactorStatus) < 21)) {
		g.Ship.Tribbles /= 2
		if (g.Ship.Tribbles < 10) {
			g.Ship.Tribbles = 0
			FrmAlert(u16(TribblesAllIrradiatedAlert))
		} else {
			FrmAlert(u16(TribblesIrradiatedAlert))
		}
	} else if ((g.Ship.Tribbles > 0) && (g.Ship.Cargo[NARCOTICS] > 0)) {
		g.Ship.Tribbles = (1 + (i32(SysRandom(0)) % (3)))
		j = (1 + (i32(SysRandom(0)) % (3)))
		i = (((j) <= (g.Ship.Cargo[NARCOTICS])) ? (j) : (g.Ship.Cargo[NARCOTICS]))
		g.BuyingPrice[NARCOTICS] = ((g.BuyingPrice[NARCOTICS] * (g.Ship.Cargo[NARCOTICS] - i)) / g.Ship.Cargo[NARCOTICS])
		g.Ship.Cargo[NARCOTICS] -= i
		g.Ship.Cargo[FURS] += i
		FrmAlert(u16(TribblesAteNarcoticsAlert))
	} else if ((g.Ship.Tribbles > 0) && (g.Ship.Cargo[FOOD] > 0)) {
		g.Ship.Tribbles += (100 + (i32(SysRandom(0)) % (g.Ship.Cargo[FOOD] * 100)))
		i = (i32(SysRandom(0)) % (g.Ship.Cargo[FOOD]))
		g.BuyingPrice[FOOD] = ((g.BuyingPrice[FOOD] * i) / g.Ship.Cargo[FOOD])
		g.Ship.Cargo[FOOD] = i
		FrmAlert(u16(TribblesAteFoodAlert))
		FoodOnBoard = true
	}
	if ((g.Ship.Tribbles > 0) && (g.Ship.Tribbles < MAXTRIBBLES)) {
		g.Ship.Tribbles += (1 + (i32(SysRandom(0)) % (((1) >= (g.Ship.Tribbles >> uint((FoodOnBoard ? 0 : 1)))) ? (1) : (g.Ship.Tribbles >> uint((FoodOnBoard ? 0 : 1))))))
	}
	if (g.Ship.Tribbles > MAXTRIBBLES) {
		g.Ship.Tribbles = MAXTRIBBLES
	}
	if (((((previousTribbles < 100) && (g.Ship.Tribbles >= 100)) || ((previousTribbles < 1000) && (g.Ship.Tribbles >= 1000))) || ((previousTribbles < 10000) && (g.Ship.Tribbles >= 10000))) || ((previousTribbles < 50000) && (g.Ship.Tribbles >= 50000))) {
		if (g.Ship.Tribbles >= MAXTRIBBLES) {
			StrCopy(cstring(&g.SBuf[0]), "a dangerous number of")
		} else {
			StrPrintF(cstring(&g.SBuf[0]), "%ld", g.Ship.Tribbles)
		}
		FrmCustomAlert(u16(TribblesOnBoardAlert), cstring(&g.SBuf[0]), nil, nil)
	}
	g.TribbleMessage = false
	g.Ship.Hull += (i32(SysRandom(0)) % i32((EngineerSkill(&g.Ship))))
	if (g.Ship.Hull > GetHullStrength()) {
		g.Ship.Hull = GetHullStrength()
	}
	TryAutoRepair = true
	if g.AutoFuel {
		BuyFuel(999)
		if (i32(GetFuel()) < i32(GetFuelTanks())) {
			if (g.AutoRepair && (g.Ship.Hull < GetHullStrength())) {
				FrmAlert(u16(NoFullTanksOrRepairsAlert))
				TryAutoRepair = false
			} else {
				FrmAlert(u16(NoFullTanksAlert))
			}
		}
	}
	if (g.AutoRepair && TryAutoRepair) {
		BuyRepairs(9999)
		if (g.Ship.Hull < GetHullStrength()) {
			FrmAlert(u16(NoFullRepairsAlert))
		}
	}
	if (i32(g.Mercenary[0].CurSystem) == OGSYSTEM) {
		i = 0
		EasterEgg = false
		for (i < MAXTRADEITEM) {
			if (g.Ship.Cargo[i] != 1) {
				break
			}
			i += 1
		}
		if (i >= MAXTRADEITEM) {
			FrmAlert(u16(EggAlert))
			FirstEmptySlot = GetFirstEmptySlot(Shiptype[g.Ship.Type].ShieldSlots, ([^]i32)(&g.Ship.Shield[0]))
			if (FirstEmptySlot >= 0) {
				g.Ship.Shield[FirstEmptySlot] = LIGHTNINGSHIELD
				g.Ship.ShieldStrength[FirstEmptySlot] = Shieldtype[LIGHTNINGSHIELD].Power
				EasterEgg = true
			}
			if EasterEgg {
				for i = 0; (i < MAXTRADEITEM); i += 1 {
					g.Ship.Cargo[i] = 0
					g.BuyingPrice[i] = 0
				}
			}
		}
	}
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		if (g.Ship.Cargo[i] < 0) {
			g.Ship.Cargo[i] = 0
		}
	}
	g.CurForm = SystemInformationForm
	FrmGotoForm(u16(g.CurForm))
}

WormholeExists :: proc(a: i32, b: i32) -> bool {
	i: i32
	i = 0
	for (i < MAXWORMHOLE) {
		if (i32(g.Wormhole[i]) == a) {
			break
		}
		i += 1
	}
	if (i < MAXWORMHOLE) {
		if (b < 0) {
			return true
		} else if (i < (MAXWORMHOLE - 1)) {
			if (i32(g.Wormhole[(i + 1)]) == b) {
				return true
			}
		} else if (i32(g.Wormhole[0]) == b) {
			return true
		}
	}
	return false
}

Arrival :: proc() {
	g.Mercenary[0].CurSystem = u8(g.WarpSystem)
	ShuffleStatus()
	ChangeQuantities()
	DeterminePrices(g.Mercenary[0].CurSystem)
	g.AlreadyPaidForNewspaper = false
}

RetireDestroyedUtopiaFormHandleEvent :: proc(eventP: ^EventType, EndStatus: u8) -> bool {
	handled: bool = false
	frmP: ^FormType = FrmGetActiveForm()
	switch u32(eventP.eType) {
	case u32(frmOpenEvent):
		FrmDrawForm(frmP)
		handled = true
	case u32(penDownEvent), u32(keyDownEvent):
		EraseRectangle(0, 0, 160, 160)
		EndOfGame(EndStatus)
		handled = true
	case:
	}
	return handled
}

UtopiaFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	return RetireDestroyedUtopiaFormHandleEvent(eventP, u8(MOON))
}

DestroyedFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	return RetireDestroyedUtopiaFormHandleEvent(eventP, u8(KILLED))
}

RetireFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	return RetireDestroyedUtopiaFormHandleEvent(eventP, u8(RETIRED))
}

Cloaked :: proc(Sh: ^SHIP, Opp: ^SHIP) -> bool {
	return (HasGadget(Sh, u8(CLOAKINGDEVICE)) && (i32(EngineerSkill(Sh)) > i32(EngineerSkill(Opp))))
}

GetFirstEmptySlot :: proc(Slots: u8, Item: [^]i32) -> i32 {
	FirstEmptySlot: i32
	j: i32
	FirstEmptySlot = -1
	for j = 0; (j < i32(Slots)); j += 1 {
		if (Item[j] < 0) {
			FirstEmptySlot = j
			break
		}
	}
	return FirstEmptySlot
}

AnyEmptySlots :: proc(ship: ^SHIP) -> bool {
	j: i32
	for j = 0; (j < i32(Shiptype[ship.Type].WeaponSlots)); j += 1 {
		if (ship.Weapon[j] < 0) {
			return true
		}
	}
	for j = 0; (j < i32(Shiptype[ship.Type].ShieldSlots)); j += 1 {
		if (ship.Shield[j] < 0) {
			return true
		}
	}
	for j = 0; (j < i32(Shiptype[ship.Type].GadgetSlots)); j += 1 {
		if (ship.Gadget[j] < 0) {
			return true
		}
	}
	return false
}

NewCommanderFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	CommanderNameLen: i32
	handled: bool = false
	frmP: ^FormType = FrmGetActiveForm()
	switch u32(eventP.eType) {
	case u32(ctlSelectEvent):
		if (i32(eventP.data.ctlSelect.controlID) == NewCommanderOKButton) {
			if ((((((2 * MAXSKILL) - i32(g.Mercenary[0].Pilot)) - i32(g.Mercenary[0].Fighter)) - i32(g.Mercenary[0].Trader)) - i32(g.Mercenary[0].Engineer)) > 0) {
				FrmAlert(u16(MoreSkillPointsAlert))
				handled = true
				break
			}
			GetField(frmP, NewCommanderEditNameField, cstring(&g.NameCommander[0]), g.NameH)
			DeterminePrices(g.Mercenary[0].CurSystem)
			if (i32(g.Difficulty) < NORMAL) {
				if (g.SolarSystem[g.Mercenary[0].CurSystem].Special < 0) {
					g.SolarSystem[g.Mercenary[0].CurSystem].Special = LOTTERYWINNER
				}
			}
			g.CurForm = SystemInformationForm
			FrmGotoForm(u16(g.CurForm))
			handled = true
			break
		}
		switch i32(eventP.data.ctlSelect.controlID) {
		case NewCommanderDecDifficultyButton:
			if (i32(g.Difficulty) > 0) {
				g.Difficulty -= 1
			}
		case NewCommanderIncDifficultyButton:
			if (i32(g.Difficulty) < (MAXDIFFICULTY - 1)) {
				g.Difficulty += 1
			}
		case NewCommanderDecPilotButton:
			if (i32(g.Mercenary[0].Pilot) > 1) {
				g.Mercenary[0].Pilot -= 1
			}
		case NewCommanderIncPilotButton:
			if (i32(g.Mercenary[0].Pilot) < MAXSKILL) {
				if ((((((2 * MAXSKILL) - i32(g.Mercenary[0].Pilot)) - i32(g.Mercenary[0].Fighter)) - i32(g.Mercenary[0].Trader)) - i32(g.Mercenary[0].Engineer)) > 0) {
					g.Mercenary[0].Pilot += 1
				}
			}
		case NewCommanderDecFighterButton:
			if (i32(g.Mercenary[0].Fighter) > 1) {
				g.Mercenary[0].Fighter -= 1
			}
		case NewCommanderIncFighterButton:
			if (i32(g.Mercenary[0].Fighter) < MAXSKILL) {
				if ((((((2 * MAXSKILL) - i32(g.Mercenary[0].Pilot)) - i32(g.Mercenary[0].Fighter)) - i32(g.Mercenary[0].Trader)) - i32(g.Mercenary[0].Engineer)) > 0) {
					g.Mercenary[0].Fighter += 1
				}
			}
		case NewCommanderDecTraderButton:
			if (i32(g.Mercenary[0].Trader) > 1) {
				g.Mercenary[0].Trader -= 1
			}
		case NewCommanderIncTraderButton:
			if (i32(g.Mercenary[0].Trader) < MAXSKILL) {
				if ((((((2 * MAXSKILL) - i32(g.Mercenary[0].Pilot)) - i32(g.Mercenary[0].Fighter)) - i32(g.Mercenary[0].Trader)) - i32(g.Mercenary[0].Engineer)) > 0) {
					g.Mercenary[0].Trader += 1
				}
			}
		case NewCommanderDecEngineerButton:
			if (i32(g.Mercenary[0].Engineer) > 1) {
				g.Mercenary[0].Engineer -= 1
			}
		case NewCommanderIncEngineerButton:
			if (i32(g.Mercenary[0].Engineer) < MAXSKILL) {
				if ((((((2 * MAXSKILL) - i32(g.Mercenary[0].Pilot)) - i32(g.Mercenary[0].Fighter)) - i32(g.Mercenary[0].Trader)) - i32(g.Mercenary[0].Engineer)) > 0) {
					g.Mercenary[0].Engineer += 1
				}
			}
		}
		NewCommanderDrawSkills()
		handled = true
	case u32(frmOpenEvent):
		CommanderNameLen = (NAMELEN + 1)
		g.NameH = SetField(frmP, NewCommanderEditNameField, cstring(&g.NameCommander[0]), CommanderNameLen, true)
		GrfSetState(false, false, false)
		FrmDrawForm(frmP)
		NewCommanderDrawSkills()
		handled = true
	case u32(frmUpdateEvent):
		FrmDrawForm(frmP)
		NewCommanderDrawSkills()
		handled = true
	case:
	}
	return handled
}

AveragePricesFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	i: i32
	d: i32
	Amount: i32
	handled: bool = false
	switch u32(eventP.eType) {
	case u32(penDownEvent):
		for i = 0; (i < MAXTRADEITEM); i += 1 {
			if ((((i32(eventP.screenX) >= ((i / 5) * 72)) && (i32(eventP.screenX) < ((i < 5) ? 72 : 160))) && (i32(eventP.screenY) >= (46 + ((i % 5) * 13)))) && (i32(eventP.screenY) < (46 + ((1 + (i % 5)) * 13)))) {
				Amount = GetAmountToBuy(i)
				if (Amount > 0) {
					BuyCargo(i, Amount, false)
					ShowAveragePrices()
				}
				handled = true
			}
		}
	case u32(keyDownEvent):
		d = ScrollButton(eventP)
		if ((d == chrPageUp) || (d == chrPageDown)) {
			i = NextSystemWithinRange(g.WarpSystem, (d == chrPageDown))
			if (i >= 0) {
				g.WarpSystem = i
				ShowAveragePrices()
			}
			handled = true
		}
	case u32(ctlSelectEvent):
		switch i32(eventP.data.ctlSelect.controlID) {
		case AveragePricesScrollBackButton, AveragePricesScrollFwdButton:
			{
				i = NextSystemWithinRange(g.WarpSystem, (i32(eventP.data.ctlSelect.controlID) == AveragePricesScrollBackButton))
				if (i >= 0) {
					g.WarpSystem = i
					ShowAveragePrices()
				}
				break
			}
			fallthrough
		case AveragePricesWarpButton:
			{
				DoWarp(false)
				break
			}
			fallthrough
		case AveragePricesSystemInfoButton:
			{
				g.CurForm = ExecuteWarpForm
				FrmGotoForm(u16(g.CurForm))
				break
			}
			fallthrough
		case AveragePricesPriceDifferencesButton, AveragePricesAbsolutePricesButton:
			{
				g.PriceDifferences = !g.PriceDifferences
				ShowAveragePrices()
				break
			}
			fallthrough
		case:
			{
				g.CurForm = WarpForm
				FrmGotoForm(u16(g.CurForm))
				break
			}
		}
		handled = true
	case u32(frmOpenEvent):
		ShowAveragePrices()
		g.APLscreen = true
		handled = true
	case u32(frmUpdateEvent):
		ShowAveragePrices()
		handled = true
	case:
	}
	return handled
}

ExecuteWarpFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	frmP: ^FormType
	i: i32
	d: i32
	IncDebt: i32
	Total: i32
	switch u32(eventP.eType) {
	case u32(keyDownEvent):
		d = ScrollButton(eventP)
		if ((d == chrPageUp) || (d == chrPageDown)) {
			i = NextSystemWithinRange(g.WarpSystem, (d == chrPageDown))
			if (i >= 0) {
				g.WarpSystem = i
				ShowExecuteWarp()
			}
			handled = true
		}
	case u32(ctlSelectEvent):
		switch i32(eventP.data.ctlSelect.controlID) {
		case ExecuteWarpScrollBackButton, ExecuteWarpScrollFwdButton:
			{
				i = NextSystemWithinRange(g.WarpSystem, (i32(eventP.data.ctlSelect.controlID) == ExecuteWarpScrollBackButton))
				if (i >= 0) {
					g.WarpSystem = i
					ShowExecuteWarp()
				}
				break
			}
			fallthrough
		case ExecuteWarpWarpButton:
			{
				DoWarp(false)
				break
			}
			fallthrough
		case ExecuteWarpPricesButton:
			{
				g.CurForm = AveragePricesForm
				FrmGotoForm(u16(g.CurForm))
				break
			}
			fallthrough
		case ExecuteWarpSpecificationButton:
			{
				frmP = FrmInitForm(u16(SpecificationForm))
				Total = 0
				StrIToA(cstring(&g.SBuf[0]), MercenaryMoney())
				StrCat(cstring(&g.SBuf[0]), " cr.")
				setLabelText(frmP, SpecificationMercenariesLabel, cstring(&g.SBuf[0]))
				Total += MercenaryMoney()
				StrIToA(cstring(&g.SBuf[0]), InsuranceMoney())
				Total += InsuranceMoney()
				StrCat(cstring(&g.SBuf[0]), " cr.")
				setLabelText(frmP, SpecificationInsuranceLabel, cstring(&g.SBuf[0]))
				StrIToA(cstring(&g.SBuf[0]), WormholeTax(i32(g.Mercenary[0].CurSystem), g.WarpSystem))
				StrCat(cstring(&g.SBuf[0]), " cr.")
				setLabelText(frmP, SpecificationWormholeTaxLabel, cstring(&g.SBuf[0]))
				Total += WormholeTax(i32(g.Mercenary[0].CurSystem), g.WarpSystem)
				if (g.Debt > 0) {
					IncDebt = (((1) >= (g.Debt / 10)) ? (1) : (g.Debt / 10))
					StrIToA(cstring(&g.SBuf[0]), IncDebt)
					Total += IncDebt
				} else {
					StrCopy(cstring(&g.SBuf[0]), "0")
				}
				StrCat(cstring(&g.SBuf[0]), " cr.")
				setLabelText(frmP, SpecificationInterestLabel, cstring(&g.SBuf[0]))
				StrIToA(cstring(&g.SBuf[0]), Total)
				StrCat(cstring(&g.SBuf[0]), " cr.")
				setLabelText(frmP, SpecificationTotalLabel, cstring(&g.SBuf[0]))
				FrmDoDialog(frmP)
				FrmDeleteForm(frmP)
				break
			}
			fallthrough
		case:
			{
				g.CurForm = WarpForm
				FrmGotoForm(u16(g.CurForm))
				break
			}
		}
		handled = true
	case u32(frmOpenEvent):
		ShowExecuteWarp()
		g.APLscreen = false
		handled = true
	case u32(frmUpdateEvent):
		ShowExecuteWarp()
		handled = true
	case:
	}
	return handled
}

