package game

DrawItem :: proc(Name: cstring, y: i32, Price: i32) {
	j: i32
	FntSetFont(stdFont)
	DrawChars(Name, 30, y)
	EraseRectangle(110, y, 56, 9)
	StrIToA(cstring(&g.SBuf[0]), Price)
	StrCat(cstring(&g.SBuf[0]), " cr.")
	j = (MAXDIGITS - i32(StrLen(cstring(&g.SBuf[0]))))
	if (Price > 0) {
		DrawChars(cstring(&g.SBuf[0]), (124 + (j * 5)), y)
	} else {
		DrawChars("not sold", 122, y)
	}
}

DrawBuyEquipmentForm :: proc() {
	frmP: ^FormType = FrmGetActiveForm()
	i: i32
	RectangularShortcuts(frmP, BuyEquipmentBButton)
	for i = 0; (i < ((MAXWEAPONTYPE + MAXSHIELDTYPE) + MAXGADGETTYPE)); i += 1 {
		RectangularButton(frmP, (BuyEquipmentBuy0Button + i))
		if (i < MAXWEAPONTYPE) {
			if ((BasePrice(Weapontype[i].TechLevel, Weapontype[i].Price)) <= 0) {
				FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((BuyEquipmentBuy0Button + i))))
			} else {
				FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((BuyEquipmentBuy0Button + i))))
			}
		} else if (i < (MAXWEAPONTYPE + MAXSHIELDTYPE)) {
			if ((BasePrice(Shieldtype[(i - MAXWEAPONTYPE)].TechLevel, Shieldtype[(i - MAXWEAPONTYPE)].Price)) <= 0) {
				FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((BuyEquipmentBuy0Button + i))))
			} else {
				FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((BuyEquipmentBuy0Button + i))))
			}
		} else {
			if ((BasePrice(Gadgettype[((i - MAXWEAPONTYPE) - MAXSHIELDTYPE)].TechLevel, Gadgettype[((i - MAXWEAPONTYPE) - MAXSHIELDTYPE)].Price)) <= 0) {
				FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((BuyEquipmentBuy0Button + i))))
			} else {
				FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((BuyEquipmentBuy0Button + i))))
			}
		}
	}
	FrmDrawForm(frmP)
	for i = 0; (i < MAXWEAPONTYPE); i += 1 {
		DrawItem(Weapontype[i].Name, (17 + (i * 13)), (BasePrice(Weapontype[i].TechLevel, Weapontype[i].Price)))
	}
	for i = 0; (i < MAXSHIELDTYPE); i += 1 {
		DrawItem(Shieldtype[i].Name, (17 + ((i + MAXWEAPONTYPE) * 13)), (BasePrice(Shieldtype[i].TechLevel, Shieldtype[i].Price)))
	}
	for i = 0; (i < MAXGADGETTYPE); i += 1 {
		DrawItem(Gadgettype[i].Name, (17 + (((i + MAXWEAPONTYPE) + MAXSHIELDTYPE) * 13)), (BasePrice(Gadgettype[i].TechLevel, Gadgettype[i].Price)))
	}
	DisplayTradeCredits()
}

BuyEquipmentFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	switch u32(eventP.eType) {
	case u32(frmOpenEvent), u32(frmUpdateEvent):
		DrawBuyEquipmentForm()
		handled = true
	case u32(ctlSelectEvent):
		if ((i32(eventP.data.ctlSelect.controlID) >= BuyEquipmentBuy0Button) && (i32(eventP.data.ctlSelect.controlID) < (BuyEquipmentBuy0Button + MAXWEAPONTYPE))) {
			BuyItem(Shiptype[g.Ship.Type].WeaponSlots, ([^]i32)(&g.Ship.Weapon[0]), (BasePrice(Weapontype[(i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button)].TechLevel, Weapontype[(i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button)].Price)), Weapontype[(i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button)].Name, (i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button))
		}
		if ((i32(eventP.data.ctlSelect.controlID) >= (BuyEquipmentBuy0Button + MAXWEAPONTYPE)) && (i32(eventP.data.ctlSelect.controlID) < ((BuyEquipmentBuy0Button + MAXWEAPONTYPE) + MAXSHIELDTYPE))) {
			BuyItem(Shiptype[g.Ship.Type].ShieldSlots, ([^]i32)(&g.Ship.Shield[0]), (BasePrice(Shieldtype[((i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button) - MAXWEAPONTYPE)].TechLevel, Shieldtype[((i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button) - MAXWEAPONTYPE)].Price)), Shieldtype[((i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button) - MAXWEAPONTYPE)].Name, ((i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button) - MAXWEAPONTYPE))
		}
		if ((i32(eventP.data.ctlSelect.controlID) >= ((BuyEquipmentBuy0Button + MAXWEAPONTYPE) + MAXSHIELDTYPE)) && (i32(eventP.data.ctlSelect.controlID) < (((BuyEquipmentBuy0Button + MAXWEAPONTYPE) + MAXSHIELDTYPE) + MAXGADGETTYPE))) {
			if (HasGadget(&g.Ship, u8((((i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button) - MAXWEAPONTYPE) - MAXSHIELDTYPE))) && (EXTRABAYS != (((i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button) - MAXWEAPONTYPE) - MAXSHIELDTYPE))) {
				FrmAlert(u16(NoMoreOfItemAlert))
			} else {
				BuyItem(Shiptype[g.Ship.Type].GadgetSlots, ([^]i32)(&g.Ship.Gadget[0]), (BasePrice(Gadgettype[(((i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button) - MAXWEAPONTYPE) - MAXSHIELDTYPE)].TechLevel, Gadgettype[(((i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button) - MAXWEAPONTYPE) - MAXSHIELDTYPE)].Price)), Gadgettype[(((i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button) - MAXWEAPONTYPE) - MAXSHIELDTYPE)].Name, (((i32(eventP.data.ctlSelect.controlID) - BuyEquipmentBuy0Button) - MAXWEAPONTYPE) - MAXSHIELDTYPE))
			}
		}
		handled = true
	case:
	}
	return handled
}

