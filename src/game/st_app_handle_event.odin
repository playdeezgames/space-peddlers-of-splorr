				SetCheckBox(frm, OptionsContinuousCheckbox, g.Continuous)
				SetCheckBox(frm, OptionsAttackFleeingCheckbox, g.AttackFleeing)
				StrIToA(cstring(&g.SBuf[0]), (((99) <= (g.LeaveEmpty)) ? (99) : (g.LeaveEmpty)))
				AmountH = SetField(frm, OptionsLeaveEmptyField, cstring(&g.SBuf[0]), 4, true)
				buttonPressed = FrmDoDialog(frm)
