		if (((((((((((((((((((((i32(eventP.data.keyDown.chr) == hard1Chr) || (i32(eventP.data.keyDown.chr) == hard2Chr)) || (i32(eventP.data.keyDown.chr) == hard3Chr)) || (i32(eventP.data.keyDown.chr) == hard4Chr)) && (g.CurForm != EncounterForm)) && (g.CurForm != SystemInformationForm)) && (g.CurForm != WarpForm)) && (g.CurForm != GalacticChartForm)) && (g.CurForm != ExecuteWarpForm)) && (g.CurForm != BuyCargoForm)) && (g.CurForm != SellCargoForm)) && (g.CurForm != ShipYardForm)) && (g.CurForm != BuyShipForm)) && (g.CurForm != BuyEquipmentForm)) && (g.CurForm != SellEquipmentForm)) && (g.CurForm != PersonnelRosterForm)) && (g.CurForm != CommanderStatusForm)) && (g.CurForm != BankForm)) && (g.CurForm != CurrentShipForm)) && (g.CurForm != QuestsForm)) && (g.CurForm != SpecialCargoForm)) {
