DrawMercenary :: proc(Index: i32, y: i32) {
	j: i32
	d: i32
	DrawChars(g.MercenaryName[g.Mercenary[Index].NameIndex], 30, y)
	StrIToA(cstring(&g.SBuf[0]), (((Index < 0) || ((Index >= MAXCREWMEMBER) && (i32(g.WildStatus) == 2))) ? 0 : ((((i32(g.Mercenary[Index].Pilot) + i32(g.Mercenary[Index].Fighter)) + i32(g.Mercenary[Index].Trader)) + i32(g.Mercenary[Index].Engineer)) * 3)))
	StrCat(cstring(&g.SBuf[0]), " cr.")
	j = (MAXDIGITS - i32(StrLen(cstring(&g.SBuf[0]))))
	d = (101 + (j * 5))
	StrCat(cstring(&g.SBuf[0]), " daily")
	DrawChars(cstring(&g.SBuf[0]), d, y)
	StrCopy(cstring(&g.SBuf[0]), "Pilot: ")
	StrIToA(cstring(&g.SBuf2[0]), i32(g.Mercenary[Index].Pilot))
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	DrawChars(cstring(&g.SBuf[0]), 30, (y + 13))
	StrCopy(cstring(&g.SBuf[0]), "Trader: ")
	StrIToA(cstring(&g.SBuf2[0]), i32(g.Mercenary[Index].Trader))
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	DrawChars(cstring(&g.SBuf[0]), 30, (y + 26))
	StrCopy(cstring(&g.SBuf[0]), "Fighter: ")
	StrIToA(cstring(&g.SBuf2[0]), i32(g.Mercenary[Index].Fighter))
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	DrawChars(cstring(&g.SBuf[0]), 80, (y + 13))
	StrCopy(cstring(&g.SBuf[0]), "Engineer: ")
	StrIToA(cstring(&g.SBuf2[0]), i32(g.Mercenary[Index].Engineer))
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	DrawChars(cstring(&g.SBuf[0]), 80, (y + 26))
}

AvailableQuarters :: proc() -> u8 {
	return u8(((i32(Shiptype[g.Ship.Type].CrewQuarters) - ((i32(g.JarekStatus) == 1) ? 1 : 0)) - ((i32(g.WildStatus) == 1) ? 1 : 0)))
}

GetForHire :: proc() -> i32 {
	ForHire: i32 = -1
	i: i32
	for i = 1; (i < MAXCREWMEMBER); i += 1 {
		if ((i == g.Ship.Crew[1]) || (i == g.Ship.Crew[2])) {
			continue
		}
		if (i32(g.Mercenary[i].CurSystem) == i32(g.Mercenary[0].CurSystem)) {
			ForHire = i
			break
		}
	}
	return ForHire
}

DrawPersonnelRoster :: proc() {
	frmP: ^FormType
	a: RectangleType
	i: i32
	ForHire: i32
	frmP = FrmGetActiveForm()
	RectangularShortcuts(frmP, PersonnelRosterBButton)
	for i = 0; (i < 3); i += 1 {
		RectangularButton(frmP, (PersonnelRosterFire0Button + i))
	}
	FrmDrawForm(frmP)
	EraseRectangle(30, 18, 130, 142)
	a.topLeft.x = i16(0)
	a.topLeft.y = i16((BOUNDSY + 38))
	a.extent.x = i16(160)
	a.extent.y = i16(2)
	WinDrawRectangle(&a, u16(0))
	a.topLeft.y = i16((BOUNDSY + 83))
	WinDrawRectangle(&a, u16(0))
	FntSetFont(stdFont)
	for i = 0; (i < 2); i += 1 {
		if ((i == (i32(Shiptype[g.Ship.Type].CrewQuarters) - 2)) && ((i32(g.JarekStatus) == 1) || (i32(g.WildStatus) == 1))) {
			if (i32(g.JarekStatus) == 1) {
				DrawChars("Jarek's quarters", 30, (30 + (i * 45)))
			} else {
				DrawChars("Wild's quarters", 30, (30 + (i * 45)))
			}
			FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((PersonnelRosterFire0Button + i))))
			continue
		}
		if (i32(Shiptype[g.Ship.Type].CrewQuarters) <= (i + 1)) {
			DrawChars("No quarters available", 30, (30 + (i * 45)))
			FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((PersonnelRosterFire0Button + i))))
			continue
		}
		if (g.Ship.Crew[(i + 1)] < 0) {
			DrawChars("Vacancy", 30, (30 + (i * 45)))
			FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((PersonnelRosterFire0Button + i))))
			continue
		}
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((PersonnelRosterFire0Button + i))))
		DrawMercenary(g.Ship.Crew[(i + 1)], (17 + (i * 45)))
	}
	ForHire = GetForHire()
	if (ForHire < 0) {
		DrawChars("No one for hire", 30, 120)
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(PersonnelRosterHire0Button)))
	} else {
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(PersonnelRosterHire0Button)))
		DrawMercenary(ForHire, 107)
	}
	DisplayTradeCredits()
}

addNewsEvent :: proc(eventFlag: i32) {
	if (g.NewsSpecialEventCount < (MAXSPECIALNEWSEVENTS - 1)) {
		g.NewsEvents[post_inc(&g.NewsSpecialEventCount)] = eventFlag
	}
}

replaceNewsEvent :: proc(originalEventFlag: i32, replacementEventFlag: i32) {
	i: i32
	if (originalEventFlag == -1) {
		addNewsEvent(replacementEventFlag)
	} else {
		for i = 0; (i < g.NewsSpecialEventCount); i += 1 {
			if (g.NewsEvents[i] == originalEventFlag) {
				g.NewsEvents[i] = replacementEventFlag
			}
		}
	}
}

resetNewsEvents :: proc() {
	g.NewsSpecialEventCount = 0
}

latestNewsEvent :: proc() -> i32 {
	if (g.NewsSpecialEventCount == 0) {
		return -1
	} else {
		return g.NewsEvents[(g.NewsSpecialEventCount - 1)]
	}
	return {}
}

isNewsEvent :: proc(eventFlag: i32) -> bool {
	i: i32
	for i = 0; (i < g.NewsSpecialEventCount); i += 1 {
		if (g.NewsEvents[i] == eventFlag) {
			return true
		}
	}
	return false
}

