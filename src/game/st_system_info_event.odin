SystemInformationFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	OpenQ: i32 = OpenQuests()
	switch u32(eventP.eType) {
	case u32(frmOpenEvent):
		if (g.SolarSystem[g.Mercenary[0].CurSystem].Special > -1) {
			if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == MONSTERKILLED) && (i32(g.MonsterStatus) == 2)) {
				addNewsEvent(MONSTERKILLED)
			} else if (g.SolarSystem[g.Mercenary[0].CurSystem].Special == DRAGONFLY) {
				addNewsEvent(DRAGONFLY)
			} else if (g.SolarSystem[g.Mercenary[0].CurSystem].Special == SCARAB) {
				addNewsEvent(SCARAB)
			} else if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == SCARABDESTROYED) && (i32(g.ScarabStatus) == 2)) {
				addNewsEvent(SCARABDESTROYED)
			} else if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == FLYBARATAS) && (i32(g.DragonflyStatus) == 1)) {
				addNewsEvent(FLYBARATAS)
			} else if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == FLYMELINA) && (i32(g.DragonflyStatus) == 2)) {
				addNewsEvent(FLYMELINA)
			} else if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == FLYREGULAS) && (i32(g.DragonflyStatus) == 3)) {
				addNewsEvent(FLYREGULAS)
			} else if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == DRAGONFLYDESTROYED) && (i32(g.DragonflyStatus) == 5)) {
				addNewsEvent(DRAGONFLYDESTROYED)
			} else if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == MEDICINEDELIVERY) && (i32(g.JaporiDiseaseStatus) == 1)) {
				addNewsEvent(MEDICINEDELIVERY)
			} else if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == ARTIFACTDELIVERY) && g.ArtifactOnBoard) {
				addNewsEvent(ARTIFACTDELIVERY)
			} else if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == JAPORIDISEASE) && (i32(g.JaporiDiseaseStatus) == 0)) {
				addNewsEvent(JAPORIDISEASE)
			} else if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == JAREKGETSOUT) && (i32(g.JarekStatus) == 1)) {
				addNewsEvent(JAREKGETSOUT)
			} else if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == WILDGETSOUT) && (i32(g.WildStatus) == 1)) {
				addNewsEvent(WILDGETSOUT)
			} else if (((g.SolarSystem[g.Mercenary[0].CurSystem].Special == GEMULONRESCUED) && (i32(g.InvasionStatus) > 0)) && (i32(g.InvasionStatus) < 8)) {
				addNewsEvent(GEMULONRESCUED)
			} else if (g.SolarSystem[g.Mercenary[0].CurSystem].Special == ALIENINVASION) {
				addNewsEvent(ALIENINVASION)
			} else if (((g.SolarSystem[g.Mercenary[0].CurSystem].Special == EXPERIMENTSTOPPED) && (i32(g.ExperimentStatus) > 0)) && (i32(g.ExperimentStatus) < 12)) {
				addNewsEvent(EXPERIMENTSTOPPED)
			} else if (g.SolarSystem[g.Mercenary[0].CurSystem].Special == EXPERIMENTNOTSTOPPED) {
				addNewsEvent(EXPERIMENTNOTSTOPPED)
			}
		}
		DrawSystemInformationForm()
		g.SolarSystem[g.Mercenary[0].CurSystem].Visited = true
		handled = true
	case u32(frmUpdateEvent):
		DrawSystemInformationForm()
		handled = true
	case u32(ctlSelectEvent):
		if (i32(eventP.data.ctlSelect.controlID) == SystemInformationSpecialButton) {
			g.CurForm = SpecialEventForm
		} else if (i32(eventP.data.ctlSelect.controlID) == SystemInformationMercenaryForHireButton) {
			g.CurForm = PersonnelRosterForm
		} else if (i32(eventP.data.ctlSelect.controlID) == SystemInformationNewsButton) {
			StrIToA(cstring(&g.SBuf[0]), (i32(g.Difficulty) + 1))
			if (!g.AlreadyPaidForNewspaper && (ToSpend() < i32((f64(i32(g.Difficulty)) + 1.0)))) {
				FrmCustomAlert(u16(CantAffordPaperAlert), cstring(&g.SBuf[0]), nil, nil)
				return true
			} else {
				if (!g.NewsAutoPay && !g.AlreadyPaidForNewspaper) {
					if (i32(FrmCustomAlert(u16(BuyNewspaperAlert), cstring(&g.SBuf[0]), nil, nil)) == BuyNewspaperCancel) {
						return true
					}
				}
				if !g.AlreadyPaidForNewspaper {
					g.Credits -= (i32(g.Difficulty) + 1)
					g.AlreadyPaidForNewspaper = true
				}
				g.CurForm = NewspaperForm
			}
		}
		FrmGotoForm(u16(g.CurForm))
		handled = true
	case:
	}
	return handled
}

DrawNewspaperForm :: proc() {
	frmP: ^FormType
	line: i32 = 18
	i: i32
	j: i32
	shown: [4]bool
	realNews: bool = false
	frmP = FrmGetActiveForm()
	FrmDrawForm(frmP)
	i = (g.WarpSystem % MAXMASTHEADS)
	SysStringByIndex(u16((AnarchyMastheadsStringList + (i32(g.SolarSystem[g.Mercenary[0].CurSystem].Politics) * 100))), u16(i), cstring(&g.SBuf2[0]), u16(50))
	if (i32(StrNCompare(cstring(&g.SBuf2[0]), "*", 1)) == 0) {
		StrCopy(cstring(&g.SBuf[0]), "The ")
		StrCat(cstring(&g.SBuf[0]), SolarSystemName[g.SolarSystem[g.Mercenary[0].CurSystem].NameIndex])
		StrCat(cstring(&g.SBuf[0]), cadd(cstring(&g.SBuf2[0]), 1))
		setCurrentWinTitle(cstring(&g.SBuf[0]))
	} else if (i32(StrNCompare(cstring(&g.SBuf2[0]), "+", 1)) == 0) {
		StrCopy(cstring(&g.SBuf[0]), SolarSystemName[g.SolarSystem[g.Mercenary[0].CurSystem].NameIndex])
		StrCat(cstring(&g.SBuf[0]), cadd(cstring(&g.SBuf2[0]), 1))
		setCurrentWinTitle(cstring(&g.SBuf[0]))
	} else {
		setCurrentWinTitle(cstring(&g.SBuf2[0]))
	}
	RandSeed(u16(g.WarpSystem), u16(g.Days))
	if isNewsEvent(CAPTAINHUIEATTACKED) {
		DisplayHeadline("Famed Captain Huie Attacked by Brigand!", ([^]i32)(&line))
	}
	if isNewsEvent(EXPERIMENTPERFORMED) {
		DisplayHeadline("Travelers Report Timespace Damage, Warp Problems!", ([^]i32)(&line))
	}
	if isNewsEvent(CAPTAINHUIEDESTROYED) {
		DisplayHeadline("Citizens Mourn Destruction of Captain Huie's Ship!", ([^]i32)(&line))
	}
	if isNewsEvent(CAPTAINAHABATTACKED) {
		DisplayHeadline("Thug Assaults Captain Ahab!", ([^]i32)(&line))
	}
	if isNewsEvent(CAPTAINAHABDESTROYED) {
		DisplayHeadline("Destruction of Captain Ahab's Ship Causes Anger!", ([^]i32)(&line))
	}
	if isNewsEvent(CAPTAINCONRADATTACKED) {
		DisplayHeadline("Captain Conrad Comes Under Attack By Criminal!", ([^]i32)(&line))
	}
	if isNewsEvent(CAPTAINCONRADDESTROYED) {
		DisplayHeadline("Captain Conrad's Ship Destroyed by Villain!", ([^]i32)(&line))
	}
	if isNewsEvent(MONSTERKILLED) {
		DisplayHeadline("Hero Slays Space Monster! Parade, Honors Planned for Today.", ([^]i32)(&line))
	}
	if isNewsEvent(WILDARRESTED) {
		DisplayHeadline("Notorious Criminal Jonathan Wild Arrested!", ([^]i32)(&line))
	}
	if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == MONSTERKILLED) && (i32(g.MonsterStatus) == 1)) {
		DisplayHeadline("Space Monster Threatens Homeworld!", ([^]i32)(&line))
	}
	if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == SCARABDESTROYED) && (i32(g.ScarabStatus) == 1)) {
		DisplayHeadline("Wormhole Travelers Harassed by Unusual Ship!", ([^]i32)(&line))
	}
	if isNewsEvent(EXPERIMENTSTOPPED) {
		DisplayHeadline("Scientists Cancel High-profile Test! Committee to Investigate Design.", ([^]i32)(&line))
	}
	if isNewsEvent(EXPERIMENTNOTSTOPPED) {
		DisplayHeadline("Huge Explosion Reported at Research Facility.", ([^]i32)(&line))
	}
	if isNewsEvent(DRAGONFLY) {
		DisplayHeadline("Experimental Craft Stolen! Critics Demand Security Review.", ([^]i32)(&line))
	}
	if isNewsEvent(SCARAB) {
		DisplayHeadline("Security Scandal: Test Craft Confirmed Stolen.", ([^]i32)(&line))
	}
	if isNewsEvent(FLYBARATAS) {
		DisplayHeadline("Investigators Report Strange Craft.", ([^]i32)(&line))
	}
	if isNewsEvent(FLYMELINA) {
		DisplayHeadline("Rumors Continue: Melina Orbitted by Odd Starcraft.", ([^]i32)(&line))
	}
	if isNewsEvent(FLYREGULAS) {
		DisplayHeadline("Strange Ship Observed in Regulas Orbit.", ([^]i32)(&line))
	}
	if (((g.SolarSystem[g.Mercenary[0].CurSystem].Special == DRAGONFLYDESTROYED) && (i32(g.DragonflyStatus) == 4)) && !(isNewsEvent(DRAGONFLYDESTROYED))) {
		DisplayHeadline("Unidentified Ship: A Threat to Zalkon?", ([^]i32)(&line))
	}
	if isNewsEvent(DRAGONFLYDESTROYED) {
		DisplayHeadline("Spectacular Display as Stolen Ship Destroyed in Fierce Space Battle.", ([^]i32)(&line))
	}
	if isNewsEvent(SCARABDESTROYED) {
		DisplayHeadline("Wormhole Traffic Delayed as Stolen Craft Destroyed.", ([^]i32)(&line))
	}
	if isNewsEvent(MEDICINEDELIVERY) {
		DisplayHeadline("Disease Antidotes Arrive! Health Officials Optimistic.", ([^]i32)(&line))
	}
	if isNewsEvent(JAPORIDISEASE) {
		DisplayHeadline("Editorial: We Must Help Japori!", ([^]i32)(&line))
	}
	if isNewsEvent(ARTIFACTDELIVERY) {
		DisplayHeadline("Scientist Adds Alien Artifact to Museum Collection.", ([^]i32)(&line))
	}
	if isNewsEvent(JAREKGETSOUT) {
		DisplayHeadline("Ambassador Jarek Returns from Crisis.", ([^]i32)(&line))
	}
	if isNewsEvent(WILDGETSOUT) {
		DisplayHeadline("Rumors Suggest Known Criminal J. Wild May Come to Kravat!", ([^]i32)(&line))
	}
	if isNewsEvent(GEMULONRESCUED) {
		DisplayHeadline("Invasion Imminent! Plans in Place to Repel Hostile Invaders.", ([^]i32)(&line))
	}
	if ((g.SolarSystem[g.Mercenary[0].CurSystem].Special == GEMULONRESCUED) && !(isNewsEvent(GEMULONRESCUED))) {
		DisplayHeadline("Alien Invasion Devastates Planet!", ([^]i32)(&line))
	}
	if isNewsEvent(ALIENINVASION) {
		DisplayHeadline("Editorial: Who Will Warn Gemulon?", ([^]i32)(&line))
	}
	if isNewsEvent(ARRIVALVIASINGULARITY) {
		DisplayHeadline("Travelers Claim Sighting of Ship Materializing in Orbit!", ([^]i32)(&line))
	}
	if (i32(g.SolarSystem[g.Mercenary[0].CurSystem].Status) > 0) {
		switch i32(g.SolarSystem[g.Mercenary[0].CurSystem].Status) {
		case WAR:
			DisplayHeadline("War News: Offensives Continue!", ([^]i32)(&line))
		case PLAGUE:
			DisplayHeadline("Plague Spreads! Outlook Grim.", ([^]i32)(&line))
		case DROUGHT:
			DisplayHeadline("No Rain in Sight!", ([^]i32)(&line))
		case BOREDOM:
			DisplayHeadline("Editors: Won't Someone Entertain Us?", ([^]i32)(&line))
		case COLD:
			DisplayHeadline("Cold Snap Continues!", ([^]i32)(&line))
		case CROPFAILURE:
			DisplayHeadline("Serious Crop Failure! Must We Ration?", ([^]i32)(&line))
		case LACKOFWORKERS:
			DisplayHeadline("Jobless Rate at All-Time Low!", ([^]i32)(&line))
		}
	}
	if (g.PoliceRecordScore <= VILLAINSCORE) {
		j = GetRandom2(4)
		switch j {
		case 0:
			StrCopy(cstring(&g.SBuf[0]), "Police Warning: ")
			StrCat(cstring(&g.SBuf[0]), cstring(&g.NameCommander[0]))
			StrCat(cstring(&g.SBuf[0]), " Will Dock At ")
			StrCat(cstring(&g.SBuf[0]), SolarSystemName[g.SolarSystem[g.Mercenary[0].CurSystem].NameIndex])
			StrCat(cstring(&g.SBuf[0]), "!")
		case 1:
			StrCopy(cstring(&g.SBuf[0]), "Notorious Criminal ")
			StrCat(cstring(&g.SBuf[0]), cstring(&g.NameCommander[0]))
			StrCat(cstring(&g.SBuf[0]), " Sighted in ")
			StrCat(cstring(&g.SBuf[0]), SolarSystemName[g.SolarSystem[g.Mercenary[0].CurSystem].NameIndex])
			StrCat(cstring(&g.SBuf[0]), "!")
		case 2:
			StrCopy(cstring(&g.SBuf[0]), "Locals Rally to Deny Spaceport Access to ")
			StrCat(cstring(&g.SBuf[0]), cstring(&g.NameCommander[0]))
			StrCat(cstring(&g.SBuf[0]), "!")
		case 3:
			StrCopy(cstring(&g.SBuf[0]), "Terror Strikes Locals on Arrival of ")
			StrCat(cstring(&g.SBuf[0]), cstring(&g.NameCommander[0]))
			StrCat(cstring(&g.SBuf[0]), "!")
		}
		DisplayHeadline(cstring(&g.SBuf[0]), ([^]i32)(&line))
	}
	if (g.PoliceRecordScore == HEROSCORE) {
		j = GetRandom2(3)
		switch j {
		case 0:
			StrCopy(cstring(&g.SBuf[0]), "Locals Welcome Visiting Hero ")
			StrCat(cstring(&g.SBuf[0]), cstring(&g.NameCommander[0]))
			StrCat(cstring(&g.SBuf[0]), "!")
		case 1:
			StrCopy(cstring(&g.SBuf[0]), "Famed Hero ")
			StrCat(cstring(&g.SBuf[0]), cstring(&g.NameCommander[0]))
			StrCat(cstring(&g.SBuf[0]), " to Visit System!")
		case 2:
			StrCopy(cstring(&g.SBuf[0]), "Large Turnout At Spaceport to Welcome ")
			StrCat(cstring(&g.SBuf[0]), cstring(&g.NameCommander[0]))
			StrCat(cstring(&g.SBuf[0]), "!")
		}
		DisplayHeadline(cstring(&g.SBuf[0]), ([^]i32)(&line))
	}
	if isNewsEvent(CAUGHTLITTERING) {
		StrCopy(cstring(&g.SBuf[0]), "Police Trace Orbiting Space Litter to ")
		StrCat(cstring(&g.SBuf[0]), cstring(&g.NameCommander[0]))
		StrCat(cstring(&g.SBuf[0]), ".")
		DisplayHeadline(cstring(&g.SBuf[0]), ([^]i32)(&line))
	}
	for i = 0; (i < MAXSOLARSYSTEM); i += 1 {
		if (((i != i32(g.Mercenary[0].CurSystem)) && ((RealDistance(g.SolarSystem[g.Mercenary[0].CurSystem], g.SolarSystem[i]) <= i32(Shiptype[g.Ship.Type].FuelTanks)) || (WormholeExists(i32(g.Mercenary[0].CurSystem), i)))) && (i32(g.SolarSystem[i].Status) > 0)) {
			if (g.SolarSystem[i].Special == MOONFORSALE) {
				StrCopy(cstring(&g.SBuf[0]), "Seller in ")
				StrCat(cstring(&g.SBuf[0]), SolarSystemName[i])
				StrCat(cstring(&g.SBuf[0]), " System has Utopian Moon available.")
				DisplayHeadline(cstring(&g.SBuf[0]), ([^]i32)(&line))
			}
			if (g.SolarSystem[i].Special == BUYTRIBBLE) {
				StrCopy(cstring(&g.SBuf[0]), "Collector in ")
				StrCat(cstring(&g.SBuf[0]), SolarSystemName[i])
				StrCat(cstring(&g.SBuf[0]), " System seeks to purchase Tribbles.")
				DisplayHeadline(cstring(&g.SBuf[0]), ([^]i32)(&line))
			}
			if (GetRandom2(100) <= (((50 / MAXTECHLEVEL) * i32(g.SolarSystem[g.Mercenary[0].CurSystem].TechLevel)) + (10 * (5 - i32(g.Difficulty))))) {
				j = GetRandom2(6)
				switch j {
				case 0:
					StrCopy(cstring(&g.SBuf[0]), "Reports of")
				case 1:
					StrCopy(cstring(&g.SBuf[0]), "News of")
				case 2:
					StrCopy(cstring(&g.SBuf[0]), "New Rumors of")
				case 3:
					StrCopy(cstring(&g.SBuf[0]), "Sources say")
				case 4:
					StrCopy(cstring(&g.SBuf[0]), "Notice:")
				case 5:
					StrCopy(cstring(&g.SBuf[0]), "Evidence Suggests")
				}
				StrCat(cstring(&g.SBuf[0]), " ")
				switch i32(g.SolarSystem[i].Status) {
				case WAR:
					StrCat(cstring(&g.SBuf[0]), "Strife and War")
				case PLAGUE:
					StrCat(cstring(&g.SBuf[0]), "Plague Outbreaks")
				case DROUGHT:
					StrCat(cstring(&g.SBuf[0]), "Severe Drought")
				case BOREDOM:
					StrCat(cstring(&g.SBuf[0]), "Terrible Boredom")
				case COLD:
					StrCat(cstring(&g.SBuf[0]), "Cold Weather")
				case CROPFAILURE:
					StrCat(cstring(&g.SBuf[0]), "Crop Failures")
				case LACKOFWORKERS:
					StrCat(cstring(&g.SBuf[0]), "Labor Shortages")
				}
				StrCat(cstring(&g.SBuf[0]), " in the ")
				StrCat(cstring(&g.SBuf[0]), SolarSystemName[i])
				StrCat(cstring(&g.SBuf[0]), " System.")
				DisplayHeadline(cstring(&g.SBuf[0]), ([^]i32)(&line))
				realNews = true
			}
		}
	}
	if !realNews {
		for i = 0; (i < MAXSTORIES); i += 1 {
			shown[i] = false
		}
		for i = 0; (i <= GetRandom2(MAXSTORIES)); i += 1 {
			j = GetRandom2(MAXSTORIES)
			if (!shown[j] && (line <= 150)) {
				SysStringByIndex(u16((AnarchyHeadlinesStringList + (i32(g.SolarSystem[g.Mercenary[0].CurSystem].Politics) * 100))), u16(j), cstring(&g.SBuf[0]), u16(63))
				DisplayHeadline(cstring(&g.SBuf[0]), ([^]i32)(&line))
				shown[j] = true
			}
		}
	}
}

NewspaperFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	switch u32(eventP.eType) {
	case u32(frmOpenEvent), u32(frmUpdateEvent):
		DrawNewspaperForm()
		handled = true
	case u32(ctlSelectEvent):
		if (i32(eventP.data.ctlSelect.controlID) == NewspaperDoneButton) {
			g.CurForm = SystemInformationForm
		}
		FrmGotoForm(u16(g.CurForm))
		handled = true
	case:
	}
	return handled
}

PersonnelRosterFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	Sale: bool
	FirstFree: i32
	ForHire: i32
	oldtraderskill: i32
	switch u32(eventP.eType) {
	case u32(frmOpenEvent):
		DrawPersonnelRoster()
		handled = true
	case u32(frmUpdateEvent):
		DrawPersonnelRoster()
		handled = true
	case u32(ctlSelectEvent):
		Sale = true
		oldtraderskill = i32(TraderSkill(&g.Ship))
		if (i32(eventP.data.ctlSelect.controlID) == PersonnelRosterFire0Button) {
			if (i32(FrmAlert(u16(FireMercenaryAlert))) == 0) {
				g.Ship.Crew[1] = g.Ship.Crew[2]
				g.Ship.Crew[2] = -1
			}
		} else if (i32(eventP.data.ctlSelect.controlID) == PersonnelRosterFire1Button) {
			if (i32(FrmAlert(u16(FireMercenaryAlert))) == 0) {
				g.Ship.Crew[2] = -1
			}
		} else if (i32(eventP.data.ctlSelect.controlID) == PersonnelRosterHire0Button) {
			ForHire = GetForHire()
			FirstFree = -1
			if (g.Ship.Crew[1] == -1) {
				FirstFree = 1
			} else if (g.Ship.Crew[2] == -1) {
				FirstFree = 2
			}
			if ((FirstFree < 0) || (i32(AvailableQuarters()) <= FirstFree)) {
				FrmAlert(u16(NoFreeQuartersAlert))
				Sale = false
			} else {
				g.Ship.Crew[FirstFree] = ForHire
			}
		}
		if Sale {
			DrawPersonnelRoster()
			if (oldtraderskill != i32(TraderSkill(&g.Ship))) {
				RecalculateBuyPrices(g.Mercenary[0].CurSystem)
			}
		}
		handled = true
	case:
	}
	return handled
}

