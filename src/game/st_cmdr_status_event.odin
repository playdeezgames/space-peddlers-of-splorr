package game

DisplaySkill :: proc(Skill: i32, AdaptedSkill: i32, frmP: ^FormType, Label: i32) {
	StrIToA(cstring(&g.SBuf[0]), Skill)
	StrCat(cstring(&g.SBuf[0]), " [")
	StrIToA(cstring(&g.SBuf2[0]), AdaptedSkill)
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	StrCat(cstring(&g.SBuf[0]), "]")
	setLabelText(frmP, Label, cstring(&g.SBuf[0]))
}

ShowCommanderStatus :: proc() {
	frmP: ^FormType
	i: i32
	frmP = FrmGetActiveForm()
	RectangularShortcuts(frmP, CommanderStatusBButton)
	setLabelText(frmP, CommanderStatusNameLabel, cstring(&g.NameCommander[0]))
	DisplaySkill(i32(g.Mercenary[0].Pilot), i32(PilotSkill(&g.Ship)), frmP, CommanderStatusPilotLabel)
	DisplaySkill(i32(g.Mercenary[0].Fighter), i32(FighterSkill(&g.Ship)), frmP, CommanderStatusFighterLabel)
	DisplaySkill(i32(g.Mercenary[0].Trader), i32(TraderSkill(&g.Ship)), frmP, CommanderStatusTraderLabel)
	DisplaySkill(i32(g.Mercenary[0].Engineer), i32(EngineerSkill(&g.Ship)), frmP, CommanderStatusEngineerLabel)
	StrIToA(cstring(&g.SBuf[0]), ((g.PoliceKills + g.TraderKills) + g.PirateKills))
	setLabelText(frmP, CommanderStatusKillsLabel, cstring(&g.SBuf[0]))
	i = 0
	for ((i < MAXPOLICERECORD) && (g.PoliceRecordScore >= PoliceRecord[i].MinScore)) {
		i += 1
	}
	i -= 1
	if (i < 0) {
		i += 1
	}
	setLabelText(frmP, CommanderStatusPoliceRecordLabel, PoliceRecord[i].Name)
	i = 0
	for ((i < MAXREPUTATION) && (g.ReputationScore >= Reputation[i].MinScore)) {
		i += 1
	}
	i -= 1
	if (i < 0) {
		i = 0
	}
	setLabelText(frmP, CommanderStatusReputationLabel, Reputation[i].Name)
	setLabelText(frmP, CommanderStatusLevelLabel, DifficultyLevel[g.Difficulty])
	StrIToA(cstring(&g.SBuf[0]), g.Days)
	StrCat(cstring(&g.SBuf[0]), " days")
	setLabelText(frmP, CommanderStatusDaysLabel, cstring(&g.SBuf[0]))
	StrIToA(cstring(&g.SBuf[0]), g.Credits)
	StrCat(cstring(&g.SBuf[0]), " cr.")
	setLabelText(frmP, CommanderStatusCreditsLabel, cstring(&g.SBuf[0]))
	StrIToA(cstring(&g.SBuf[0]), g.Debt)
	StrCat(cstring(&g.SBuf[0]), " cr.")
	setLabelText(frmP, CommanderStatusDebtLabel, cstring(&g.SBuf[0]))
	StrIToA(cstring(&g.SBuf[0]), CurrentWorth())
	StrCat(cstring(&g.SBuf[0]), " cr.")
	setLabelText(frmP, CommanderStatusNetWorthLabel, cstring(&g.SBuf[0]))
	if (g.CheatCounter == 3) {
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(CommanderStatusCheatButton)))
	} else {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(CommanderStatusCheatButton)))
	}
	FrmDrawForm(frmP)
}

CommanderStatusFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	switch u32(eventP.eType) {
	case u32(frmOpenEvent):
		ShowCommanderStatus()
		g.CheatCounter = 0
		handled = true
	case u32(frmUpdateEvent):
		ShowCommanderStatus()
		handled = true
	case u32(ctlSelectEvent):
		if (i32(eventP.data.ctlSelect.controlID) == CommanderStatusCheatButton) {
			g.CommanderStatusFormHandleEvent__frm = FrmInitForm(u16(CheatForm))
			StrIToA(cstring(&g.SBuf[0]), g.Credits)
			g.CommanderStatusFormHandleEvent__AmountH[0] = SetField(g.CommanderStatusFormHandleEvent__frm, CheatCreditsField, cstring(&g.SBuf[0]), 9, true)
			StrIToA(cstring(&g.SBuf[0]), g.Debt)
			g.CommanderStatusFormHandleEvent__AmountH[1] = SetField(g.CommanderStatusFormHandleEvent__frm, CheatDebtField, cstring(&g.SBuf[0]), 9, true)
			StrIToA(cstring(&g.SBuf[0]), g.ReputationScore)
			g.CommanderStatusFormHandleEvent__AmountH[2] = SetField(g.CommanderStatusFormHandleEvent__frm, CheatReputationField, cstring(&g.SBuf[0]), 5, false)
			StrIToA(cstring(&g.SBuf[0]), (((g.PoliceRecordScore) < 0) ? (-(g.PoliceRecordScore)) : (g.PoliceRecordScore)))
			g.CommanderStatusFormHandleEvent__AmountH[3] = SetField(g.CommanderStatusFormHandleEvent__frm, CheatPoliceRecordField, cstring(&g.SBuf[0]), 5, false)
			SetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatNegativeCheckbox, (g.PoliceRecordScore < 0))
			SetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatMoonCheckbox, g.MoonBought)
			SetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatLightningShieldCheckbox, HasShield(&g.Ship, u8(LIGHTNINGSHIELD)))
			SetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatFuelCompactorCheckbox, HasGadget(&g.Ship, u8(FUELCOMPACTOR)))
			SetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatMorganLaserCheckbox, HasWeapon(&g.Ship, u8(MORGANLASERWEAPON), true))
			SetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatSingularityCheckbox, g.CanSuperWarp)
			FrmDoDialog(g.CommanderStatusFormHandleEvent__frm)
			GetField(g.CommanderStatusFormHandleEvent__frm, CheatCreditsField, cstring(&g.SBuf[0]), g.CommanderStatusFormHandleEvent__AmountH[0])
			if (i32(g.SBuf[0]) != 0) {
				g.Credits = StrAToI(cstring(&g.SBuf[0]))
			}
			GetField(g.CommanderStatusFormHandleEvent__frm, CheatDebtField, cstring(&g.SBuf[0]), g.CommanderStatusFormHandleEvent__AmountH[1])
			if (i32(g.SBuf[0]) != 0) {
				g.Debt = StrAToI(cstring(&g.SBuf[0]))
			}
			GetField(g.CommanderStatusFormHandleEvent__frm, CheatReputationField, cstring(&g.SBuf[0]), g.CommanderStatusFormHandleEvent__AmountH[2])
			if (i32(g.SBuf[0]) != 0) {
				g.ReputationScore = StrAToI(cstring(&g.SBuf[0]))
			}
			GetField(g.CommanderStatusFormHandleEvent__frm, CheatPoliceRecordField, cstring(&g.SBuf[0]), g.CommanderStatusFormHandleEvent__AmountH[3])
			if (i32(g.SBuf[0]) != 0) {
				g.PoliceRecordScore = StrAToI(cstring(&g.SBuf[0]))
			}
			if GetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatNegativeCheckbox) {
				g.PoliceRecordScore = -g.PoliceRecordScore
			}
			g.MoonBought = GetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatMoonCheckbox)
			if ((GetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatLightningShieldCheckbox) && !(HasShield(&g.Ship, u8(LIGHTNINGSHIELD)))) && (i32(Shiptype[g.Ship.Type].ShieldSlots) > 0)) {
				g.Ship.Shield[0] = LIGHTNINGSHIELD
			} else if (!(GetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatLightningShieldCheckbox)) && HasShield(&g.Ship, u8(LIGHTNINGSHIELD))) {
				for g.CommanderStatusFormHandleEvent__i = 0; (g.CommanderStatusFormHandleEvent__i < MAXSHIELD); g.CommanderStatusFormHandleEvent__i += 1 {
					if (g.Ship.Shield[g.CommanderStatusFormHandleEvent__i] == LIGHTNINGSHIELD) {
						g.Ship.Shield[g.CommanderStatusFormHandleEvent__i] = 1
					}
				}
			}
			if ((GetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatFuelCompactorCheckbox) && !(HasGadget(&g.Ship, u8(FUELCOMPACTOR)))) && (i32(Shiptype[g.Ship.Type].GadgetSlots) > 0)) {
				g.Ship.Gadget[0] = FUELCOMPACTOR
			} else if (!(GetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatFuelCompactorCheckbox)) && HasGadget(&g.Ship, u8(FUELCOMPACTOR))) {
				for g.CommanderStatusFormHandleEvent__i = 0; (g.CommanderStatusFormHandleEvent__i < MAXGADGET); g.CommanderStatusFormHandleEvent__i += 1 {
					if (g.Ship.Gadget[g.CommanderStatusFormHandleEvent__i] == FUELCOMPACTOR) {
						g.Ship.Gadget[g.CommanderStatusFormHandleEvent__i] = 1
					}
				}
			}
			if ((GetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatMorganLaserCheckbox) && !(HasWeapon(&g.Ship, u8(MORGANLASERWEAPON), true))) && (i32(Shiptype[g.Ship.Type].WeaponSlots) > 0)) {
				g.Ship.Weapon[0] = MORGANLASERWEAPON
			} else if (!(GetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatMorganLaserCheckbox)) && HasWeapon(&g.Ship, u8(MORGANLASERWEAPON), true)) {
				for g.CommanderStatusFormHandleEvent__i = 0; (g.CommanderStatusFormHandleEvent__i < MAXWEAPON); g.CommanderStatusFormHandleEvent__i += 1 {
					if (g.Ship.Weapon[g.CommanderStatusFormHandleEvent__i] == MORGANLASERWEAPON) {
						g.Ship.Weapon[g.CommanderStatusFormHandleEvent__i] = 1
					}
				}
			}
			g.CanSuperWarp = GetCheckBox(g.CommanderStatusFormHandleEvent__frm, CheatSingularityCheckbox)
			FrmDeleteForm(g.CommanderStatusFormHandleEvent__frm)
			ShowCommanderStatus()
		} else if (i32(eventP.data.ctlSelect.controlID) == CommanderStatusQuestsButton) {
			g.CurForm = QuestsForm
		} else if (i32(eventP.data.ctlSelect.controlID) == CommanderStatusSpecialButton) {
			g.CurForm = SpecialCargoForm
		} else {
			g.CurForm = CurrentShipForm
		}
		FrmGotoForm(u16(g.CurForm))
		handled = true
	case:
	}
	return handled
}

