// or add an override instead.
package game

CreateShip :: proc(Index: i32) {
	i: i32
	g.Ship.Type = u8(Index)
	for i = 0; (i < MAXWEAPON); i += 1 {
		g.Ship.Weapon[i] = -1
	}
	for i = 0; (i < MAXSHIELD); i += 1 {
		g.Ship.Shield[i] = -1
		g.Ship.ShieldStrength[i] = 0
	}
	for i = 0; (i < MAXGADGET); i += 1 {
		g.Ship.Gadget[i] = -1
	}
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		g.Ship.Cargo[i] = 0
		g.BuyingPrice[i] = 0
	}
	g.Ship.Fuel = GetFuelTanks()
	g.Ship.Hull = Shiptype[g.Ship.Type].HullStrength
}

BuyShip :: proc(Index: i32) {
	CreateShip(Index)
	g.Credits -= g.ShipPrice[Index]
	if (i32(g.ScarabStatus) == 3) {
		g.ScarabStatus = u8(0)
	}
}

DetermineShipPrices :: proc() {
	i: i32
	for i = 0; (i < MAXSHIPTYPE); i += 1 {
		if (i32(Shiptype[i].MinTechLevel) <= i32(g.SolarSystem[g.Mercenary[0].CurSystem].TechLevel)) {
			g.ShipPrice[i] = (((Shiptype[i].Price * (100 - i32(TraderSkill(&g.Ship)))) / 100) - CurrentShipPrice(false))
			if (g.ShipPrice[i] == 0) {
				g.ShipPrice[i] = 1
			}
		} else {
			g.ShipPrice[i] = 0
		}
	}
}

CreateFlea :: proc() {
	i: i32
	CreateShip(0)
	for i = 1; (i < MAXCREW); i += 1 {
		g.Ship.Crew[i] = -1
	}
	g.EscapePod = false
	g.Insurance = false
	g.NoClaim = 0
}

DrawBuyShipForm :: proc() {
	frmP: ^FormType = FrmGetActiveForm()
	i: i32
	j: i32
	RectangularShortcuts(frmP, BuyShipBButton)
	DetermineShipPrices()
	for i = 0; (i < MAXSHIPTYPE); i += 1 {
		RectangularButton(frmP, (BuyShipInfo0Button + i))
		RectangularButton(frmP, (BuyShipBuy0Button + i))
		if ((g.ShipPrice[i] == 0) || (i32(g.Ship.Type) == i)) {
			FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((BuyShipBuy0Button + i))))
		} else {
			FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((BuyShipBuy0Button + i))))
		}
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((BuyShipInfo0Button + i))))
	}
	FrmDrawForm(frmP)
	for i = 0; (i < MAXSHIPTYPE); i += 1 {
		FntSetFont(stdFont)
		DrawChars(Shiptype[i].Name, 30, (17 + (i * 13)))
		EraseRectangle(110, (17 + (i * 13)), 56, 9)
		StrIToA(cstring(&g.SBuf[0]), g.ShipPrice[i])
		StrCat(cstring(&g.SBuf[0]), " cr.")
		j = (MAXDIGITS - i32(StrLen(cstring(&g.SBuf[0]))))
		if (g.ShipPrice[i] == 0) {
			DrawChars("not sold", 122, (17 + (i * 13)))
		} else if (i32(g.Ship.Type) == i) {
			DrawChars("got one", 123, (17 + (i * 13)))
		} else {
			DrawChars(cstring(&g.SBuf[0]), ((124 + (j * 5)) + ((g.ShipPrice[i] < 0) ? 1 : 0)), (17 + (i * 13)))
		}
	}
	DisplayTradeCredits()
	if ((g.Ship.Tribbles > 0) && !g.TribbleMessage) {
		FrmAlert(u16(ShipNotWorthMuchAlert))
		g.TribbleMessage = true
	}
}

BuyShipFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	addLightning: bool
	addCompactor: bool
	addMorganLaser: bool
	hasLightning: bool
	hasCompactor: bool
	hasMorganLaser: bool
	extra: i32
	d: i32
	i: i32
	j: i32
	switch u32(eventP.eType) {
	case u32(frmOpenEvent), u32(frmUpdateEvent):
		DrawBuyShipForm()
		handled = true
	case u32(ctlSelectEvent):
		if ((i32(eventP.data.ctlSelect.controlID) >= BuyShipInfo0Button) && (i32(eventP.data.ctlSelect.controlID) <= BuyShipInfo9Button)) {
			g.SelectedShipType = (i32(eventP.data.ctlSelect.controlID) - BuyShipInfo0Button)
			g.CurForm = ShiptypeInfoForm
			FrmGotoForm(u16(g.CurForm))
		} else if ((i32(eventP.data.ctlSelect.controlID) >= BuyShipBuy0Button) && (i32(eventP.data.ctlSelect.controlID) <= BuyShipBuy9Button)) {
			j = 0
			for i = 0; (i < MAXCREW); i += 1 {
				if (g.Ship.Crew[i] >= 0) {
					j += 1
				}
			}
			if (g.ShipPrice[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)] == 0) {
				FrmAlert(u16(ShipNotAvailableAlert))
			} else if ((g.ShipPrice[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)] > 0) && (g.Debt > 0)) {
				FrmAlert(u16(YoureInDebtAlert))
			} else if (g.ShipPrice[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)] > ToSpend()) {
				FrmAlert(u16(CantBuyShipAlert))
			} else if ((i32(g.JarekStatus) == 1) && (i32(Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].CrewQuarters) < 2)) {
				FrmCustomAlert(u16(PassengerNeedsQuartersAlert), "Ambassador Jarek", nil, nil)
			} else if ((i32(g.WildStatus) == 1) && (i32(Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].CrewQuarters) < 2)) {
				FrmCustomAlert(u16(PassengerNeedsQuartersAlert), "Jonathan Wild", nil, nil)
			} else if ((i32(g.ReactorStatus) > 0) && (i32(g.ReactorStatus) < 21)) {
				FrmAlert(u16(CantSellShipWithReactorAlert))
			} else {
				extra = 0
				hasLightning = false
				hasCompactor = false
				hasMorganLaser = false
				addLightning = false
				addCompactor = false
				addMorganLaser = false
				if HasShield(&g.Ship, u8(LIGHTNINGSHIELD)) {
					if (i32(Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].ShieldSlots) == 0) {
						FrmCustomAlert(u16(CantTransferSlotAlert), Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].Name, "Lightning Shield", "Shield")
					}
					hasLightning = true
					extra += 30000
				}
				if HasGadget(&g.Ship, u8(FUELCOMPACTOR)) {
					if (i32(Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].GadgetSlots) == 0) {
						FrmCustomAlert(u16(CantTransferSlotAlert), Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].Name, "Fuel Compactor", "Gadget")
					}
					hasCompactor = true
					extra += 20000
				}
				if HasWeapon(&g.Ship, u8(MORGANLASERWEAPON), true) {
					if (i32(Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].WeaponSlots) == 0) {
						FrmCustomAlert(u16(CantTransferSlotAlert), Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].Name, "Morgan's Laser", "Weapon")
					}
					extra += 33333
					hasMorganLaser = true
				}
				if ((g.ShipPrice[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)] + extra) > ToSpend()) {
					FrmCustomAlert(u16(CantBuyShipWithEquipmentAlert), cstring(&g.SBuf[0]), nil, nil)
				}
				extra = 0
				if (hasLightning && (i32(Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].ShieldSlots) > 0)) {
					if ((g.ShipPrice[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)] + extra) <= ToSpend()) {
						d = i32(FrmAlert(u16(TransferLightningShieldAlert)))
						if (d == 0) {
							addLightning = true
							extra += 30000
						}
					} else {
						FrmCustomAlert(u16(CantTransferAlert), "Lightning Shield", nil, nil)
					}
				}
				if (hasCompactor && (i32(Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].GadgetSlots) > 0)) {
					if ((g.ShipPrice[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)] + extra) <= ToSpend()) {
						d = i32(FrmAlert(u16(TransferFuelCompactorAlert)))
						if (d == 0) {
							addCompactor = true
							extra += 20000
						}
					} else {
						FrmCustomAlert(u16(CantTransferAlert), "Fuel Compactor", nil, nil)
					}
				}
				if (hasMorganLaser && (i32(Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].WeaponSlots) > 0)) {
					if ((g.ShipPrice[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)] + extra) <= ToSpend()) {
						d = i32(FrmAlert(u16(TransferMorganLaserAlert)))
						if (d == 0) {
							addMorganLaser = true
							extra += 33333
						}
					} else {
						FrmCustomAlert(u16(CantTransferAlert), "Morgan's Laser", nil, nil)
					}
				}
				if (j > i32(Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].CrewQuarters)) {
					FrmAlert(u16(TooManyCrewmembersAlert))
				} else {
					if ((addCompactor || addLightning) || addMorganLaser) {
						StrCopy(cstring(&g.SBuf[0]), ", and transfer your unique equipment to the new ship?")
					} else {
						StrCopy(cstring(&g.SBuf[0]), "?")
					}
					d = i32(FrmCustomAlert(u16(TradeShipAlert), Shiptype[g.Ship.Type].Name, Shiptype[(i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button)].Name, cstring(&g.SBuf[0])))
					if (d == TradeShipYes) {
						BuyShip((i32(eventP.data.ctlSelect.controlID) - BuyShipBuy0Button))
						g.Credits -= extra
						if addCompactor {
							g.Ship.Gadget[0] = FUELCOMPACTOR
						}
						if addLightning {
							g.Ship.Shield[0] = LIGHTNINGSHIELD
						}
						if addMorganLaser {
							g.Ship.Weapon[0] = MORGANLASERWEAPON
						}
						g.Ship.Tribbles = 0
						g.CurForm = BuyShipForm
						FrmGotoForm(u16(g.CurForm))
					}
				}
			}
		}
		handled = true
	case:
	}
	return handled
}

