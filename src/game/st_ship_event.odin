package game

DrawCurrentShipForm :: proc() {
	frmP: ^FormType = FrmGetActiveForm()
	i: i32
	j: i32
	k: i32
	Line: i32
	FirstEmptySlot: i32
	RectangularShortcuts(frmP, CurrentShipBButton)
	FrmDrawForm(frmP)
	FntSetFont(boldFont)
	DrawChars("Type:", 0, 18)
	DrawChars("Equipment:", 0, 32)
	FntSetFont(stdFont)
	if (i32(g.ScarabStatus) == 3) {
		StrCopy(cstring(&g.SBuf[0]), Shiptype[g.Ship.Type].Name)
		StrCat(cstring(&g.SBuf[0]), "/hardened hull")
		DrawChars(cstring(&g.SBuf[0]), 60, 18)
	} else {
		DrawChars(Shiptype[g.Ship.Type].Name, 60, 18)
	}
	Line = 32
	for i = 0; (i < (MAXWEAPONTYPE + EXTRAWEAPONS)); i += 1 {
		j = 0
		for k = 0; (k < MAXWEAPON); k += 1 {
			if (g.Ship.Weapon[k] == i) {
				j += 1
			}
		}
		if (j > 0) {
			g.SBuf[0] = u8(0)
			SBufMultiples(j, Weapontype[i].Name)
			StrToLower(cstring(&g.SBuf2[0]), cstring(&g.SBuf[0]))
			DrawChars(cstring(&g.SBuf2[0]), 60, Line)
			Line += 14
		}
	}
	for i = 0; (i < (MAXSHIELDTYPE + EXTRASHIELDS)); i += 1 {
		j = 0
		for k = 0; (k < MAXSHIELD); k += 1 {
			if (g.Ship.Shield[k] == i) {
				j += 1
			}
		}
		if (j > 0) {
			g.SBuf[0] = u8(0)
			SBufMultiples(j, Shieldtype[i].Name)
			StrToLower(cstring(&g.SBuf2[0]), cstring(&g.SBuf[0]))
			DrawChars(cstring(&g.SBuf2[0]), 60, Line)
			Line += 14
		}
	}
	for i = 0; (i < (MAXGADGETTYPE + EXTRAGADGETS)); i += 1 {
		j = 0
		for k = 0; (k < MAXGADGET); k += 1 {
			if (g.Ship.Gadget[k] == i) {
				j += 1
			}
		}
		if (j > 0) {
			if (i == EXTRABAYS) {
				j = (j * 5)
				StrIToA(cstring(&g.SBuf[0]), j)
				StrCat(cstring(&g.SBuf[0]), " extra cargo bays")
			} else {
				StrCopy(cstring(&g.SBuf[0]), Gadgettype[i].Name)
			}
			StrToLower(cstring(&g.SBuf2[0]), cstring(&g.SBuf[0]))
			DrawChars(cstring(&g.SBuf2[0]), 60, Line)
			Line += 14
		}
	}
	if g.EscapePod {
		DrawChars("an escape pod", 60, Line)
		Line += 14
	}
	if AnyEmptySlots(&g.Ship) {
		FntSetFont(boldFont)
		DrawChars("Unfilled:        ", 0, Line)
		FntSetFont(stdFont)
		FirstEmptySlot = GetFirstEmptySlot(Shiptype[g.Ship.Type].WeaponSlots, ([^]i32)(&g.Ship.Weapon[0]))
		if (FirstEmptySlot >= 0) {
			g.SBuf[0] = u8(0)
			SBufMultiples((i32(Shiptype[g.Ship.Type].WeaponSlots) - FirstEmptySlot), "weapon slot")
			DrawChars(cstring(&g.SBuf[0]), 60, Line)
			Line += 14
		}
		FirstEmptySlot = GetFirstEmptySlot(Shiptype[g.Ship.Type].ShieldSlots, ([^]i32)(&g.Ship.Shield[0]))
		if (FirstEmptySlot >= 0) {
			g.SBuf[0] = u8(0)
			SBufMultiples((i32(Shiptype[g.Ship.Type].ShieldSlots) - FirstEmptySlot), "shield slot")
			DrawChars(cstring(&g.SBuf[0]), 60, Line)
			Line += 14
		}
		FirstEmptySlot = GetFirstEmptySlot(Shiptype[g.Ship.Type].GadgetSlots, ([^]i32)(&g.Ship.Gadget[0]))
		if (FirstEmptySlot >= 0) {
			g.SBuf[0] = u8(0)
			SBufMultiples((i32(Shiptype[g.Ship.Type].GadgetSlots) - FirstEmptySlot), "gadget slot")
			DrawChars(cstring(&g.SBuf[0]), 60, Line)
			Line += 14
		}
	}
}

CurrentShipFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	switch u32(eventP.eType) {
	case u32(frmOpenEvent), u32(frmUpdateEvent):
		DrawCurrentShipForm()
		handled = true
	case u32(ctlSelectEvent):
		if (i32(eventP.data.ctlSelect.controlID) == CurrentShipStatusButton) {
			g.CurForm = CommanderStatusForm
		} else if (i32(eventP.data.ctlSelect.controlID) == CurrentShipQuestsButton) {
			g.CurForm = QuestsForm
		} else if (i32(eventP.data.ctlSelect.controlID) == CurrentShipSpecialButton) {
			g.CurForm = SpecialCargoForm
		}
		FrmGotoForm(u16(g.CurForm))
		handled = true
	case:
	}
	return handled
}

