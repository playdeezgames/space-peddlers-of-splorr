package game

MaxLoan :: proc() -> i32 {
	return ((g.PoliceRecordScore >= CLEANSCORE) ? (((25000) <= (((1000) >= (((CurrentWorth() / 10) / 500) * 500)) ? (1000) : (((CurrentWorth() / 10) / 500) * 500))) ? (25000) : (((1000) >= (((CurrentWorth() / 10) / 500) * 500)) ? (1000) : (((CurrentWorth() / 10) / 500) * 500))) : 500)
}

GetLoan :: proc(Loan: i32) {
	Amount: i32
	Amount = (((MaxLoan() - g.Debt) <= (Loan)) ? (MaxLoan() - g.Debt) : (Loan))
	g.Credits += Amount
	g.Debt += Amount
}

PayBack :: proc(Cash: i32) {
	Amount: i32
	Amount = (((g.Debt) <= (Cash)) ? (g.Debt) : (Cash))
	Amount = (((Amount) <= (g.Credits)) ? (Amount) : (g.Credits))
	g.Credits -= Amount
	g.Debt -= Amount
}

ShowBank :: proc() {
	frmP: ^FormType
	frmP = FrmGetActiveForm()
	RectangularShortcuts(frmP, BankBButton)
	if (g.Debt <= 0) {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(BankPayBackButton)))
	} else {
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(BankPayBackButton)))
	}
	if g.Insurance {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(BankBuyInsuranceButton)))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(BankStopInsuranceButton)))
	} else {
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(BankBuyInsuranceButton)))
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(BankStopInsuranceButton)))
	}
	FrmDrawForm(frmP)
	EraseRectangle(80, 32, 80, 26)
	StrIToA(cstring(&g.SBuf[0]), g.Debt)
	StrCat(cstring(&g.SBuf[0]), " cr.")
	DrawChars(cstring(&g.SBuf[0]), 80, 32)
	StrIToA(cstring(&g.SBuf[0]), MaxLoan())
	StrCat(cstring(&g.SBuf[0]), " cr.")
	DrawChars(cstring(&g.SBuf[0]), 80, 46)
	EraseRectangle(80, 100, 80, 40)
	StrIToA(cstring(&g.SBuf[0]), CurrentShipPriceWithoutCargo(true))
	StrCat(cstring(&g.SBuf[0]), " cr. ")
	DrawChars(cstring(&g.SBuf[0]), 80, 100)
	StrIToA(cstring(&g.SBuf[0]), (((g.NoClaim) <= (90)) ? (g.NoClaim) : (90)))
	StrCat(cstring(&g.SBuf[0]), "%")
	if (g.NoClaim == 90) {
		StrCat(cstring(&g.SBuf[0]), " (maximum)")
	}
	DrawChars(cstring(&g.SBuf[0]), 80, 114)
	StrIToA(cstring(&g.SBuf[0]), InsuranceMoney())
	StrCat(cstring(&g.SBuf[0]), " cr. daily")
	DrawChars(cstring(&g.SBuf[0]), 80, 128)
	DisplayTradeCredits()
}

BankFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	frmP: ^FormType
	d: i32
	Amount: i32
	AmountH: MemHandle
	switch u32(eventP.eType) {
	case u32(frmOpenEvent), u32(frmUpdateEvent):
		ShowBank()
		handled = true
	case u32(ctlSelectEvent):
		if (i32(eventP.data.ctlSelect.controlID) == BankGetLoanButton) {
			if (g.Debt >= MaxLoan()) {
				FrmAlert(u16(DebtTooHighAlert))
				handled = true
				break
			}
			frmP = FrmInitForm(u16(GetLoanForm))
			AmountH = SetField(frmP, GetLoanGetLoanField, "", 6, true)
			StrCopy(cstring(&g.SBuf[0]), "You can borrow up to ")
			StrIToA(cstring(&g.SBuf2[0]), (MaxLoan() - g.Debt))
			StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
			StrCat(cstring(&g.SBuf[0]), " credits.")
			setLabelText(frmP, GetLoanMaxLoanLabel, cstring(&g.SBuf[0]))
			d = i32(FrmDoDialog(frmP))
			GetField(frmP, GetLoanGetLoanField, cstring(&g.SBuf[0]), AmountH)
			if (i32(g.SBuf[0]) == 0) {
				Amount = 0
			} else {
				Amount = StrAToI(cstring(&g.SBuf[0]))
			}
			FrmDeleteForm(frmP)
			if (d == GetLoanEverythingButton) {
				GetLoan(MaxLoan())
			} else if (d != GetLoanNothingButton) {
				GetLoan(Amount)
			}
		} else if (i32(eventP.data.ctlSelect.controlID) == BankPayBackButton) {
			if (g.Debt <= 0) {
				FrmAlert(u16(NoDebtAlert))
				handled = true
				break
			}
			frmP = FrmInitForm(u16(PayBackForm))
			AmountH = SetField(frmP, PayBackPayBackField, "", 6, true)
			StrCopy(cstring(&g.SBuf[0]), "You have a debt of ")
			StrIToA(cstring(&g.SBuf2[0]), g.Debt)
			StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
			StrCat(cstring(&g.SBuf[0]), " credits.")
			setLabelText(frmP, PayBackMaxDebtLabel, cstring(&g.SBuf[0]))
			d = i32(FrmDoDialog(frmP))
			GetField(frmP, PayBackPayBackField, cstring(&g.SBuf[0]), AmountH)
			if (i32(g.SBuf[0]) == 0) {
				Amount = 0
			} else {
				Amount = StrAToI(cstring(&g.SBuf[0]))
			}
			FrmDeleteForm(frmP)
			if (d == PayBackEverythingButton) {
				PayBack(99999)
			} else if (d != PayBackNothingButton) {
				PayBack(Amount)
			}
		} else if (i32(eventP.data.ctlSelect.controlID) == BankBuyInsuranceButton) {
			if !g.EscapePod {
				FrmAlert(u16(NoEscapePodAlert))
				handled = true
				break
			}
			g.Insurance = true
		} else if (i32(eventP.data.ctlSelect.controlID) == BankStopInsuranceButton) {
			if (i32(FrmAlert(u16(StopInsuranceAlert))) == StopInsuranceNo) {
				handled = true
				break
			}
			g.Insurance = false
			g.NoClaim = 0
		}
		ShowBank()
		handled = true
	case:
	}
	return handled
}

