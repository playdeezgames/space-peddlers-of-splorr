		MemMove(cast(rawptr)(sg), RecPointer, i32(u32(size_of(SAVEGAMETYPE))))
		MemHandleUnlock(RecHandle)
		DmReleaseRecord(pmDB, u16(0), true)
		DmCloseDatabase(pmDB)
	}
	if !DontLoad {
		FillGlobals(sg, State)
	}
	MemPtrUnlock(cast(rawptr)(sg))
	MemHandleFree(sgH)
