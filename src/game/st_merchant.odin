MainFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	frmP: ^FormType = FrmGetActiveForm()
	switch u32(eventP.eType) {
	case u32(frmOpenEvent):
		FrmDrawForm(frmP)
		handled = true
	case u32(frmUpdateEvent):
		FrmDrawForm(frmP)
		handled = true
	case u32(penDownEvent), u32(keyDownEvent):
		StartNewGame()
		handled = true
	case:
	}
	return handled
}

DefaultFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	frmP: ^FormType = FrmGetActiveForm()
	switch u32(eventP.eType) {
	case u32(frmOpenEvent):
		FrmDrawForm(frmP)
		handled = true
	case u32(frmUpdateEvent):
		FrmDrawForm(frmP)
		handled = true
	}
	return handled
}

