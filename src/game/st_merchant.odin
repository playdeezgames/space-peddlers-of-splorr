		prefsSize = u16(u32(size_of(SAVEGAMETYPE)))
		prefsVersion = PrefGetAppPreferences(u32(1398043233), u16(0), cast(rawptr)(sg), ([^]u16)(&prefsSize), true)
		if (i32(prefsVersion) > 1) {
			prefsVersion = i16(noPreferenceFound)
		}
		if (i32(prefsVersion) == noPreferenceFound) {
			g.CurForm = MainForm
			DontLoad = true
		}
	} else {
		DbId = DmFindDatabase(u16(0), ((State == 1) ? g.SAVEGAMENAME : g.SWITCHGAMENAME))
		if (DbId == u32(0)) {
			if (State == 1) {
				FrmAlert(u16(CannotLoadAlert))
			}
			MemPtrUnlock(cast(rawptr)(sg))
			MemHandleFree(sgH)
			return false
		}
		pmDB = DmOpenDatabase(u16(0), DbId, u16(dmModeReadWrite))
		RecHandle = DmGetRecord(pmDB, u16(0))
		if (RecHandle == cast(MemHandle)((nil))) {
			if (State == 1) {
				FrmAlert(u16(CannotLoadAlert))
			}
			DmReleaseRecord(pmDB, u16(0), true)
			DmCloseDatabase(pmDB)
			MemPtrUnlock(cast(rawptr)(sg))
			MemHandleFree(sgH)
			return false
		}
