package game

GetAmountForRepairs :: proc() -> i32 {
	frm: ^FormType
	d: i32
	Amount: i32
	AmountH: MemHandle
	frm = FrmInitForm(u16(BuyRepairsForm))
	AmountH = SetField(frm, BuyRepairsForRepairsField, "", 5, true)
	d = i32(FrmDoDialog(frm))
	GetField(frm, BuyRepairsForRepairsField, cstring(&g.SBuf[0]), AmountH)
	if (i32(g.SBuf[0]) == 0) {
		Amount = 0
	} else {
		Amount = StrAToI(cstring(&g.SBuf[0]))
	}
	FrmDeleteForm(frm)
	if (d == BuyFuelAllButton) {
		return (9999)
	} else if (d == BuyFuelNoneButton) {
		return (0)
	}
	return (Amount)
}

GetAmountForFuel :: proc() -> i32 {
	frm: ^FormType
	d: i32
	Amount: i32
	AmountH: MemHandle
	frm = FrmInitForm(u16(BuyFuelForm))
	AmountH = SetField(frm, BuyFuelForFuelField, "", 4, true)
	d = i32(FrmDoDialog(frm))
	GetField(frm, BuyFuelForFuelField, cstring(&g.SBuf[0]), AmountH)
	if (i32(g.SBuf[0]) == 0) {
		Amount = 0
	} else {
		Amount = StrAToI(cstring(&g.SBuf[0]))
	}
	FrmDeleteForm(frm)
	if (d == BuyFuelAllButton) {
		return (999)
	} else if (d == BuyFuelNoneButton) {
		return (0)
	}
	return (Amount)
}

GetHullStrength :: proc() -> i32 {
	if (i32(g.ScarabStatus) == 3) {
		return (Shiptype[g.Ship.Type].HullStrength + UPGRADEDHULL)
	} else {
		return Shiptype[g.Ship.Type].HullStrength
	}
	return {}
}

ShowShipYard :: proc() {
	frmP: ^FormType
	frmP = FrmGetActiveForm()
	RectangularShortcuts(frmP, ShipYardBButton)
	if (i32(GetFuel()) < i32(GetFuelTanks())) {
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardBuyFuelButton)))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardFullTankButton)))
	} else {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardBuyFuelButton)))
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardFullTankButton)))
	}
	if (g.Ship.Hull < GetHullStrength()) {
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardRepairButton)))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardFullRepairsButton)))
	} else {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardRepairButton)))
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardFullRepairsButton)))
	}
	if (i32(g.SolarSystem[g.Mercenary[0].CurSystem].TechLevel) >= i32(Shiptype[0].MinTechLevel)) {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardShipInformationButton)))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardBuyNewShipButton)))
	} else {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardBuyNewShipButton)))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardShipInformationButton)))
	}
	if ((g.EscapePod || (ToSpend() < 2000)) || (i32(g.SolarSystem[g.Mercenary[0].CurSystem].TechLevel) < i32(Shiptype[0].MinTechLevel))) {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardEscapePodButton)))
	} else {
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(ShipYardEscapePodButton)))
	}
	FrmDrawForm(frmP)
	FntSetFont(stdFont)
	EraseRectangle(0, 18, 160, 25)
	StrCopy(cstring(&g.SBuf[0]), "You have fuel to fly ")
	SBufMultiples(i32(GetFuel()), "parsec")
	StrCat(cstring(&g.SBuf[0]), ".")
	DrawChars(cstring(&g.SBuf[0]), 0, 18)
	if (i32(GetFuel()) < i32(GetFuelTanks())) {
		StrCopy(cstring(&g.SBuf[0]), "A full tank costs ")
		StrIToA(cstring(&g.SBuf2[0]), ((i32(GetFuelTanks()) - i32(GetFuel())) * i32(Shiptype[g.Ship.Type].CostOfFuel)))
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), " cr.")
		DrawChars(cstring(&g.SBuf[0]), 0, 30)
	} else {
		DrawChars("Your tank cannot hold more fuel.", 0, 30)
	}
	EraseRectangle(0, 60, 160, 25)
	StrCopy(cstring(&g.SBuf[0]), "Your hull strength is at ")
	StrIToA(cstring(&g.SBuf2[0]), ((g.Ship.Hull * 100) / GetHullStrength()))
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	StrCat(cstring(&g.SBuf[0]), "%.")
	DrawChars(cstring(&g.SBuf[0]), 0, 60)
	if (g.Ship.Hull < GetHullStrength()) {
		StrCopy(cstring(&g.SBuf[0]), "Full repair will cost ")
		StrIToA(cstring(&g.SBuf2[0]), ((GetHullStrength() - g.Ship.Hull) * i32(Shiptype[g.Ship.Type].RepairCosts)))
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), " cr.")
		DrawChars(cstring(&g.SBuf[0]), 0, 72)
	} else {
		DrawChars("No repairs are needed.", 0, 72)
	}
	EraseRectangle(0, 102, 160, 12)
	if (i32(g.SolarSystem[g.Mercenary[0].CurSystem].TechLevel) >= i32(Shiptype[0].MinTechLevel)) {
		DrawChars("There are new ships for sale.", 0, 102)
	} else {
		DrawChars("No new ships are for sale.", 0, 102)
	}
	DisplayTradeCredits()
	EraseRectangle(0, 132, 160, 12)
	if g.EscapePod {
		DrawChars("You have an escape pod installed.", 0, 132)
	} else if (i32(g.SolarSystem[g.Mercenary[0].CurSystem].TechLevel) < i32(Shiptype[0].MinTechLevel)) {
		DrawChars("No escape pods are for sale.", 0, 132)
	} else if (ToSpend() < 2000) {
		DrawChars("You need 2000 cr. for an escape pod.", 0, 132)
	} else {
		DrawChars("You can buy an escape pod for 2000 cr.", 0, 132)
	}
}

BuyRepairs :: proc(Amount_in: i32) {
	Amount := Amount_in
	MaxRepairs: i32
	Percentage: i32
	MaxRepairs = ((GetHullStrength() - g.Ship.Hull) * i32(Shiptype[g.Ship.Type].RepairCosts))
	if (Amount > MaxRepairs) {
		Amount = MaxRepairs
	}
	if (Amount > g.Credits) {
		Amount = g.Credits
	}
	Percentage = (Amount / i32(Shiptype[g.Ship.Type].RepairCosts))
	g.Ship.Hull += Percentage
	g.Credits -= (Percentage * i32(Shiptype[g.Ship.Type].RepairCosts))
}

ShipYardFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	Amount: i32
	switch u32(eventP.eType) {
	case u32(frmOpenEvent):
		ShowShipYard()
		handled = true
	case u32(ctlSelectEvent):
		switch i32(eventP.data.ctlSelect.controlID) {
		case ShipYardBuyFuelButton:
			Amount = GetAmountForFuel()
			if (Amount > 0) {
				BuyFuel(Amount)
			}
			ShowShipYard()
		case ShipYardFullTankButton:
			BuyFuel(999)
			ShowShipYard()
		case ShipYardRepairButton:
			Amount = GetAmountForRepairs()
			if (Amount > 0) {
				BuyRepairs(Amount)
			}
			ShowShipYard()
		case ShipYardFullRepairsButton:
			BuyRepairs(9999)
			ShowShipYard()
		case ShipYardBuyNewShipButton:
			g.CurForm = BuyShipForm
			FrmGotoForm(u16(g.CurForm))
		case ShipYardShipInformationButton:
			g.CurForm = BuyShipForm
			FrmGotoForm(u16(g.CurForm))
		case ShipYardEscapePodButton:
			if (i32(FrmAlert(u16(BuyEscapePodAlert))) == BuyEscapePodYes) {
				g.Credits -= 2000
				g.EscapePod = true
				ShowShipYard()
			}
		}
		handled = true
	case:
	}
	return handled
}

