GetAmountToSell :: proc(Index: i32, Operation: u8) -> i32 {
	frm: ^FormType
	d: i32
	Amount: i32
	AmountH: MemHandle
	frm = FrmInitForm(u16(AmountToSellForm))
	AmountH = SetField(frm, AmountToSellToSellField, "", 4, true)
	if (i32(Operation) == SELLCARGO) {
		StrCopy(cstring(&g.SBuf[0]), "Sell ")
	} else {
		StrCopy(cstring(&g.SBuf[0]), "Discard ")
	}
	StrCat(cstring(&g.SBuf[0]), Tradeitem[Index].Name)
	setFormTitle(AmountToSellForm, cstring(&g.SBuf[0]))
	if (i32(Operation) == SELLCARGO) {
		StrCopy(cstring(&g.SBuf[0]), "You can sell up to ")
		StrIToA(cstring(&g.SBuf2[0]), g.Ship.Cargo[Index])
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), " at ")
		StrIToA(cstring(&g.SBuf2[0]), g.SellPrice[Index])
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), " cr. each.")
	} else if (i32(Operation) == DUMPCARGO) {
		StrCopy(cstring(&g.SBuf[0]), "You can dump up to ")
		StrIToA(cstring(&g.SBuf2[0]), (((g.Ship.Cargo[Index]) <= (ToSpend() / (5 * (i32(g.Difficulty) + 1)))) ? (g.Ship.Cargo[Index]) : (ToSpend() / (5 * (i32(g.Difficulty) + 1)))))
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), ".")
	} else {
		StrCopy(cstring(&g.SBuf[0]), "You can jettison up to ")
		StrIToA(cstring(&g.SBuf2[0]), g.Ship.Cargo[Index])
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), ".")
	}
	setLabelText(frm, AmountToSellMaxToSellLabel, cstring(&g.SBuf[0]))
	StrCopy(cstring(&g.SBuf[0]), "You paid about ")
	StrIToA(cstring(&g.SBuf2[0]), (g.BuyingPrice[Index] / g.Ship.Cargo[Index]))
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	StrCat(cstring(&g.SBuf[0]), " cr. per unit.")
	setLabelText(frm, AmountToSellAveragePriceLabel, cstring(&g.SBuf[0]))
	if (i32(Operation) == SELLCARGO) {
		if ((g.BuyingPrice[Index] / g.Ship.Cargo[Index]) > g.SellPrice[Index]) {
			StrCopy(cstring(&g.SBuf[0]), "Your loss per unit is ")
			StrIToA(cstring(&g.SBuf2[0]), ((g.BuyingPrice[Index] / g.Ship.Cargo[Index]) - g.SellPrice[Index]))
			StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
			StrCat(cstring(&g.SBuf[0]), " cr.")
			setLabelText(frm, AmountToSellAverageProfitLabel, cstring(&g.SBuf[0]))
		} else if ((g.BuyingPrice[Index] / g.Ship.Cargo[Index]) < g.SellPrice[Index]) {
			StrCopy(cstring(&g.SBuf[0]), "Your profit per unit is ")
			StrIToA(cstring(&g.SBuf2[0]), (g.SellPrice[Index] - (g.BuyingPrice[Index] / g.Ship.Cargo[Index])))
			StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
			StrCat(cstring(&g.SBuf[0]), " cr.")
			setLabelText(frm, AmountToSellAverageProfitLabel, cstring(&g.SBuf[0]))
		} else {
			StrCopy(cstring(&g.SBuf[0]), "You won't make a profit.")
			setLabelText(frm, AmountToSellAverageProfitLabel, cstring(&g.SBuf[0]))
		}
		setLabelText(frm, AmountToSellHowManyLabel, "How many do you want to sell?")
	} else if (i32(Operation) == DUMPCARGO) {
		StrCopy(cstring(&g.SBuf[0]), "It costs ")
		StrIToA(cstring(&g.SBuf2[0]), (5 * (i32(g.Difficulty) + 1)))
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), " cr. per unit for disposal.")
		setLabelText(frm, AmountToSellAverageProfitLabel, cstring(&g.SBuf[0]))
		setLabelText(frm, AmountToSellHowManyLabel, "How many will you dump?")
	} else {
		setLabelText(frm, AmountToSellAverageProfitLabel, "It costs nothing to jettison cargo.")
		setLabelText(frm, AmountToSellHowManyLabel, "How many will you dump?")
	}
	d = i32(FrmDoDialog(frm))
	GetField(frm, AmountToSellToSellField, cstring(&g.SBuf[0]), AmountH)
	if (i32(g.SBuf[0]) == 0) {
		Amount = 0
	} else {
		Amount = StrAToI(cstring(&g.SBuf[0]))
	}
	FrmDeleteForm(frm)
	if (d == AmountToSellAllButton) {
		return (999)
	} else if (d == AmountToSellNoneButton) {
		return (0)
	}
	return (Amount)
}

HasTradeableItems :: proc(sh: ^SHIP, theSystem: u8, Operation: u8) -> bool {
	i: i32
	ret: bool = false
	thisRet: bool
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		thisRet = false
		if (((sh.Cargo[i] > 0) && (i32(Operation) == TRADERSELL)) && (g.BuyPrice[i] > 0)) {
			thisRet = true
		} else if (((sh.Cargo[i] > 0) && (i32(Operation) == TRADERBUY)) && (g.SellPrice[i] > 0)) {
			thisRet = true
		}
		if (((g.PoliceRecordScore < DUBIOUSSCORE) && (i != FIREARMS)) && (i != NARCOTICS)) {
			thisRet = false
		} else if ((g.PoliceRecordScore >= DUBIOUSSCORE) && ((i == FIREARMS) || (i == NARCOTICS))) {
			thisRet = false
		}
		if thisRet {
			ret = true
		}
	}
	return ret
}

GetRandomTradeableItem :: proc(sh: ^SHIP, Operation: u8) -> i32 {
	looping: bool = true
	i: i32 = 0
	j: i32
	for (looping && (i < 10)) {
		j = (i32(SysRandom(0)) % (MAXTRADEITEM))
		if ((((sh.Cargo[j] > 0) && (i32(Operation) == TRADERSELL)) && (g.BuyPrice[j] > 0)) && (((g.PoliceRecordScore < DUBIOUSSCORE) && ((j == FIREARMS) || (j == NARCOTICS))) || (((g.PoliceRecordScore >= DUBIOUSSCORE) && (j != FIREARMS)) && (j != NARCOTICS)))) {
			looping = false
		} else if ((((sh.Cargo[j] > 0) && (i32(Operation) == TRADERBUY)) && (g.SellPrice[j] > 0)) && (((g.PoliceRecordScore < DUBIOUSSCORE) && ((j == FIREARMS) || (j == NARCOTICS))) || (((g.PoliceRecordScore >= DUBIOUSSCORE) && (j != FIREARMS)) && (j != NARCOTICS)))) {
			looping = false
		} else {
			j = -1
			i += 1
		}
	}
	if (j == -1) {
		j = 0
		looping = true
		for looping {
			if (((((sh.Cargo[j] > 0) && (i32(Operation) == TRADERSELL)) && (g.BuyPrice[j] > 0)) || (((sh.Cargo[j] > 0) && (i32(Operation) == TRADERBUY)) && (g.SellPrice[j] > 0))) && (((g.PoliceRecordScore < DUBIOUSSCORE) && ((j == FIREARMS) || (j == NARCOTICS))) || (((g.PoliceRecordScore >= DUBIOUSSCORE) && (j != FIREARMS)) && (j != NARCOTICS)))) {
				looping = false
			} else {
				j += 1
				if (j == MAXTRADEITEM) {
					looping = false
				}
			}
		}
	}
	return j
}

GetAmountToBuy :: proc(Index: i32) -> i32 {
	frm: ^FormType
	count: i32
	d: i32
	Amount: i32
	AmountH: MemHandle
	if ((g.BuyPrice[Index] <= 0) || (g.SolarSystem[g.Mercenary[0].CurSystem].Qty[Index] <= 0)) {
		FrmAlert(u16(ItemNotSoldAlert))
		return (0)
	}
	frm = FrmInitForm(u16(AmountToBuyForm))
	AmountH = SetField(frm, AmountToBuyToBuyField, "", 4, true)
	StrCopy(cstring(&g.SBuf[0]), "Buy ")
	StrCat(cstring(&g.SBuf[0]), Tradeitem[Index].Name)
	setFormTitle(AmountToBuyForm, cstring(&g.SBuf[0]))
	StrCopy(cstring(&g.SBuf[0]), "At ")
	StrIToA(cstring(&g.SBuf2[0]), g.BuyPrice[Index])
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	StrCat(cstring(&g.SBuf[0]), " cr. each, you can afford ")
	count = (((ToSpend() / g.BuyPrice[Index]) <= (g.SolarSystem[g.Mercenary[0].CurSystem].Qty[Index])) ? (ToSpend() / g.BuyPrice[Index]) : (g.SolarSystem[g.Mercenary[0].CurSystem].Qty[Index]))
	if (count <= 0) {
		StrCat(cstring(&g.SBuf[0]), "none")
	} else if (count < 1000) {
		StrIToA(cstring(&g.SBuf2[0]), count)
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	} else {
		StrCat(cstring(&g.SBuf[0]), "a lot")
	}
	StrCat(cstring(&g.SBuf[0]), ".")
	setLabelText(frm, AmountToBuyMaxToBuyLabel, cstring(&g.SBuf[0]))
	d = i32(FrmDoDialog(frm))
	GetField(frm, AmountToBuyToBuyField, cstring(&g.SBuf[0]), AmountH)
	if (i32(g.SBuf[0]) == 0) {
		Amount = 0
	} else {
		Amount = StrAToI(cstring(&g.SBuf[0]))
	}
	FrmDeleteForm(frm)
	if (d == AmountToBuyAllButton) {
		return (999)
	} else if (d == AmountToBuyNoneButton) {
		return (0)
	}
	return (Amount)
}

DisplayTradeQuantity :: proc(Line: i32, Qty: i32, FirstQtyButton: i32) {
	objindex: i32
	cp: ^ControlType
	frmP: ^FormType
	frmP = FrmGetActiveForm()
	objindex = i32(FrmGetObjectIndex(frmP, u16((FirstQtyButton + Line))))
	cp = cast(^ControlType)(FrmGetObjectPtr(frmP, u16(objindex)))
	StrIToA(cstring(&g.QtyBuf[Line][0]), Qty)
	CtlSetLabel(cp, cstring(&g.QtyBuf[Line][0]))
}

DrawPlunderForm :: proc() {
	frmP: ^FormType = FrmGetActiveForm()
	cp: ^ControlType
	i: i32
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		RectangularButton(frmP, (PlunderAll0Button + i))
		cp = RectangularButton(frmP, (PlunderQty0Button + i))
		g.QtyBuf[i][0] = u8(0)
		CtlSetLabel(cp, cstring(&g.QtyBuf[i][0]))
	}
	FrmDrawForm(frmP)
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		FntSetFont(stdFont)
		DrawChars(Tradeitem[i].Name, 35, (18 + (i * 13)))
		DisplayTradeQuantity(i, g.Opponent.Cargo[i], PlunderQty0Button)
	}
	DisplayPlunderCargoBays()
}

PlunderFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	frmP: ^FormType = FrmGetActiveForm()
	Amount: i32
	switch u32(eventP.eType) {
	case u32(frmOpenEvent):
		g.PlunderFormHandleEvent__narcs = g.Ship.Cargo[NARCOTICS]
		DrawPlunderForm()
		handled = true
	case u32(frmUpdateEvent):
		DrawPlunderForm()
		handled = true
	case u32(ctlSelectEvent):
		if ((i32(eventP.data.ctlSelect.controlID) >= PlunderAll0Button) && (i32(eventP.data.ctlSelect.controlID) <= PlunderAll9Button)) {
			PlunderCargo((i32(eventP.data.ctlSelect.controlID) - PlunderAll0Button), 999)
		} else if ((i32(eventP.data.ctlSelect.controlID) >= PlunderQty0Button) && (i32(eventP.data.ctlSelect.controlID) <= PlunderQty9Button)) {
			if (g.Opponent.Cargo[(i32(eventP.data.ctlSelect.controlID) - PlunderQty0Button)] <= 0) {
				FrmAlert(u16(VictimHasntGotAnyAlert))
			} else {
				Amount = GetAmountToPlunder((i32(eventP.data.ctlSelect.controlID) - PlunderQty0Button))
				if (Amount > 0) {
					PlunderCargo((i32(eventP.data.ctlSelect.controlID) - PlunderQty0Button), Amount)
				}
			}
		} else if (i32(eventP.data.ctlSelect.controlID) == PlunderDumpButton) {
			frmP = FrmInitForm(u16(DumpCargoForm))
			FrmSetEventHandler(frmP, DiscardCargoFormHandleEvent)
			FrmDoDialog(frmP)
			FrmDeleteForm(frmP)
			DrawPlunderForm()
		} else {
			if ((g.EncounterType == MARIECELESTEENCOUNTER) && (g.Ship.Cargo[NARCOTICS] > g.PlunderFormHandleEvent__narcs)) {
				g.JustLootedMarie = true
			}
			Travel()
		}
		handled = true
	case:
	}
	return handled
}

DrawBuyCargoForm :: proc() {
	frmP: ^FormType = FrmGetActiveForm()
	i: i32
	j: i32
	cp: ^ControlType
	RectangularShortcuts(frmP, BuyCargoBButton)
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		RectangularButton(frmP, (BuyCargoAll0Button + i))
		cp = RectangularButton(frmP, (BuyCargoQty0Button + i))
		g.QtyBuf[i][0] = u8(0)
		CtlSetLabel(cp, cstring(&g.QtyBuf[i][0]))
		if (g.BuyPrice[i] <= 0) {
			FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((BuyCargoQty0Button + i))))
			FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((BuyCargoAll0Button + i))))
		} else {
			FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((BuyCargoQty0Button + i))))
			FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((BuyCargoAll0Button + i))))
		}
	}
	FrmDrawForm(frmP)
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		FntSetFont(stdFont)
		DrawChars(Tradeitem[i].Name, 30, (17 + (i * 13)))
		EraseRectangle(117, (17 + (i * 13)), 43, 9)
		StrIToA(cstring(&g.SBuf[0]), g.BuyPrice[i])
		StrCat(cstring(&g.SBuf[0]), " cr.")
		j = (MAXPRICEDIGITS - i32(StrLen(cstring(&g.SBuf[0]))))
		if (g.BuyPrice[i] > 0) {
			DrawChars(cstring(&g.SBuf[0]), (139 + (j * 5)), (17 + (i * 13)))
		} else {
			DrawChars("not sold", 122, (17 + (i * 13)))
		}
		DisplayTradeQuantity(i, g.SolarSystem[g.Mercenary[0].CurSystem].Qty[i], BuyCargoQty0Button)
	}
	DisplayTradeCargoBays()
	DisplayTradeCredits()
}

BuyCargoFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	Amount: i32
	switch u32(eventP.eType) {
	case u32(frmOpenEvent), u32(frmUpdateEvent):
		DrawBuyCargoForm()
		handled = true
	case u32(ctlSelectEvent):
		if ((i32(eventP.data.ctlSelect.controlID) >= BuyCargoAll0Button) && (i32(eventP.data.ctlSelect.controlID) <= BuyCargoAll9Button)) {
			BuyCargo((i32(eventP.data.ctlSelect.controlID) - BuyCargoAll0Button), 999, true)
		} else {
			Amount = GetAmountToBuy((i32(eventP.data.ctlSelect.controlID) - BuyCargoQty0Button))
			if (Amount > 0) {
				BuyCargo((i32(eventP.data.ctlSelect.controlID) - BuyCargoQty0Button), Amount, true)
			}
		}
		handled = true
	case:
	}
	return handled
}

DrawSellCargoForm :: proc() {
	frmP: ^FormType = FrmGetActiveForm()
	i: i32
	j: i32
	cp: ^ControlType
	RectangularShortcuts(frmP, SellCargoBButton)
	FrmSetMenu(frmP, u16(MenuMainMenuBar))
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		cp = RectangularButton(frmP, (SellCargoQty0Button + i))
		g.QtyBuf[i][0] = u8(0)
		CtlSetLabel(cp, cstring(&g.QtyBuf[i][0]))
		if (g.SellPrice[i] <= 0) {
			FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((SellCargoQty0Button + i))))
			FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((SellCargoAll0Button + i))))
			FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((SellCargoDump0Button + i))))
			RectangularButton(frmP, (SellCargoDump0Button + i))
		} else {
			FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((SellCargoDump0Button + i))))
			FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((SellCargoQty0Button + i))))
			FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((SellCargoAll0Button + i))))
			RectangularButton(frmP, (SellCargoAll0Button + i))
		}
	}
	FrmDrawForm(frmP)
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		DisplayTradeItemName(i, u8(SELLCARGO))
		EraseRectangle(117, (17 + (i * 13)), 43, 9)
		StrIToA(cstring(&g.SBuf[0]), g.SellPrice[i])
		StrCat(cstring(&g.SBuf[0]), " cr.")
		j = (MAXPRICEDIGITS - i32(StrLen(cstring(&g.SBuf[0]))))
		if (g.SellPrice[i] > 0) {
			DrawChars(cstring(&g.SBuf[0]), (139 + (j * 5)), (17 + (i * 13)))
		} else {
			DrawChars("no trade", 119, (17 + (i * 13)))
		}
		if (g.SellPrice[i] > 0) {
			DisplayTradeQuantity(i, g.Ship.Cargo[i], SellCargoQty0Button)
		} else {
			StrIToA(cstring(&g.SBuf[0]), g.Ship.Cargo[i])
			DrawChars(cstring(&g.SBuf[0]), (11 - ((i32(StrLen(cstring(&g.SBuf[0]))) * 5) >> 1)), (17 + (i * 13)))
		}
	}
	DisplayTradeCargoBays()
	DisplayTradeCredits()
}

SellCargoFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	Amount: i32
	switch u32(eventP.eType) {
	case u32(frmOpenEvent), u32(frmUpdateEvent):
		DrawSellCargoForm()
		handled = true
	case u32(ctlSelectEvent):
		if ((i32(eventP.data.ctlSelect.controlID) >= SellCargoAll0Button) && (i32(eventP.data.ctlSelect.controlID) <= SellCargoAll9Button)) {
			SellCargo((i32(eventP.data.ctlSelect.controlID) - SellCargoAll0Button), 999, u8(SELLCARGO))
			DisplayTradeItemName((i32(eventP.data.ctlSelect.controlID) - SellCargoAll0Button), u8(SELLCARGO))
		} else if ((i32(eventP.data.ctlSelect.controlID) >= SellCargoDump0Button) && (i32(eventP.data.ctlSelect.controlID) <= SellCargoDump9Button)) {
			if (g.Ship.Cargo[(i32(eventP.data.ctlSelect.controlID) - SellCargoDump0Button)] <= 0) {
				FrmAlert(u16(NothingToDumpAlert))
				return true
			}
			Amount = GetAmountToSell((i32(eventP.data.ctlSelect.controlID) - SellCargoDump0Button), u8(DUMPCARGO))
			if (Amount > 0) {
				SellCargo((i32(eventP.data.ctlSelect.controlID) - SellCargoDump0Button), Amount, u8(DUMPCARGO))
			}
			DisplayTradeItemName((i32(eventP.data.ctlSelect.controlID) - SellCargoDump0Button), u8(DUMPCARGO))
		} else {
			if (g.Ship.Cargo[(i32(eventP.data.ctlSelect.controlID) - SellCargoQty0Button)] <= 0) {
				FrmAlert(u16(NothingForSaleAlert))
				return true
			}
			if (g.SellPrice[(i32(eventP.data.ctlSelect.controlID) - SellCargoQty0Button)] <= 0) {
				FrmAlert(u16(NotInterestedAlert))
				return true
			}
			Amount = GetAmountToSell((i32(eventP.data.ctlSelect.controlID) - SellCargoQty0Button), u8(SELLCARGO))
			if (Amount > 0) {
				SellCargo((i32(eventP.data.ctlSelect.controlID) - SellCargoQty0Button), Amount, u8(SELLCARGO))
			}
			DisplayTradeItemName((i32(eventP.data.ctlSelect.controlID) - SellCargoQty0Button), u8(SELLCARGO))
		}
		handled = true
	case:
	}
	return handled
}

ShowDumpCargo :: proc() {
	frmP: ^FormType = FrmGetActiveForm()
	i: i32
	cp: ^ControlType
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		RectangularButton(frmP, (DumpCargoAll0Button + i))
		cp = RectangularButton(frmP, (DumpCargoQty0Button + i))
		g.QtyBuf[i][0] = u8(0)
		CtlSetLabel(cp, cstring(&g.QtyBuf[i][0]))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((DumpCargoQty0Button + i))))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((DumpCargoAll0Button + i))))
	}
	FrmDrawForm(frmP)
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		DisplayTradeItemName(i, u8(JETTISONCARGO))
		DisplayTradeQuantity(i, g.Ship.Cargo[i], DumpCargoQty0Button)
	}
	DisplayPlunderCargoBays()
}

DiscardCargoFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	frmP: ^FormType = FrmGetActiveForm()
	Amount: i32
	switch u32(eventP.eType) {
	case u32(winEnterEvent):
		if g.DiscardCargoFormHandleEvent__DontUpdate {
			g.DiscardCargoFormHandleEvent__DontUpdate = false
		} else {
			ShowDumpCargo()
			handled = true
		}
	case u32(ctlSelectEvent):
		if ((i32(eventP.data.ctlSelect.controlID) >= DumpCargoAll0Button) && (i32(eventP.data.ctlSelect.controlID) <= DumpCargoAll9Button)) {
			if (g.Ship.Cargo[(i32(eventP.data.ctlSelect.controlID) - DumpCargoAll0Button)] <= 0) {
				FrmAlert(u16(NothingToDumpAlert))
				g.DiscardCargoFormHandleEvent__DontUpdate = true
				return true
			}
			StrIToA(cstring(&g.SBuf[0]), g.BuyingPrice[(i32(eventP.data.ctlSelect.controlID) - DumpCargoAll0Button)])
			if (i32(FrmCustomAlert(u16(DumpAllAlert), cstring(&g.SBuf[0]), nil, nil)) == DumpAllYes) {
				SellCargo((i32(eventP.data.ctlSelect.controlID) - DumpCargoAll0Button), 999, u8(JETTISONCARGO))
				DisplayTradeItemName((i32(eventP.data.ctlSelect.controlID) - DumpCargoAll0Button), u8(JETTISONCARGO))
				g.DiscardCargoFormHandleEvent__DontUpdate = true
			}
			handled = true
		} else if (i32(eventP.data.ctlSelect.controlID) >= DumpCargoDoneButton) {
		} else {
			if (g.Ship.Cargo[(i32(eventP.data.ctlSelect.controlID) - DumpCargoQty0Button)] <= 0) {
				FrmAlert(u16(NothingToDumpAlert))
				g.DiscardCargoFormHandleEvent__DontUpdate = true
				return true
			}
			Amount = GetAmountToSell((i32(eventP.data.ctlSelect.controlID) - DumpCargoQty0Button), u8(JETTISONCARGO))
			if (Amount > 0) {
				SellCargo((i32(eventP.data.ctlSelect.controlID) - DumpCargoQty0Button), Amount, u8(JETTISONCARGO))
			}
			DisplayTradeItemName((i32(eventP.data.ctlSelect.controlID) - DumpCargoQty0Button), u8(JETTISONCARGO))
			g.DiscardCargoFormHandleEvent__DontUpdate = true
			handled = true
		}
	case:
	}
	return handled
}

PlunderCargo :: proc(Index: i32, Amount: i32) {
	ToPlunder: i32
	if (g.Opponent.Cargo[Index] <= 0) {
		FrmAlert(u16(VictimHasntGotAnyAlert))
		return
	}
	if ((TotalCargoBays() - FilledCargoBays()) <= 0) {
		FrmAlert(u16(NoEmptyBaysAlert))
		return
	}
	ToPlunder = (((Amount) <= (g.Opponent.Cargo[Index])) ? (Amount) : (g.Opponent.Cargo[Index]))
	ToPlunder = (((ToPlunder) <= (TotalCargoBays() - FilledCargoBays())) ? (ToPlunder) : (TotalCargoBays() - FilledCargoBays()))
	g.Ship.Cargo[Index] += ToPlunder
	g.Opponent.Cargo[Index] -= ToPlunder
	DisplayTradeQuantity(Index, g.Opponent.Cargo[Index], PlunderQty0Button)
	DisplayPlunderCargoBays()
}

GetAmountToPlunder :: proc(Index: i32) -> i32 {
	frm: ^FormType
	d: i32
	Amount: i32
	AmountH: MemHandle
	frm = FrmInitForm(u16(AmountToPlunderForm))
	AmountH = SetField(frm, AmountToPlunderToPlunderField, "", 4, true)
	StrCopy(cstring(&g.SBuf[0]), "Steal ")
	StrCat(cstring(&g.SBuf[0]), Tradeitem[Index].Name)
	setFormTitle(AmountToPlunderForm, cstring(&g.SBuf[0]))
	StrCopy(cstring(&g.SBuf[0]), "Your victim has ")
	StrIToA(cstring(&g.SBuf2[0]), g.Opponent.Cargo[Index])
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	StrCat(cstring(&g.SBuf[0]), " of these goods.")
	setLabelText(frm, AmountToPlunderMaxToPlunderLabel, cstring(&g.SBuf[0]))
	d = i32(FrmDoDialog(frm))
	GetField(frm, AmountToPlunderToPlunderField, cstring(&g.SBuf[0]), AmountH)
	if (i32(g.SBuf[0]) == 0) {
		Amount = 0
	} else {
		Amount = StrAToI(cstring(&g.SBuf[0]))
	}
	FrmDeleteForm(frm)
	if (d == AmountToPlunderAllButton) {
		return (999)
	} else if (d == AmountToPlunderNoneButton) {
		return (0)
	}
	return (Amount)
}

BuyCargo :: proc(Index: i32, Amount: i32, DisplayInfo: bool) {
	ToBuy: i32
	if (g.Debt > DEBTTOOLARGE) {
		FrmAlert(u16(DebtTooLargeForBuyAlert))
		return
	}
	if ((g.SolarSystem[g.Mercenary[0].CurSystem].Qty[Index] <= 0) || (g.BuyPrice[Index] <= 0)) {
		FrmAlert(u16(NothingAvailableAlert))
		return
	}
	if (((TotalCargoBays() - FilledCargoBays()) - g.LeaveEmpty) <= 0) {
		FrmAlert(u16(NoEmptyBaysAlert))
		return
	}
	if (ToSpend() < g.BuyPrice[Index]) {
		FrmAlert(u16(CantAffordAlert))
		return
	}
	ToBuy = (((Amount) <= (g.SolarSystem[g.Mercenary[0].CurSystem].Qty[Index])) ? (Amount) : (g.SolarSystem[g.Mercenary[0].CurSystem].Qty[Index]))
	ToBuy = (((ToBuy) <= ((TotalCargoBays() - FilledCargoBays()) - g.LeaveEmpty)) ? (ToBuy) : ((TotalCargoBays() - FilledCargoBays()) - g.LeaveEmpty))
	ToBuy = (((ToBuy) <= (ToSpend() / g.BuyPrice[Index])) ? (ToBuy) : (ToSpend() / g.BuyPrice[Index]))
	g.Ship.Cargo[Index] += ToBuy
	g.Credits -= (ToBuy * g.BuyPrice[Index])
	g.BuyingPrice[Index] += (ToBuy * g.BuyPrice[Index])
	g.SolarSystem[g.Mercenary[0].CurSystem].Qty[Index] -= ToBuy
	if DisplayInfo {
		DisplayTradeQuantity(Index, g.SolarSystem[g.Mercenary[0].CurSystem].Qty[Index], BuyCargoQty0Button)
		DisplayTradeCargoBays()
		DisplayTradeCredits()
	}
}

SellCargo :: proc(Index: i32, Amount: i32, Operation: u8) {
	ToSell: i32
	if (g.Ship.Cargo[Index] <= 0) {
		if (i32(Operation) == SELLCARGO) {
			FrmAlert(u16(NothingForSaleAlert))
		} else {
			FrmAlert(u16(NothingToDumpAlert))
		}
		return
	}
	if ((g.SellPrice[Index] <= 0) && (i32(Operation) == SELLCARGO)) {
		FrmAlert(u16(NotInterestedAlert))
		return
	}
	if (i32(Operation) == JETTISONCARGO) {
		if ((g.PoliceRecordScore > DUBIOUSSCORE) && !g.LitterWarning) {
			g.LitterWarning = true
			if (i32(FrmAlert(u16(SpaceLitteringAlert))) == SpaceLitteringNo) {
				return
			}
		}
	}
	ToSell = (((Amount) <= (g.Ship.Cargo[Index])) ? (Amount) : (g.Ship.Cargo[Index]))
	if (i32(Operation) == DUMPCARGO) {
		ToSell = (((ToSell) <= ((ToSpend() / 5) * (i32(g.Difficulty) + 1))) ? (ToSell) : ((ToSpend() / 5) * (i32(g.Difficulty) + 1)))
	}
	g.BuyingPrice[Index] = ((g.BuyingPrice[Index] * (g.Ship.Cargo[Index] - ToSell)) / g.Ship.Cargo[Index])
	g.Ship.Cargo[Index] -= ToSell
	if (i32(Operation) == SELLCARGO) {
		g.Credits += (ToSell * g.SellPrice[Index])
	}
	if (i32(Operation) == DUMPCARGO) {
		g.Credits -= ((ToSell * 5) * (i32(g.Difficulty) + 1))
	}
	if (i32(Operation) == JETTISONCARGO) {
		if ((i32(SysRandom(0)) % (10)) < (i32(g.Difficulty) + 1)) {
			if (g.PoliceRecordScore > DUBIOUSSCORE) {
				g.PoliceRecordScore = DUBIOUSSCORE
			} else {
				g.PoliceRecordScore -= 1
			}
			addNewsEvent(CAUGHTLITTERING)
		}
	}
	if ((i32(Operation) == SELLCARGO) || (i32(Operation) == DUMPCARGO)) {
		if (g.SellPrice[Index] > 0) {
			DisplayTradeQuantity(Index, g.Ship.Cargo[Index], SellCargoQty0Button)
		} else {
			StrIToA(cstring(&g.SBuf[0]), g.Ship.Cargo[Index])
			DrawChars(cstring(&g.SBuf[0]), (11 - ((i32(StrLen(cstring(&g.SBuf[0]))) * 5) >> 1)), (17 + (Index * 13)))
		}
		DisplayTradeCargoBays()
		DisplayTradeCredits()
	} else {
		DisplayTradeQuantity(Index, g.Ship.Cargo[Index], DumpCargoQty0Button)
		DisplayPlunderCargoBays()
	}
}

DisplayTradeItemName :: proc(i: i32, Operation: u8) {
	if (((g.Ship.Cargo[i] > 0) && (g.SellPrice[i] > (g.BuyingPrice[i] / g.Ship.Cargo[i]))) && (i32(Operation) == SELLCARGO)) {
		FntSetFont(boldFont)
	} else {
		FntSetFont(stdFont)
	}
	if (i32(Operation) == SELLCARGO) {
		EraseRectangle(30, (17 + (i * 13)), 50, 12)
		DrawChars(Tradeitem[i].Name, 30, (17 + (i * 13)))
	} else if (i32(Operation) == JETTISONCARGO) {
		DrawChars(Tradeitem[i].Name, 35, (18 + (i * 13)))
	} else {
		DrawChars(Tradeitem[i].Name, 30, (18 + (i * 13)))
	}
	FntSetFont(stdFont)
}

TotalCargoBays :: proc() -> i32 {
	Bays: i32
	i: i32
	Bays = i32(Shiptype[g.Ship.Type].CargoBays)
	for i = 0; (i < MAXGADGET); i += 1 {
		if (g.Ship.Gadget[i] == EXTRABAYS) {
			Bays += 5
		}
	}
	if (i32(g.JaporiDiseaseStatus) == 1) {
		Bays -= 10
	}
	if ((i32(g.ReactorStatus) > 0) && (i32(g.ReactorStatus) < 21)) {
		Bays -= ((5 + 10) - ((i32(g.ReactorStatus) - 1) / 2))
	}
	return Bays
}

FilledCargoBays :: proc() -> i32 {
	sum: i32
	i: i32
	sum = 0
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		sum = (sum + g.Ship.Cargo[i])
	}
	return sum
}

DisplayPlunderCargoBays :: proc() {
	EraseRectangle(118, 32, 155, 39)
	SBufBays()
	FntSetFont(stdFont)
	DrawChars(cstring(&g.SBuf[0]), 118, 32)
}

BuyItem :: proc(Slots: u8, Item: [^]i32, Price: i32, Name: cstring, ItemIndex: i32) {
	FirstEmptySlot: i32
	frmP: ^FormType
	FirstEmptySlot = GetFirstEmptySlot(Slots, Item)
	if (Price <= 0) {
		FrmAlert(u16(ItemNotSoldAlert))
	} else if (g.Debt > 0) {
		FrmAlert(u16(YoureInDebtAlert))
	} else if (Price > ToSpend()) {
		FrmAlert(u16(CantBuyItemAlert))
	} else if (FirstEmptySlot < 0) {
		FrmAlert(u16(NotEnoughSlotsAlert))
	} else {
		frmP = FrmInitForm(u16(BuyItemForm))
		StrCopy(cstring(&g.SBuf[0]), "Buy ")
		StrCat(cstring(&g.SBuf[0]), Name)
		setFormTitle(BuyItemForm, cstring(&g.SBuf[0]))
		StrIToA(cstring(&g.SBuf[0]), Price)
		StrCat(cstring(&g.SBuf[0]), " credits?")
		setLabelText(frmP, BuyItemPriceLabel, cstring(&g.SBuf[0]))
		if (i32(FrmDoDialog(frmP)) == BuyItemYesButton) {
			Item[FirstEmptySlot] = ItemIndex
			g.Credits -= Price
		}
		FrmDeleteForm(frmP)
		DisplayTradeCredits()
	}
}

BasePrice :: proc(ItemTechLevel: u8, Price: i32) -> i32 {
	return ((i32(ItemTechLevel) > i32(g.SolarSystem[g.Mercenary[0].CurSystem].TechLevel)) ? 0 : ((Price * (100 - i32(TraderSkill(&g.Ship)))) / 100))
}

BaseSellPrice :: proc(Index: i32, Price: i32) -> i32 {
	return ((Index >= 0) ? ((Price * 3) / 4) : 0)
}

DrawSellEquipment :: proc() {
	frmP: ^FormType
	a: RectangleType
	i: i32
	j: i32
	frmP = FrmGetActiveForm()
	RectangularShortcuts(frmP, SellEquipmentBButton)
	for i = 0; (i < ((MAXWEAPON + MAXSHIELD) + MAXGADGET)); i += 1 {
		RectangularButton(frmP, (SellEquipmentSell0Button + i))
	}
	FrmDrawForm(frmP)
	EraseRectangle(30, 18, 130, 142)
	a.topLeft.x = i16(0)
	a.topLeft.y = i16((BOUNDSY + 38))
	a.extent.x = i16(160)
	a.extent.y = i16(2)
	WinDrawRectangle(&a, u16(0))
	a.topLeft.y = i16((BOUNDSY + 83))
	WinDrawRectangle(&a, u16(0))
	if (g.Ship.Weapon[0] < 0) {
		DrawChars("No weapons", 30, 30)
	}
	for i = 0; (i < MAXWEAPON); i += 1 {
		if (g.Ship.Weapon[i] < 0) {
			FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((SellEquipmentSell0Button + i))))
			continue
		}
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((SellEquipmentSell0Button + i))))
		FntSetFont(stdFont)
		DrawChars(Weapontype[g.Ship.Weapon[i]].Name, 30, (17 + (i * 13)))
		StrIToA(cstring(&g.SBuf[0]), (BaseSellPrice(g.Ship.Weapon[i], Weapontype[g.Ship.Weapon[i]].Price)))
		StrCat(cstring(&g.SBuf[0]), " cr.")
		j = (MAXDIGITS - i32(StrLen(cstring(&g.SBuf[0]))))
		DrawChars(cstring(&g.SBuf[0]), (124 + (j * 5)), (17 + (i * 13)))
	}
	if (g.Ship.Shield[0] < 0) {
		DrawChars("No shields", 30, 75)
	}
	for i = 0; (i < MAXSHIELD); i += 1 {
		if (g.Ship.Shield[i] < 0) {
			FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(((SellEquipmentSell0Button + MAXWEAPON) + i))))
			continue
		}
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(((SellEquipmentSell0Button + MAXWEAPON) + i))))
		FntSetFont(stdFont)
		DrawChars(Shieldtype[g.Ship.Shield[i]].Name, 30, (62 + (i * 13)))
		StrIToA(cstring(&g.SBuf[0]), (BaseSellPrice(g.Ship.Shield[i], Shieldtype[g.Ship.Shield[i]].Price)))
		StrCat(cstring(&g.SBuf[0]), " cr.")
		j = (MAXDIGITS - i32(StrLen(cstring(&g.SBuf[0]))))
		DrawChars(cstring(&g.SBuf[0]), (124 + (j * 5)), (62 + (i * 13)))
	}
	if (g.Ship.Gadget[0] < 0) {
		DrawChars("No gadgets", 30, 120)
	}
	for i = 0; (i < MAXGADGET); i += 1 {
		if (g.Ship.Gadget[i] < 0) {
			FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16((((SellEquipmentSell0Button + MAXWEAPON) + MAXSHIELD) + i))))
			continue
		}
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16((((SellEquipmentSell0Button + MAXWEAPON) + MAXSHIELD) + i))))
		FntSetFont(stdFont)
		DrawChars(Gadgettype[g.Ship.Gadget[i]].Name, 30, (107 + (i * 13)))
		StrIToA(cstring(&g.SBuf[0]), (BaseSellPrice(g.Ship.Gadget[i], Gadgettype[g.Ship.Gadget[i]].Price)))
		StrCat(cstring(&g.SBuf[0]), " cr.")
		j = (MAXDIGITS - i32(StrLen(cstring(&g.SBuf[0]))))
		DrawChars(cstring(&g.SBuf[0]), (124 + (j * 5)), (107 + (i * 13)))
	}
	DisplayTradeCredits()
}

SBufBays :: proc() {
	StrIToA(cstring(&g.SBuf[0]), FilledCargoBays())
	StrCat(cstring(&g.SBuf[0]), "/")
	StrIToA(cstring(&g.SBuf2[0]), TotalCargoBays())
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
}

DisplayTradeCargoBays :: proc() {
	EraseRectangle(0, 150, 62, 9)
	SBufBays()
	StrCopy(cstring(&g.SBuf2[0]), "Bays:  ")
	StrCat(cstring(&g.SBuf2[0]), cstring(&g.SBuf[0]))
	FntSetFont(stdFont)
	DrawChars(cstring(&g.SBuf2[0]), 0, 150)
}

DisplayTradeCredits :: proc() {
	j: i32
	EraseRectangle(78, 150, 83, 9)
	StrIToA(cstring(&g.SBuf[0]), g.Credits)
	j = (MAXDIGITS - i32(StrLen(cstring(&g.SBuf[0]))))
	StrCat(cstring(&g.SBuf[0]), " cr.")
	StrCopy(cstring(&g.SBuf2[0]), "Cash: ")
	StrCat(cstring(&g.SBuf2[0]), cstring(&g.SBuf[0]))
	FntSetFont(stdFont)
	DrawChars(cstring(&g.SBuf2[0]), (81 + (j * 5)), 150)
}

DisplayDumpCredits :: proc() {
	j: i32
	StrIToA(cstring(&g.SBuf[0]), g.Credits)
	j = (MAXDIGITS - i32(StrLen(cstring(&g.SBuf[0]))))
	StrCat(cstring(&g.SBuf[0]), " cr.")
	FntSetFont(stdFont)
	DrawChars(cstring(&g.SBuf[0]), 118, 64)
}

