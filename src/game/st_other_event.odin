package game

DrawSpecialCargoForm :: proc() {
	frmP: ^FormType
	Line: i32
	frmP = FrmGetActiveForm()
	RectangularShortcuts(frmP, SpecialCargoBButton)
	FrmDrawForm(frmP)
	Line = 18
	FntSetFont(stdFont)
	if (g.Ship.Tribbles > 0) {
		if (g.Ship.Tribbles >= MAXTRIBBLES) {
			StrCopy(cstring(&g.SBuf[0]), "An infestation of tribbles.")
		} else {
			StrCopy(cstring(&g.SBuf[0]), "")
			SBufMultiples(g.Ship.Tribbles, "cute, furry tribble")
			StrCat(cstring(&g.SBuf[0]), ".")
		}
		DrawChars(cstring(&g.SBuf[0]), 0, Line)
		Line += 14
	}
	if (i32(g.JaporiDiseaseStatus) == 1) {
		DrawChars("10 bays of antidote.", 0, Line)
		Line += 14
	}
	if g.ArtifactOnBoard {
		DrawChars("An alien artifact.", 0, Line)
		Line += 14
	}
	if (i32(g.JarekStatus) == 2) {
		DrawChars("A haggling computer.", 0, Line)
		Line += 14
	}
	if ((i32(g.ReactorStatus) > 0) && (i32(g.ReactorStatus) < 21)) {
		DrawChars("An unstable reactor taking up 5 bays.", 0, Line)
		Line += 14
		StrCopy(cstring(&g.SBuf[0]), "")
		SBufMultiples((10 - ((i32(g.ReactorStatus) - 1) / 2)), "bay")
		StrCat(cstring(&g.SBuf[0]), " of enriched fuel.")
		DrawChars(cstring(&g.SBuf[0]), 0, Line)
		Line += 14
	}
	if g.CanSuperWarp {
		DrawChars("A Portable Singularity.", 0, Line)
		Line += 14
	}
	if (Line == 18) {
		DrawChars("No special items.", 0, Line)
	}
}

SpecialCargoFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	switch u32(eventP.eType) {
	case u32(ctlSelectEvent):
		if (i32(eventP.data.ctlSelect.controlID) == SpecialCargoStatusButton) {
			g.CurForm = CommanderStatusForm
		} else if (i32(eventP.data.ctlSelect.controlID) == SpecialCargoShipButton) {
			g.CurForm = CurrentShipForm
		} else if (i32(eventP.data.ctlSelect.controlID) == SpecialCargoQuestsButton) {
			g.CurForm = QuestsForm
		}
		FrmGotoForm(u16(g.CurForm))
		handled = true
	case u32(frmOpenEvent), u32(frmUpdateEvent):
		DrawSpecialCargoForm()
		handled = true
	case:
	}
	return handled
}

ShowMessage :: proc(str1: cstring, str2: cstring, str3: cstring, ShowAlways: bool) {
	if (g.MessageHasBeenShown && !ShowAlways) {
		return
	}
	FrmCustomAlert(u16(GeneralMessageAlert), str1, str2, str3)
	g.MessageHasBeenShown = true
	return
}

