HasGadget :: proc(Sh: ^SHIP, Gg: u8) -> bool {
	i: i32
	for i = 0; (i < MAXGADGET); i += 1 {
		if (Sh.Gadget[i] < 0) {
			continue
		}
		if (Sh.Gadget[i] == i32(Gg)) {
			return true
		}
	}
	return false
}

