AdaptDifficulty :: proc(Level: u8) -> u8 {
	if ((i32(g.Difficulty) == BEGINNER) || (i32(g.Difficulty) == EASY)) {
		return u8((i32(Level) + 1))
	} else if (i32(g.Difficulty) == IMPOSSIBLE) {
		return u8((((1) >= (i32(Level) - 1)) ? (1) : (i32(Level) - 1)))
	} else {
		return Level
	}
	return {}
}

