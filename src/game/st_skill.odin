HasWeapon :: proc(Sh: ^SHIP, Gg: u8, exactCompare: bool) -> bool {
	i: i32
	for i = 0; (i < MAXWEAPON); i += 1 {
		if (Sh.Weapon[i] < 0) {
			continue
		}
		if ((Sh.Weapon[i] == i32(Gg)) || ((Sh.Weapon[i] > i32(Gg)) && !exactCompare)) {
			return true
		}
	}
	return false
}

