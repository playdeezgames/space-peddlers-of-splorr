NthLowestSkill :: proc(Sh: ^SHIP, n: u8) -> u8 {
	i: u8 = u8(0)
	lower: u8 = u8(1)
	retVal: u8
	looping: bool = true
	for looping {
		retVal = u8(0)
		if (i32(g.Mercenary[Sh.Crew[0]].Pilot) == i32(i)) {
			if (i32(lower) == i32(n)) {
				looping = false
				retVal = u8(PILOTSKILL)
			}
			lower += 1
		}
		if (i32(g.Mercenary[Sh.Crew[0]].Fighter) == i32(i)) {
			if (i32(lower) == i32(n)) {
				looping = false
				retVal = u8(FIGHTERSKILL)
			}
			lower += 1
		}
		if (i32(g.Mercenary[Sh.Crew[0]].Trader) == i32(i)) {
			if (i32(lower) == i32(n)) {
				looping = false
				retVal = u8(TRADERSKILL)
			}
			lower += 1
		}
		if (i32(g.Mercenary[Sh.Crew[0]].Engineer) == i32(i)) {
			if (i32(lower) == i32(n)) {
				looping = false
				retVal = u8(ENGINEERSKILL)
			}
			lower += 1
		}
		i += 1
	}
	return retVal
}

TraderSkill :: proc(Sh: ^SHIP) -> u8 {
	i: i32
	MaxSkill: u8
	MaxSkill = g.Mercenary[Sh.Crew[0]].Trader
	for i = 1; (i < MAXCREW); i += 1 {
		if (Sh.Crew[i] < 0) {
			break
		}
		if (i32(g.Mercenary[Sh.Crew[i]].Trader) > i32(MaxSkill)) {
			MaxSkill = g.Mercenary[Sh.Crew[i]].Trader
		}
	}
	if (i32(g.JarekStatus) >= 2) {
		MaxSkill += 1
	}
	return AdaptDifficulty(MaxSkill)
}

RecalculateBuyPrices :: proc(SystemID: u8) {
	i: i32
	for i = 0; (i < MAXTRADEITEM); i += 1 {
		if (i32(g.SolarSystem[SystemID].TechLevel) < i32(Tradeitem[i].TechProduction)) {
			g.BuyPrice[i] = 0
		} else if (((i == NARCOTICS) && (!Politics[g.SolarSystem[SystemID].Politics].DrugsOK)) || ((i == FIREARMS) && (!Politics[g.SolarSystem[SystemID].Politics].FirearmsOK))) {
			g.BuyPrice[i] = 0
		} else {
			if (g.PoliceRecordScore < DUBIOUSSCORE) {
				g.BuyPrice[i] = ((g.SellPrice[i] * 100) / 90)
			} else {
				g.BuyPrice[i] = g.SellPrice[i]
			}
			g.BuyPrice[i] = ((g.BuyPrice[i] * (103 + (MAXSKILL - i32(TraderSkill(&g.Ship))))) / 100)
			if (g.BuyPrice[i] <= g.SellPrice[i]) {
				g.BuyPrice[i] = (g.SellPrice[i] + 1)
			}
		}
	}
}

IncreaseRandomSkill :: proc() {
	Redo: bool
	d: i32
	oldtraderskill: i32
	if ((((i32(g.Mercenary[0].Pilot) >= MAXSKILL) && (i32(g.Mercenary[0].Trader) >= MAXSKILL)) && (i32(g.Mercenary[0].Fighter) >= MAXSKILL)) && (i32(g.Mercenary[0].Engineer) >= MAXSKILL)) {
		return
	}
	oldtraderskill = i32(TraderSkill(&g.Ship))
	Redo = true
	for Redo {
		d = (i32(SysRandom(0)) % (MAXSKILLTYPE))
		if (((((d == 0) && (i32(g.Mercenary[0].Pilot) < MAXSKILL)) || ((d == 1) && (i32(g.Mercenary[0].Fighter) < MAXSKILL))) || ((d == 2) && (i32(g.Mercenary[0].Trader) < MAXSKILL))) || ((d == 3) && (i32(g.Mercenary[0].Engineer) < MAXSKILL))) {
			Redo = false
		}
	}
	if (d == 0) {
		g.Mercenary[0].Pilot = u8(i32(g.Mercenary[0].Pilot) + 1)
	} else if (d == 1) {
		g.Mercenary[0].Fighter = u8(i32(g.Mercenary[0].Fighter) + 1)
	} else if (d == 2) {
		g.Mercenary[0].Trader = u8(i32(g.Mercenary[0].Trader) + 1)
		if (oldtraderskill != i32(TraderSkill(&g.Ship))) {
			RecalculateBuyPrices(g.Mercenary[0].CurSystem)
		}
	} else {
		g.Mercenary[0].Engineer = u8(i32(g.Mercenary[0].Engineer) + 1)
	}
}

DecreaseRandomSkill :: proc(amount: i32) {
	Redo: bool
	d: i32
	oldtraderskill: i32
	if ((((i32(g.Mercenary[0].Pilot) >= MAXSKILL) && (i32(g.Mercenary[0].Trader) >= MAXSKILL)) && (i32(g.Mercenary[0].Fighter) >= MAXSKILL)) && (i32(g.Mercenary[0].Engineer) >= MAXSKILL)) {
		return
	}
	oldtraderskill = i32(TraderSkill(&g.Ship))
	Redo = true
	for Redo {
		d = (i32(SysRandom(0)) % (MAXSKILLTYPE))
		if (((((d == 0) && (i32(g.Mercenary[0].Pilot) > amount)) || ((d == 1) && (i32(g.Mercenary[0].Fighter) > amount))) || ((d == 2) && (i32(g.Mercenary[0].Trader) > amount))) || ((d == 3) && (i32(g.Mercenary[0].Engineer) > amount))) {
			Redo = false
		}
	}
	if (d == 0) {
		g.Mercenary[0].Pilot = u8(i32(g.Mercenary[0].Pilot) - amount)
	} else if (d == 1) {
		g.Mercenary[0].Fighter = u8(i32(g.Mercenary[0].Fighter) - amount)
	} else if (d == 2) {
		g.Mercenary[0].Trader = u8(i32(g.Mercenary[0].Trader) - amount)
		if (oldtraderskill != i32(TraderSkill(&g.Ship))) {
			RecalculateBuyPrices(g.Mercenary[0].CurSystem)
		}
	} else {
		g.Mercenary[0].Engineer = u8(i32(g.Mercenary[0].Engineer) - amount)
	}
}

TonicTweakRandomSkill :: proc() {
	oldPilot: i32
	oldFighter: i32
	oldTrader: i32
	oldEngineer: i32
	oldPilot = i32(g.Mercenary[0].Pilot)
	oldFighter = i32(g.Mercenary[0].Fighter)
	oldTrader = i32(g.Mercenary[0].Trader)
	oldEngineer = i32(g.Mercenary[0].Engineer)
	if (i32(g.Difficulty) < HARD) {
		for ((((oldPilot == i32(g.Mercenary[0].Pilot)) && (oldFighter == i32(g.Mercenary[0].Fighter))) && (oldTrader == i32(g.Mercenary[0].Trader))) && (oldEngineer == i32(g.Mercenary[0].Engineer))) {
			IncreaseRandomSkill()
			DecreaseRandomSkill(1)
		}
	} else {
		IncreaseRandomSkill()
		IncreaseRandomSkill()
		DecreaseRandomSkill(3)
	}
}

