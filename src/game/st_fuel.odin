GetFuelTanks :: proc() -> u8 {
	return u8((HasGadget(&g.Ship, u8(FUELCOMPACTOR)) ? 18 : i32(Shiptype[g.Ship.Type].FuelTanks)))
}

GetFuel :: proc() -> u8 {
	return u8(((i32((g.Ship.Fuel)) <= i32((GetFuelTanks()))) ? i32((g.Ship.Fuel)) : i32((GetFuelTanks()))))
}

BuyFuel :: proc(Amount_in: i32) {
	Amount := Amount_in
	MaxFuel: i32
	Parsecs: i32
	MaxFuel = ((i32(GetFuelTanks()) - i32(GetFuel())) * i32(Shiptype[g.Ship.Type].CostOfFuel))
	if (Amount > MaxFuel) {
		Amount = MaxFuel
	}
	if (Amount > g.Credits) {
		Amount = g.Credits
	}
	Parsecs = (Amount / i32(Shiptype[g.Ship.Type].CostOfFuel))
	g.Ship.Fuel = u8(i32(g.Ship.Fuel) + Parsecs)
	g.Credits -= (Parsecs * i32(Shiptype[g.Ship.Type].CostOfFuel))
}

