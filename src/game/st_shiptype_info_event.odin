package game

DrawShiptypeInfoForm :: proc() {
	frmP: ^FormType
	frmP = FrmGetActiveForm()
	setLabelText(frmP, ShiptypeInfoShipNameLabel, Shiptype[g.SelectedShipType].Name)
	setLabelText(frmP, ShiptypeInfoSizeLabel, SystemSize[Shiptype[g.SelectedShipType].Size])
	setLabelText(frmP, ShiptypeInfoCargoBaysLabel, StrIToA(cstring(&g.SBuf[0]), i32(Shiptype[g.SelectedShipType].CargoBays)))
	setLabelText(frmP, ShiptypeInfoWeaponSlotsLabel, StrIToA(cstring(&g.SBuf[0]), i32(Shiptype[g.SelectedShipType].WeaponSlots)))
	setLabelText(frmP, ShiptypeInfoShieldSlotsLabel, StrIToA(cstring(&g.SBuf[0]), i32(Shiptype[g.SelectedShipType].ShieldSlots)))
	setLabelText(frmP, ShiptypeInfoGadgetSlotsLabel, StrIToA(cstring(&g.SBuf[0]), i32(Shiptype[g.SelectedShipType].GadgetSlots)))
	setLabelText(frmP, ShiptypeInfoCrewQuartersLabel, StrIToA(cstring(&g.SBuf[0]), i32(Shiptype[g.SelectedShipType].CrewQuarters)))
	StrIToA(cstring(&g.SBuf[0]), i32(Shiptype[g.SelectedShipType].FuelTanks))
	StrCat(cstring(&g.SBuf[0]), " parsecs")
	setLabelText(frmP, ShiptypeInfoMaximumRangeLabel, cstring(&g.SBuf[0]))
	setLabelText(frmP, ShiptypeInfoHullStrengthLabel, StrIToA(cstring(&g.SBuf[0]), Shiptype[g.SelectedShipType].HullStrength))
	FrmDrawForm(frmP)
	WinDrawBitmap(g.ShipBmpPtr[g.SelectedShipType], i16((94 + ((60 - GetBitmapWidth(g.ShipBmpPtr[g.SelectedShipType])) >> 1))), i16((83 + ((48 - GetBitmapHeight(g.ShipBmpPtr[g.SelectedShipType])) >> 1))))
}

ShiptypeInfoFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	switch u32(eventP.eType) {
	case u32(frmOpenEvent), u32(frmUpdateEvent):
		DrawShiptypeInfoForm()
		handled = true
	case u32(ctlSelectEvent):
		g.CurForm = BuyShipForm
		FrmGotoForm(u16(g.CurForm))
		handled = true
	case:
	}
	return handled
}

