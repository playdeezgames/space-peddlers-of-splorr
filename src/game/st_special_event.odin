// GENERATED by tools/transpile.py from reference/Src/SpecialEvent.c
// (Space Trader 1.2.2, Pieter Spronck, GPL). Do not edit; fix the generator
// or add an override instead.
package game

DrawSpecialEventForm :: proc() {
	frmP: ^FormType
	theText: [320]u8
	frmP = FrmGetActiveForm()
	setCurrentWinTitle(SpecialEvent[g.SolarSystem[g.Mercenary[0].CurSystem].Special].Title)
	if SpecialEvent[g.SolarSystem[g.Mercenary[0].CurSystem].Special].JustAMessage {
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(SpecialEventYesButton)))
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(SpecialEventNoButton)))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(SpecialEventOKButton)))
	} else {
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(SpecialEventYesButton)))
		FrmShowObject(frmP, FrmGetObjectIndex(frmP, u16(SpecialEventNoButton)))
		FrmHideObject(frmP, FrmGetObjectIndex(frmP, u16(SpecialEventOKButton)))
	}
	FrmDrawForm(frmP)
	SysCopyStringResource(cstring(&theText[0]), i16(SpecialEvent[g.SolarSystem[g.Mercenary[0].CurSystem].Special].QuestStringID))
	DisplayPage(cstring(&theText[0]), 18)
}

SpecialEventFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	i: i32
	FirstEmptySlot: i32
	switch u32(eventP.eType) {
	case u32(frmOpenEvent), u32(frmUpdateEvent):
		DrawSpecialEventForm()
		handled = true
	case u32(ctlSelectEvent):
		if (i32(eventP.data.ctlSelect.controlID) != SpecialEventNoButton) {
			if (ToSpend() < SpecialEvent[g.SolarSystem[g.Mercenary[0].CurSystem].Special].Price) {
				FrmAlert(u16(NotEnoughForEventAlert))
				handled = true
				break
			}
			g.Credits -= SpecialEvent[g.SolarSystem[g.Mercenary[0].CurSystem].Special].Price
			switch g.SolarSystem[g.Mercenary[0].CurSystem].Special {
			case GETREACTOR:
				if (FilledCargoBays() > (TotalCargoBays() - 15)) {
					FrmAlert(u16(NotEnoughBaysAlert))
					handled = true
					break
				} else if (i32(g.WildStatus) == 1) {
					if (i32(FrmCustomAlert(u16(WildWontStayOnboardAlert), SolarSystemName[g.SolarSystem[g.Mercenary[0].CurSystem].NameIndex], nil, nil)) == WildWontStayOnboardSayGoodbyetoWild) {
						g.WildStatus = u8(0)
						FrmCustomAlert(u16(WildLeavesShipAlert), SolarSystemName[g.SolarSystem[g.Mercenary[0].CurSystem].NameIndex], nil, nil)
					} else {
						handled = true
						break
					}
				}
				FrmAlert(u16(ReactorAlert))
				g.ReactorStatus = u8(1)
			case REACTORDELIVERED:
				g.SolarSystem[g.Mercenary[0].CurSystem].Special = GETSPECIALLASER
				g.ReactorStatus = u8(21)
				handled = true
			case MONSTERKILLED:
			case SCARAB:
				g.ScarabStatus = u8(1)
			case SCARABDESTROYED:
				g.ScarabStatus = u8(2)
				g.SolarSystem[g.Mercenary[0].CurSystem].Special = GETHULLUPGRADED
				handled = true
			case GETHULLUPGRADED:
				FrmAlert(u16(HullUpgradeAlert))
				g.Ship.Hull += UPGRADEDHULL
				g.ScarabStatus = u8(3)
				handled = true
			case EXPERIMENT:
				g.ExperimentStatus = u8(1)
			case EXPERIMENTSTOPPED:
				g.ExperimentStatus = u8(13)
				g.CanSuperWarp = true
			case EXPERIMENTNOTSTOPPED:
			case ARTIFACTDELIVERY:
				g.ArtifactOnBoard = false
			case ALIENARTIFACT:
				g.ArtifactOnBoard = true
			case FLYBARATAS, FLYMELINA, FLYREGULAS:
				g.DragonflyStatus += 1
			case DRAGONFLYDESTROYED:
				g.SolarSystem[g.Mercenary[0].CurSystem].Special = INSTALLLIGHTNINGSHIELD
				handled = true
			case GEMULONRESCUED:
				g.SolarSystem[g.Mercenary[0].CurSystem].Special = GETFUELCOMPACTOR
				g.InvasionStatus = u8(0)
				handled = true
			case MEDICINEDELIVERY:
				g.JaporiDiseaseStatus = u8(2)
				IncreaseRandomSkill()
				IncreaseRandomSkill()
			case MOONFORSALE:
				FrmAlert(u16(BoughtMoonAlert))
				g.MoonBought = true
			case MOONBOUGHT:
				EraseRectangle(0, 0, 160, 160)
				g.CurForm = UtopiaForm
				FrmGotoForm(u16(UtopiaForm))
				return true
			case SKILLINCREASE:
				FrmAlert(u16(SkillIncreaseAlert))
				IncreaseRandomSkill()
			case TRIBBLE:
				FrmAlert(u16(YouHaveATribbleAlert))
				g.Ship.Tribbles = 1
			case BUYTRIBBLE:
				FrmAlert(u16(BeamOverTribblesAlert))
				g.Credits += (g.Ship.Tribbles >> 1)
				g.Ship.Tribbles = 0
			case ERASERECORD:
				FrmAlert(u16(CleanRecordAlert))
				g.PoliceRecordScore = CLEANSCORE
				RecalculateSellPrices()
			case SPACEMONSTER:
				g.MonsterStatus = u8(1)
				for i = 0; (i < MAXSOLARSYSTEM); i += 1 {
					if (g.SolarSystem[i].Special == SPACEMONSTER) {
						g.SolarSystem[i].Special = -1
					}
				}
			case DRAGONFLY:
				g.DragonflyStatus = u8(1)
				for i = 0; (i < MAXSOLARSYSTEM); i += 1 {
					if (g.SolarSystem[i].Special == DRAGONFLY) {
						g.SolarSystem[i].Special = -1
					}
				}
			case AMBASSADORJAREK:
				if (g.Ship.Crew[(i32(Shiptype[g.Ship.Type].CrewQuarters) - 1)] >= 0) {
					FrmCustomAlert(u16(NoQuartersAvailableAlert), "Ambassador Jarek", nil, nil)
					handled = true
					break
				}
				FrmCustomAlert(u16(PassengerTakenOnBoardAlert), "Ambassador Jarek", nil, nil)
				g.JarekStatus = u8(1)
			case TRANSPORTWILD:
				if (g.Ship.Crew[(i32(Shiptype[g.Ship.Type].CrewQuarters) - 1)] >= 0) {
					FrmCustomAlert(u16(NoQuartersAvailableAlert), "Jonathan Wild", nil, nil)
					handled = true
					break
				}
				if !(HasWeapon(&g.Ship, u8(BEAMLASERWEAPON), false)) {
					FrmAlert(u16(WildWontGetAboardAlert))
					handled = true
					break
				}
				if ((i32(g.ReactorStatus) > 0) && (i32(g.ReactorStatus) < 21)) {
					FrmAlert(u16(WildAfraidOfReactorAlert))
					handled = true
					break
				}
				FrmCustomAlert(u16(PassengerTakenOnBoardAlert), "Jonathan Wild", nil, nil)
				g.WildStatus = u8(1)
			case ALIENINVASION:
				g.InvasionStatus = u8(1)
			case JAREKGETSOUT:
				g.JarekStatus = u8(2)
				RecalculateBuyPrices(g.Mercenary[0].CurSystem)
			case WILDGETSOUT:
				g.WildStatus = u8(2)
				g.Mercenary[(MAXCREWMEMBER - 1)].CurSystem = u8(KRAVATSYSTEM)
				g.Mercenary[(MAXCREWMEMBER - 1)].Pilot = u8(5)
				g.Mercenary[(MAXCREWMEMBER - 1)].Fighter = u8(5)
				g.Mercenary[(MAXCREWMEMBER - 1)].Trader = u8(5)
				g.Mercenary[(MAXCREWMEMBER - 1)].Engineer = u8(5)
				switch i32(NthLowestSkill(&g.Ship, u8(1))) {
				case PILOTSKILL:
					g.Mercenary[(MAXCREWMEMBER - 1)].Pilot = u8(10)
				case FIGHTERSKILL:
					g.Mercenary[(MAXCREWMEMBER - 1)].Fighter = u8(10)
				case TRADERSKILL:
					g.Mercenary[(MAXCREWMEMBER - 1)].Trader = u8(10)
				case ENGINEERSKILL:
					g.Mercenary[(MAXCREWMEMBER - 1)].Engineer = u8(10)
				}
				switch i32(NthLowestSkill(&g.Ship, u8(2))) {
				case PILOTSKILL:
					g.Mercenary[(MAXCREWMEMBER - 1)].Pilot = u8(8)
				case FIGHTERSKILL:
					g.Mercenary[(MAXCREWMEMBER - 1)].Fighter = u8(8)
				case TRADERSKILL:
					g.Mercenary[(MAXCREWMEMBER - 1)].Trader = u8(8)
				case ENGINEERSKILL:
					g.Mercenary[(MAXCREWMEMBER - 1)].Engineer = u8(8)
				}
				if (g.PoliceRecordScore < CLEANSCORE) {
					g.PoliceRecordScore = CLEANSCORE
				}
			case CARGOFORSALE:
				FrmAlert(u16(SealedCannistersAlert))
				i = (i32(SysRandom(0)) % (MAXTRADEITEM))
				g.Ship.Cargo[i] += 3
				g.BuyingPrice[i] += SpecialEvent[g.SolarSystem[g.Mercenary[0].CurSystem].Special].Price
			case INSTALLLIGHTNINGSHIELD:
				FirstEmptySlot = GetFirstEmptySlot(Shiptype[g.Ship.Type].ShieldSlots, ([^]i32)(&g.Ship.Shield[0]))
				if (FirstEmptySlot < 0) {
					FrmAlert(u16(NotEnoughSlotsAlert))
					handled = true
				} else {
					FrmAlert(u16(LightningShieldAlert))
					g.Ship.Shield[FirstEmptySlot] = LIGHTNINGSHIELD
					g.Ship.ShieldStrength[FirstEmptySlot] = Shieldtype[LIGHTNINGSHIELD].Power
				}
			case GETSPECIALLASER:
				FirstEmptySlot = GetFirstEmptySlot(Shiptype[g.Ship.Type].WeaponSlots, ([^]i32)(&g.Ship.Weapon[0]))
				if (FirstEmptySlot < 0) {
					FrmAlert(u16(NotEnoughSlotsAlert))
					handled = true
				} else {
					FrmAlert(u16(MorganLaserAlert))
					g.Ship.Weapon[FirstEmptySlot] = MORGANLASERWEAPON
				}
			case GETFUELCOMPACTOR:
				FirstEmptySlot = GetFirstEmptySlot(Shiptype[g.Ship.Type].GadgetSlots, ([^]i32)(&g.Ship.Gadget[0]))
				if (FirstEmptySlot < 0) {
					FrmAlert(u16(NotEnoughSlotsAlert))
					handled = true
				} else {
					FrmAlert(u16(FuelCompactorAlert))
					g.Ship.Gadget[FirstEmptySlot] = FUELCOMPACTOR
					g.Ship.Fuel = GetFuelTanks()
				}
			case JAPORIDISEASE:
				if (FilledCargoBays() > (TotalCargoBays() - 10)) {
					FrmAlert(u16(NotEnoughBaysAlert))
					handled = true
				} else {
					FrmAlert(u16(AntidoteAlert))
					g.JaporiDiseaseStatus = u8(1)
				}
			}
			if !handled {
				g.SolarSystem[g.Mercenary[0].CurSystem].Special = -1
			}
		}
		g.CurForm = SystemInformationForm
		FrmGotoForm(u16(g.CurForm))
		handled = true
	case:
	}
	return handled
}

