package game

OpenQuests :: proc() -> i32 {
	r: i32 = 0
	if (i32(g.MonsterStatus) == 1) {
		r += 1
	}
	if ((i32(g.DragonflyStatus) >= 1) && (i32(g.DragonflyStatus) <= 4)) {
		r += 1
	} else if (g.SolarSystem[ZALKONSYSTEM].Special == INSTALLLIGHTNINGSHIELD) {
		r += 1
	}
	if (i32(g.JaporiDiseaseStatus) == 1) {
		r += 1
	}
	if g.ArtifactOnBoard {
		r += 1
	}
	if (i32(g.WildStatus) == 1) {
		r += 1
	}
	if (i32(g.JarekStatus) == 1) {
		r += 1
	}
	if ((i32(g.InvasionStatus) >= 1) && (i32(g.InvasionStatus) < 7)) {
		r += 1
	} else if (g.SolarSystem[GEMULONSYSTEM].Special == GETFUELCOMPACTOR) {
		r += 1
	}
	if ((i32(g.ExperimentStatus) >= 1) && (i32(g.ExperimentStatus) < 11)) {
		r += 1
	}
	if ((i32(g.ReactorStatus) >= 1) && (i32(g.ReactorStatus) < 21)) {
		r += 1
	}
	if (g.SolarSystem[NIXSYSTEM].Special == GETSPECIALLASER) {
		r += 1
	}
	if (i32(g.ScarabStatus) == 1) {
		r += 1
	}
	if (g.Ship.Tribbles > 0) {
		r += 1
	}
	if g.MoonBought {
		r += 1
	}
	return r
}

DrawQuestsForm :: proc() {
	frmP: ^FormType
	Line: i32
	frmP = FrmGetActiveForm()
	RectangularShortcuts(frmP, QuestsBButton)
	FrmDrawForm(frmP)
	FntSetFont(stdFont)
	Line = 18
	if (i32(g.MonsterStatus) == 1) {
		DrawChars("Kill the space monster at Acamar.", 0, Line)
		Line += 16
	}
	if ((i32(g.DragonflyStatus) >= 1) && (i32(g.DragonflyStatus) <= 4)) {
		StrCopy(cstring(&g.SBuf[0]), "Follow the Dragonfly to ")
		if (i32(g.DragonflyStatus) == 1) {
			StrCat(cstring(&g.SBuf[0]), "Baratas.")
		} else if (i32(g.DragonflyStatus) == 2) {
			StrCat(cstring(&g.SBuf[0]), "Melina.")
		} else if (i32(g.DragonflyStatus) == 3) {
			StrCat(cstring(&g.SBuf[0]), "Regulas.")
		} else if (i32(g.DragonflyStatus) == 4) {
			StrCat(cstring(&g.SBuf[0]), "Zalkon.")
		}
		DrawChars(cstring(&g.SBuf[0]), 0, Line)
		Line += 16
	} else if (g.SolarSystem[ZALKONSYSTEM].Special == INSTALLLIGHTNINGSHIELD) {
		DrawChars("Get your lightning shield at Zalkon.", 0, Line)
		Line += 16
	}
	if (i32(g.JaporiDiseaseStatus) == 1) {
		DrawChars("Deliver antidote to Japori.", 0, Line)
		Line += 16
	}
	if g.ArtifactOnBoard {
		DrawChars("Deliver the alien artifact to professor", 0, Line)
		Line += 12
		DrawChars("Berger at some hi-tech system.", 0, Line)
		Line += 16
	}
	if (i32(g.WildStatus) == 1) {
		DrawChars("Smuggle Jonathan Wild to Kravat.", 0, Line)
		Line += 16
	}
	if (i32(g.JarekStatus) == 1) {
		DrawChars("Bring ambassador Jarek to Devidia.", 0, Line)
		Line += 16
	}
	if ((i32(g.InvasionStatus) >= 1) && (i32(g.InvasionStatus) < 7)) {
		DrawChars("Inform Gemulon about alien invasion", 0, Line)
		Line += 12
		if (i32(g.InvasionStatus) == 6) {
			StrCopy(cstring(&g.SBuf[0]), "by tomorrow")
		} else {
			StrCopy(cstring(&g.SBuf[0]), "within ")
			SBufMultiples((7 - i32(g.InvasionStatus)), "day")
		}
		StrCat(cstring(&g.SBuf[0]), ".")
		DrawChars(cstring(&g.SBuf[0]), 0, Line)
		Line += 16
	} else if (g.SolarSystem[GEMULONSYSTEM].Special == GETFUELCOMPACTOR) {
		DrawChars("Get your fuel compactor at Gemulon.", 0, Line)
		Line += 16
	}
	if ((i32(g.ExperimentStatus) >= 1) && (i32(g.ExperimentStatus) < 11)) {
		DrawChars("Stop Dr. Fehler's experiment at Daled", 0, Line)
		Line += 12
		if (i32(g.ExperimentStatus) == 10) {
			StrCopy(cstring(&g.SBuf[0]), "by tomorrow")
		} else {
			StrCopy(cstring(&g.SBuf[0]), "within ")
			SBufMultiples((11 - i32(g.ExperimentStatus)), "day")
		}
		StrCat(cstring(&g.SBuf[0]), ".")
		DrawChars(cstring(&g.SBuf[0]), 0, Line)
		Line += 16
	}
	if ((i32(g.ReactorStatus) >= 1) && (i32(g.ReactorStatus) < 21)) {
		DrawChars("Deliver the unstable reactor to Nix", 0, Line)
		Line += 12
		if (i32(g.ReactorStatus) < 2) {
			DrawChars("for Henry Morgan.", 0, Line)
		} else {
			DrawChars("before it consumes all its fuel.", 0, Line)
		}
		Line += 16
	}
	if (g.SolarSystem[NIXSYSTEM].Special == GETSPECIALLASER) {
		DrawChars("Get your special laser at Nix.", 0, Line)
		Line += 16
	}
	if (i32(g.ScarabStatus) == 1) {
		DrawChars("Find and destroy the Scarab (which", 0, Line)
		Line += 12
		DrawChars("is hiding at the exit to a wormhole).", 0, Line)
		Line += 16
	}
	if (g.Ship.Tribbles > 0) {
		DrawChars("Get rid of those pesky tribbles.", 0, Line)
		Line += 16
	}
	if g.MoonBought {
		DrawChars("Claim your moon at Utopia.", 0, Line)
		Line += 16
	}
	if (Line <= 18) {
		DrawChars("There are no open quests.", 0, Line)
	}
}

QuestsFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	switch u32(eventP.eType) {
	case u32(frmOpenEvent), u32(frmUpdateEvent):
		DrawQuestsForm()
		handled = true
	case u32(ctlSelectEvent):
		if (i32(eventP.data.ctlSelect.controlID) == QuestsStatusButton) {
			g.CurForm = CommanderStatusForm
		} else if (i32(eventP.data.ctlSelect.controlID) == QuestsShipButton) {
			g.CurForm = CurrentShipForm
		} else if (i32(eventP.data.ctlSelect.controlID) == QuestsSpecialButton) {
			g.CurForm = SpecialCargoForm
		}
		FrmGotoForm(u16(g.CurForm))
		handled = true
	case:
	}
	return handled
}

