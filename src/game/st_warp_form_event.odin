WarpFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	Xp: i32
	Yp: i32
	i: i32
	Index: i32
	switch u32(eventP.eType) {
	case u32(penDownEvent):
		if ((((i32(eventP.screenX) >= (SHORTRANGEBOUNDSX - EXTRAERASE)) && (i32(eventP.screenX) <= ((SHORTRANGEBOUNDSX + SHORTRANGEWIDTH) + EXTRAERASE))) && (i32(eventP.screenY) >= (BOUNDSY - EXTRAERASE))) && (i32(eventP.screenY) <= ((BOUNDSY + SHORTRANGEHEIGHT) + EXTRAERASE))) {
			i = 0
			Index = i32(g.Mercenary[0].CurSystem)
			for (i < MAXSOLARSYSTEM) {
				Xp = (((SHORTRANGEWIDTH >> 1) + ((i32(g.SolarSystem[i].X) - i32(g.SolarSystem[Index].X)) * (SHORTRANGEWIDTH / (MAXRANGE << 1)))) + SHORTRANGEBOUNDSX)
				Yp = (((SHORTRANGEHEIGHT >> 1) + ((i32(g.SolarSystem[i].Y) - i32(g.SolarSystem[Index].Y)) * (SHORTRANGEHEIGHT / (MAXRANGE << 1)))) + BOUNDSY)
				if (((((Xp - i32((eventP.screenX))) < 0) ? (-(Xp - i32((eventP.screenX)))) : (Xp - i32((eventP.screenX)))) <= MINDISTANCE) && ((((Yp - i32((eventP.screenY))) < 0) ? (-(Yp - i32((eventP.screenY)))) : (Yp - i32((eventP.screenY)))) <= MINDISTANCE)) {
					break
				}
				i += 1
			}
			if (i < MAXSOLARSYSTEM) {
				g.WarpSystem = i
				if (((!g.AlwaysInfo && g.APLscreen) && (RealDistance(g.SolarSystem[g.Mercenary[0].CurSystem], g.SolarSystem[g.WarpSystem]) <= i32(GetFuel()))) && (RealDistance(g.SolarSystem[g.Mercenary[0].CurSystem], g.SolarSystem[g.WarpSystem]) > 0)) {
					g.CurForm = AveragePricesForm
				} else {
					g.CurForm = ExecuteWarpForm
				}
				FrmGotoForm(u16(g.CurForm))
				handled = true
				break
			}
			i = 0
			for (i < MAXWORMHOLE) {
				Xp = (((SHORTRANGEWIDTH >> 1) + (((i32(g.SolarSystem[g.Wormhole[i]].X) + WORMHOLEDISTANCE) - i32(g.SolarSystem[Index].X)) * (SHORTRANGEWIDTH / (MAXRANGE << 1)))) + SHORTRANGEBOUNDSX)
				Yp = (((SHORTRANGEHEIGHT >> 1) + ((i32(g.SolarSystem[g.Wormhole[i]].Y) - i32(g.SolarSystem[Index].Y)) * (SHORTRANGEHEIGHT / (MAXRANGE << 1)))) + BOUNDSY)
				if (((((Xp - i32((eventP.screenX))) < 0) ? (-(Xp - i32((eventP.screenX)))) : (Xp - i32((eventP.screenX)))) <= MINDISTANCE) && ((((Yp - i32((eventP.screenY))) < 0) ? (-(Yp - i32((eventP.screenY)))) : (Yp - i32((eventP.screenY)))) <= MINDISTANCE)) {
					break
				}
				i += 1
			}
			if (i < MAXWORMHOLE) {
				if (i32(g.Mercenary[0].CurSystem) != i32(g.Wormhole[i])) {
					FrmCustomAlert(u16(WormholeOutOfRangeAlert), SolarSystemName[((i < (MAXWORMHOLE - 1)) ? i32(g.Wormhole[(i + 1)]) : i32(g.Wormhole[0]))], SolarSystemName[g.Wormhole[i]], "")
				} else {
					g.WarpSystem = ((i < (MAXWORMHOLE - 1)) ? i32(g.Wormhole[(i + 1)]) : i32(g.Wormhole[0]))
					if (!g.AlwaysInfo && g.APLscreen) {
						g.CurForm = AveragePricesForm
					} else {
						g.CurForm = ExecuteWarpForm
					}
					FrmGotoForm(u16(g.CurForm))
				}
				handled = true
				break
			}
		}
	case u32(frmOpenEvent):
		DrawShortRange(i32(g.Mercenary[0].CurSystem))
		handled = true
	case u32(frmUpdateEvent):
		DrawShortRange(i32(g.Mercenary[0].CurSystem))
		handled = true
	case:
	}
	return handled
}

GalacticChartFormHandleEvent :: proc(eventP: ^EventType) -> bool {
	handled: bool = false
	track: bool = false
	i: i32 = 0
	d: i32
	delta: i32
	SystemH: MemHandle
	SystemH2: MemHandle
	frm: ^FormType
	FindSystem: [21]u8
	DontLoad: bool
	switch u32(eventP.eType) {
	case u32(keyDownEvent):
		d = ScrollButton(eventP)
		if ((d == chrPageUp) || (d == chrPageDown)) {
			if (d == chrPageDown) {
				i = (g.GalacticChartSystem + 1)
				if (i >= MAXSOLARSYSTEM) {
					i = 0
				}
			} else {
				i = (g.GalacticChartSystem - 1)
				if (i < 0) {
					i = (MAXSOLARSYSTEM - 1)
				}
			}
			DrawGalaxy(i)
			handled = true
		}
	case u32(penDownEvent):
		if ((((i32(eventP.screenX) >= (BOUNDSX - EXTRAERASE)) && (i32(eventP.screenX) <= ((BOUNDSX + GALAXYWIDTH) + EXTRAERASE))) && (i32(eventP.screenY) >= (BOUNDSY - EXTRAERASE))) && (i32(eventP.screenY) <= ((BOUNDSY + GALAXYHEIGHT) + EXTRAERASE))) {
			i = 0
			delta = ((WORMHOLEDISTANCE * (SHORTRANGEWIDTH / (MAXRANGE << 1))) >> 1)
			for (i < MAXWORMHOLE) {
				if ((((((i32(g.SolarSystem[g.Wormhole[i]].X) + delta) - (i32(eventP.screenX) - BOUNDSX)) < 0) ? (-((i32(g.SolarSystem[g.Wormhole[i]].X) + delta) - (i32(eventP.screenX) - BOUNDSX))) : ((i32(g.SolarSystem[g.Wormhole[i]].X) + delta) - (i32(eventP.screenX) - BOUNDSX))) <= 1) && ((((i32(g.SolarSystem[g.Wormhole[i]].Y) - (i32(eventP.screenY) - BOUNDSY)) < 0) ? (-(i32(g.SolarSystem[g.Wormhole[i]].Y) - (i32(eventP.screenY) - BOUNDSY))) : (i32(g.SolarSystem[g.Wormhole[i]].Y) - (i32(eventP.screenY) - BOUNDSY))) <= 1)) {
					break
				}
				i += 1
			}
			if (i < MAXWORMHOLE) {
				DrawGalaxy((-i - 1))
				g.GalacticChartFormHandleEvent__last = -1
				handled = true
				break
			}
			i = 0
			for (i < MAXSOLARSYSTEM) {
				if (((((i32(g.SolarSystem[i].X) - (i32(eventP.screenX) - BOUNDSX)) < 0) ? (-(i32(g.SolarSystem[i].X) - (i32(eventP.screenX) - BOUNDSX))) : (i32(g.SolarSystem[i].X) - (i32(eventP.screenX) - BOUNDSX))) <= (MINDISTANCE >> 1)) && ((((i32(g.SolarSystem[i].Y) - (i32(eventP.screenY) - BOUNDSY)) < 0) ? (-(i32(g.SolarSystem[i].Y) - (i32(eventP.screenY) - BOUNDSY))) : (i32(g.SolarSystem[i].Y) - (i32(eventP.screenY) - BOUNDSY))) <= (MINDISTANCE >> 1))) {
					break
				}
				i += 1
			}
			if (i < MAXSOLARSYSTEM) {
				if (i == g.TrackedSystem) {
					StrCopy(cstring(&g.SBuf[0]), "Do you wish to stop tracking ")
					StrCat(cstring(&g.SBuf[0]), SolarSystemName[i])
					if (i32(FrmCustomAlert(u16(TrackSystemAlert), cstring(&g.SBuf[0]), nil, nil)) == TrackSystemYes) {
						g.TrackedSystem = -1
					}
				} else if (i == g.GalacticChartFormHandleEvent__last) {
					if (g.TrackedSystem == -1) {
						StrCopy(cstring(&g.SBuf[0]), "Do you wish to track ")
						StrCat(cstring(&g.SBuf[0]), SolarSystemName[i])
					} else {
						StrCopy(cstring(&g.SBuf[0]), "Do you wish to stop tracking ")
						StrCat(cstring(&g.SBuf[0]), SolarSystemName[g.TrackedSystem])
						StrCat(cstring(&g.SBuf[0]), ", and track ")
						StrCat(cstring(&g.SBuf[0]), SolarSystemName[i])
						StrCat(cstring(&g.SBuf[0]), " instead")
					}
					if (i32(FrmCustomAlert(u16(TrackSystemAlert), cstring(&g.SBuf[0]), nil, nil)) == TrackSystemYes) {
						g.TrackedSystem = i
					}
				}
				g.GalacticChartFormHandleEvent__last = i
				DrawGalaxy(i)
				handled = true
				break
			}
		}
	case u32(ctlSelectEvent):
		if (i32(eventP.data.ctlSelect.controlID) == GalacticChartSuperWarpButton) {
			if (g.TrackedSystem < 0) {
				FrmAlert(u16(NoSystemSelectedAlert))
				return true
			} else if (g.TrackedSystem == i32(g.Mercenary[0].CurSystem)) {
				FrmAlert(u16(NoJumpToCurSystemAlert))
				return true
			} else if (i32(FrmCustomAlert(u16(UseSingularityAlert), SolarSystemName[g.TrackedSystem], " ", " ")) == UseSingularityUseSingularity) {
				g.WarpSystem = g.TrackedSystem
				g.CanSuperWarp = false
				DoWarp(true)
			}
		} else if (i32(eventP.data.ctlSelect.controlID) == GalacticChartFindButton) {
			frm = FrmInitForm(u16(FindSystemForm))
			SystemH = SetField(frm, FindSystemSystemField, "", (NAMELEN + 1), true)
			d = i32(FrmDoDialog(frm))
			GetField(frm, FindSystemSystemField, cstring(&g.SBuf[0]), SystemH)
			if (i32(g.SBuf[0]) == 0) {
				d = FindSystemCancelButton
			} else {
				StrCopy(cstring(&FindSystem[0]), cstring(&g.SBuf[0]))
			}
			track = GetCheckBox(frm, FindSystemTrackCheckbox)
			FrmDeleteForm(frm)
			if (d != FindSystemOKButton) {
				handled = true
				break
			}
			if (i32(StrCompare(cstring(&FindSystem[0]), "Moolah")) == 0) {
				g.Credits += 100000
			} else if (i32(StrCompare(cstring(&FindSystem[0]), "Very rare")) == 0) {
				frm = FrmInitForm(u16(RareCheatForm))
				SetCheckBox(frm, RareCheatMarieCheckbox, ((i32(g.VeryRareEncounter) & i32(u8(ALREADYMARIE))) != 0))
				SetCheckBox(frm, RareCheatHuieCheckbox, ((i32(g.VeryRareEncounter) & i32(u8(ALREADYHUIE))) != 0))
				SetCheckBox(frm, RareCheatAhabCheckbox, ((i32(g.VeryRareEncounter) & i32(u8(ALREADYAHAB))) != 0))
				SetCheckBox(frm, RareCheatConradCheckbox, ((i32(g.VeryRareEncounter) & i32(u8(ALREADYCONRAD))) != 0))
				SetCheckBox(frm, RareCheatGoodTonicCheckbox, ((i32(g.VeryRareEncounter) & i32(u8(ALREADYBOTTLEGOOD))) != 0))
				SetCheckBox(frm, RareCheatBadTonicCheckbox, ((i32(g.VeryRareEncounter) & i32(u8(ALREADYBOTTLEOLD))) != 0))
				StrIToA(cstring(&g.SBuf[0]), g.ChanceOfVeryRareEncounter)
				SystemH = SetField(frm, RareCheatChancesField, cstring(&g.SBuf[0]), 5, true)
				StrIToA(cstring(&g.SBuf[0]), g.ChanceOfTradeInOrbit)
				SystemH2 = SetField(frm, RareCheatTradeField, cstring(&g.SBuf[0]), 5, true)
				d = i32(FrmDoDialog(frm))
				GetField(frm, RareCheatChancesField, cstring(&g.SBuf[0]), SystemH)
				if (i32(g.SBuf[0]) != 0) {
					g.ChanceOfVeryRareEncounter = StrAToI(cstring(&g.SBuf[0]))
				}
				GetField(frm, RareCheatTradeField, cstring(&g.SBuf[0]), SystemH2)
				if (i32(g.SBuf[0]) != 0) {
					g.ChanceOfTradeInOrbit = StrAToI(cstring(&g.SBuf[0]))
				}
				g.VeryRareEncounter = u8(0)
				if GetCheckBox(frm, RareCheatMarieCheckbox) {
					g.VeryRareEncounter = u8(i32(g.VeryRareEncounter) | i32(u8(ALREADYMARIE)))
				}
				if GetCheckBox(frm, RareCheatHuieCheckbox) {
					g.VeryRareEncounter = u8(i32(g.VeryRareEncounter) | i32(u8(ALREADYHUIE)))
				}
				if GetCheckBox(frm, RareCheatAhabCheckbox) {
					g.VeryRareEncounter = u8(i32(g.VeryRareEncounter) | i32(u8(ALREADYAHAB)))
				}
				if GetCheckBox(frm, RareCheatConradCheckbox) {
					g.VeryRareEncounter = u8(i32(g.VeryRareEncounter) | i32(u8(ALREADYCONRAD)))
				}
				if GetCheckBox(frm, RareCheatGoodTonicCheckbox) {
					g.VeryRareEncounter = u8(i32(g.VeryRareEncounter) | i32(u8(ALREADYBOTTLEGOOD)))
				}
				if GetCheckBox(frm, RareCheatBadTonicCheckbox) {
					g.VeryRareEncounter = u8(i32(g.VeryRareEncounter) | i32(u8(ALREADYBOTTLEOLD)))
				}
				FrmDeleteForm(frm)
			} else if (i32(StrCompare(cstring(&FindSystem[0]), "Cheetah")) == 0) {
				g.CheatCounter = 3
			} else if ((i32(StrNCompare(cstring(&FindSystem[0]), "Go ", 3)) == 0) && (i32(StrLen(cstring(&FindSystem[0]))) > 3)) {
				StrCopy(cstring(&FindSystem[0]), cadd(cstring(&FindSystem[0]), 3))
				i = 0
				for (i < MAXSOLARSYSTEM) {
					if (i32(StrCaselessCompare(SolarSystemName[i], cstring(&FindSystem[0]))) >= 0) {
						break
					}
					i += 1
				}
				if (i < MAXSOLARSYSTEM) {
					g.Mercenary[0].CurSystem = u8(i)
					DrawGalaxy(i)
				}
			} else if (i32(StrCompare(cstring(&FindSystem[0]), "Quests")) == 0) {
				frm = FrmInitForm(u16(QuestListForm))
				for i = 0; (i < MAXSOLARSYSTEM); i += 1 {
					if (g.SolarSystem[i].Special == DRAGONFLY) {
						setLabelText(frm, QuestListDragonflyLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					} else if (g.SolarSystem[i].Special == SPACEMONSTER) {
						setLabelText(frm, QuestListMonsterLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					} else if (g.SolarSystem[i].Special == JAPORIDISEASE) {
						setLabelText(frm, QuestListDiseaseLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					} else if (g.SolarSystem[i].Special == ALIENARTIFACT) {
						setLabelText(frm, QuestListArtifactQuestLabel, "Artifact:")
						setLabelText(frm, QuestListArtifactLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					} else if ((g.SolarSystem[i].Special == ARTIFACTDELIVERY) && g.ArtifactOnBoard) {
						setLabelText(frm, QuestListArtifactQuestLabel, "Berger:")
						setLabelText(frm, QuestListArtifactLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					} else if (g.SolarSystem[i].Special == TRIBBLE) {
						setLabelText(frm, QuestListTribblesLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					} else if (g.SolarSystem[i].Special == GETREACTOR) {
						setLabelText(frm, QuestListReactorLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					} else if (g.SolarSystem[i].Special == AMBASSADORJAREK) {
						setLabelText(frm, QuestListJarekLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					} else if (g.SolarSystem[i].Special == ALIENINVASION) {
						setLabelText(frm, QuestListInvasionLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					} else if (g.SolarSystem[i].Special == EXPERIMENT) {
						setLabelText(frm, QuestListExperimentLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					} else if (g.SolarSystem[i].Special == TRANSPORTWILD) {
						setLabelText(frm, QuestListWildLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					} else if (g.SolarSystem[i].Special == SCARAB) {
						setLabelText(frm, QuestListScarabLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					} else if (((g.SolarSystem[i].Special == SCARABDESTROYED) && (i32(g.ScarabStatus) > 0)) && (i32(g.ScarabStatus) < 2)) {
						setLabelText(frm, QuestListScarabLabel, SolarSystemName[g.SolarSystem[i].NameIndex])
					}
				}
				FrmDoDialog(frm)
				FrmDeleteForm(frm)
			} else if (i32(StrCompare(cstring(&FindSystem[0]), "Timewarp")) == 0) {
				DontLoad = false
				if !g.GameLoaded {
					if (i32(FrmAlert(u16(DisableScoringAlert))) != DisableScoringYes) {
						DontLoad = true
					}
				} else if (i32(FrmAlert(u16(ReallyLoadAlert))) != ReallyLoadYes) {
					DontLoad = true
				}
				if !DontLoad {
					if LoadGame(1) {
						g.GameLoaded = true
						FrmGotoForm(u16(g.CurForm))
					}
				}
			} else {
				i = 0
				for (i < MAXSOLARSYSTEM) {
					if (i32(StrCaselessCompare(SolarSystemName[i], cstring(&FindSystem[0]))) >= 0) {
						break
					}
					i += 1
				}
				if (i >= MAXSOLARSYSTEM) {
					i = i32(g.Mercenary[0].CurSystem)
				} else if track {
					g.TrackedSystem = i
				}
				DrawGalaxy(i)
			}
		}
		handled = true
	case u32(frmOpenEvent):
		DrawGalaxy(i32(g.Mercenary[0].CurSystem))
		handled = true
	case u32(frmUpdateEvent):
		DrawGalaxy(i32(g.Mercenary[0].CurSystem))
		handled = true
	case:
	}
	return handled
}

