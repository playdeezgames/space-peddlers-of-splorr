}

DrawCharsCentered :: proc(Text: cstring, y: i32, useBold: bool) {
	originalFont: i32
	width: i16 = i16(160)
	length: i16 = StrLen(Text)
	fits: bool
	if useBold {
		originalFont = FntSetFont(boldFont)
	} else {
		originalFont = FntSetFont(stdFont)
	}
	FntCharsInWidth(Text, ([^]i16)(&width), ([^]i16)(&length), ([^]bool)(&fits))
	WinDrawChars(Text, StrLen(Text), i16((80 - (i32(width) / 2))), i16(y))
	FntSetFont(originalFont)
}

DisplayHeadline :: proc(text: cstring, y_coord: [^]i32) -> bool {
	offset: i32 = 0
	width: i16 = i16((158 - (NEWSINDENT1 * 2)))
	length: i16 = StrLen(text)
	fits: bool
	theText: [72]u8
	FntCharsInWidth(text, ([^]i16)(&width), ([^]i16)(&length), ([^]bool)(&fits))
	if fits {
		if (y_coord[0] > 128) {
			return false
		}
		DrawChars(text, NEWSINDENT1, y_coord[0])
	} else {
		if (y_coord[0] > 107) {
			return false
		}
		if (i32(StrLen(text)) > 71) {
			return false
		}
		StrCopy(cstring(&theText[0]), text)
		offset = i32(length)
		for ((offset > 0) && (i32(theText[offset]) != 32)) {
			offset -= 1
		}
		theText[offset] = u8(0)
		DrawChars(cstring(&theText[0]), NEWSINDENT1, y_coord[0])
		y_coord[0] += 11
		DrawChars(cadd(cadd(cstring(&theText[0]), offset), 1), NEWSINDENT2, y_coord[0])
	}
	y_coord[0] += 15
	return true
}

DisplayPage :: proc(text: cstring, start_y: i32) {
	offset: i32 = 0
	internalOffset: i32 = 0
	vert: i32 = start_y
	width: i16 = i16(148)
	length: i16
	origLength: i16 = StrLen(text)
	fits: bool
	looping: bool
	theText: [46]u8
	looping = true
	for looping {
		StrNCopy(cstring(&theText[0]), cadd(text, offset), i16((((45) <= (i32(origLength) - offset)) ? (45) : (i32(origLength) - offset))))
		theText[(((45) <= (i32(origLength) - offset)) ? (45) : (i32(origLength) - offset))] = u8(0)
		length = StrLen(cstring(&theText[0]))
		FntCharsInWidth(cstring(&theText[0]), ([^]i16)(&width), ([^]i16)(&length), ([^]bool)(&fits))
		if fits {
			offset += 45
		} else {
			internalOffset = i32(length)
			for (((internalOffset > 0) && (i32(theText[internalOffset]) != 32)) && (i32(theText[internalOffset]) != 45)) {
				internalOffset -= 1
			}
			if ((i32(theText[internalOffset]) == 45) && (internalOffset < i32(length))) {
				theText[(internalOffset + 1)] = u8(0)
			} else {
				theText[internalOffset] = u8(0)
			}
			offset += (internalOffset + 1)
		}
		DrawChars(cstring(&theText[0]), 8, vert)
		vert += 12
		if (offset >= i32(origLength)) {
			looping = false
			theText[45] = u8(0)
		}
	}
}

ScrollButton :: proc(eventP: ^EventType) -> i32 {
	Ticks: u32
	if ((i32(eventP.data.keyDown.chr) == chrPageUp) || (i32(eventP.data.keyDown.chr) == chrPageDown)) {
		Ticks = TimGetTicks()
		if (Ticks < (g.GalacticChartUpdateTicks + u32((i32(SysTicksPerSecond()) >> 1)))) {
			return 0
		}
		g.GalacticChartUpdateTicks = Ticks
		return i32(eventP.data.keyDown.chr)
	}
	return 0
}

