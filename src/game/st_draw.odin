package game

SBufMultiples :: proc(Count: i32, Txt: cstring) {
	StrIToA(cstring(&g.SBuf2[0]), Count)
	StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
	StrCat(cstring(&g.SBuf[0]), " ")
	StrCat(cstring(&g.SBuf[0]), Txt)
	if (Count != 1) {
		StrCat(cstring(&g.SBuf[0]), "s")
	}
}

SBufShortMultiples :: proc(Count: i32, Txt: cstring) {
	if (Count != 1) {
		StrIToA(cstring(&g.SBuf2[0]), Count)
		StrCat(cstring(&g.SBuf[0]), cstring(&g.SBuf2[0]))
		StrCat(cstring(&g.SBuf[0]), " ")
		StrCat(cstring(&g.SBuf[0]), Txt)
		if (Count != 1) {
			StrCat(cstring(&g.SBuf[0]), "s")
		}
	} else {
		StrCat(cstring(&g.SBuf[0]), Txt)
	}
}

setFormTitle :: proc(formID: i32, s: cstring) {
	frm: ^FormType
	frm = FrmGetFormPtr(u16(formID))
	FrmCopyTitle(frm, s)
}

setCurrentWinTitle :: proc(s: cstring) {
	frm: ^FormType = FrmGetActiveForm()
	FrmSetTitle(frm, s)
}

setLabelText :: proc(frm: ^FormType, labelid: i32, s: cstring) {
	objindex: i32
	objindex = i32(FrmGetObjectIndex(frm, u16(labelid)))
	FrmHideObject(frm, u16(objindex))
	FrmCopyLabel(frm, u16(labelid), s)
	FrmShowObject(frm, u16(objindex))
}

RectangularShortcuts :: proc(frm: ^FormType, First: i32) {
	SetControlLabel(frm, (First + 0), Shortcuts[g.Shortcut1])
	RectangularButton(frm, (First + 0))
	SetControlLabel(frm, (First + 1), Shortcuts[g.Shortcut2])
	RectangularButton(frm, (First + 1))
	SetControlLabel(frm, (First + 2), Shortcuts[g.Shortcut3])
	RectangularButton(frm, (First + 2))
	SetControlLabel(frm, (First + 3), Shortcuts[g.Shortcut4])
	RectangularButton(frm, (First + 3))
}

EraseRectangle :: proc(x: i32, y: i32, ex: i32, ey: i32) {
	a: RectangleType
	a.topLeft.x = i16(x)
	a.topLeft.y = i16(y)
	a.extent.x = i16(ex)
	a.extent.y = i16(ey)
	WinEraseRectangle(&a, u16(0))
}

DrawChars :: proc(Text: cstring, x: i32, y: i32) {
	WinDrawChars(Text, StrLen(Text), i16(x), i16(y))
}

DebugIntAlert :: proc(a: i32, b: i32, c: i32) {
	as: [51]u8
	bs: [51]u8
	cs: [51]u8
	StrIToA(cstring(&as[0]), a)
	StrIToA(cstring(&bs[0]), b)
	StrIToA(cstring(&cs[0]), c)
	FrmCustomAlert(u16(DebugAlert), cstring(&as[0]), cstring(&bs[0]), cstring(&cs[0]))
}

DebugLongAlert :: proc(a: i32, b: i32, c: i32) {
	as: [51]u8
	bs: [51]u8
